
@using DataBuildingLayer;
@model CharterPartyClass

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



<div id="idCP">
<div class = "row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>
            <h2>
                Charter Party
            </h2>
            @*<ol class="breadcrumb">
                    <li><a href="">Home</a></li>
                    <li><a href="">Form</a></li>
                    <li><a>Create</a></li>
                </ol>*@
        </div>
        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
    <div class="col-md button-row-top">
        @if (StaticHelper.UserRole == "Administrator" || StaticHelper.UserRole == "Superintendent")
        {
            <a class="btn btn-info" href="@Url.Action("AddCPContract", "CP")">
                Add CP Contract
            </a>
        }
            @*<a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> << Go Back</a>*@
        </div>
    </div>
	</div>


    <div class="wrapper wrapper-content">
        <div class="container">
            <div class="inline-content">
                <div class="col-md">
                    
                </div>

                <div class="inline-content">
                    <div class="col m-1">

                        <input id="idFirst" autocomplete="off" placeholder="search by :cp no./charter party id" class="form-control" type="text">
                        <span id="messageLat" style="color:red"></span>
                    </div>

                    <div class="col m-1">

                        <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                        <span id="messageLat" style="color:red"></span>
                    </div>

                    <button id="btnSearch" class="function-button submit-button m-1">Search</button>




                </div>
            </div>
            <div class="form-body">
                <div class="table-responsive">
                    @*<div>
                            <a href="@Url.Action("AddCPContract", "CP")" class="btn btn-sm btn-light btn-edit">
                                <i class="uil uil-edit-alt mr-2"></i>Add Vessels
                            </a>
                        </div>*@


                    <table class="GeneratedTable centered-table">
                        <thead>
                            <tr>
                                <th style="display:none">Id</th>
                                <th>Vessel Name</th>
                                <th>Charter Party ID</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                @*<th>Voyage Type</th>*@
                                <th>View Detail</th>

                                @if (StaticHelper.UserRole == "Administrator" || StaticHelper.UserRole == "Superintendent")
                                {
                                    <th>Action</th>
                                }


                            </tr>

                        </thead>
                        <tbody>

                            @foreach (var item in Model.CPVesselInfo)
                            {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.VesselID)</td>
                                @*<td> @Html.DisplayFor(modelItem => item.VesselID)</td>*@
                                <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                                <td> @Html.DisplayFor(modelItem => item.CPNO)</td>
                                <td>
                                    @{
                                        var sdate = item.StartDate.ToString("dd-MMM-yyyy");
                                        @Html.Raw(sdate);
                                    }
                                </td>
                                <td>
                                    @{
                                        var Edate = item.EndDate.ToString("dd-MMM-yyyy");
                                        @Html.Raw(Edate);
                                    }
                                </td>
                                @*<td> @Html.DisplayFor(modelItem => item.VoyageType)</td>*@
                                <td width="100px">
                                    <a href="@Url.Action("ViewCPDetail", "CP", new { id = item.Id })" class="btn btn-sm btn-light btn-edit">
                                        <i class="uil uil-edit-alt mr-2"></i>View Detail
                                    </a>
                                </td>


                                @if (StaticHelper.UserRole == "Administrator" || StaticHelper.UserRole == "Superintendent")
                                {
                                    <td width="300px">

                                        <a href="@Url.Action("EditCPContract", "CP", new { id = item.Id })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>Edit
                                        </a>


                                        |
                                        <button type="button" class="btn btn-sm btn-light btn-delete">
                                            <i class="uil uil-trash-alt mr-2"></i>
                                            @Html.ActionLink("Delete", "DeleteCP", "CP", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })

                                        </button>
                                    </td>
                                }

                            </tr>
                            }


                        </tbody>
                    </table>

                    <nav aria-label="Page navigation example">
                        <ul class="pagination">


                            @{
                                int totalRecords = 0;
                                foreach (var item in Model.CPVesselInfo)
                                {
                                    totalRecords = item.TotalCount;
                                    break;
                                }
                                //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                                // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                                int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                                int tot_pages = totalRecords / pageSize;
                                int remainder = totalRecords % pageSize;

                                tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                                int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                                if (totalRecords > 0)
                                {
                                    if (currPage == 0)
                                    {
                                        currPage = 1;
                                    }

                                    if (currPage != 1)
                                    {
                                        <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "index", "CP", new { pageNo = 1 }, null)</a></li>
                                    }

                                    if (currPage != tot_pages)
                                    {
                                        for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                        {
                                            if (cnt == currPage)
                                            {
                                                <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                            }
                                            else
                                            {
                                                <li class="page-item">@Html.ActionLink(cnt.ToString(), "index", "CP", new { pageNo = cnt }, null)</li>
                                            }

                                            if (cnt == tot_pages)
                                            {
                                                break;
                                            }
                                        }
                                    }


                                    if (currPage == tot_pages)
                                    {
                                        <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item">@Html.ActionLink("Last", "index", "CP", new { pageNo = tot_pages }, null)</li>
                                    }
                                }
                            }
                        </ul>
                    </nav>
                </div>
            </div>


        </div>
    </div>
</div>
<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').addClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').removeClass('active');


</script>
<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">
    $(function () {

        $('input[name="datefilter"]').daterangepicker({
            autoUpdateInput: false,
            locale: {
                cancelLabel: 'Clear'
            }
        });

        $('input[name="datefilter"]').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('YYYY/MM/DD') + ' - ' + picker.endDate.format('YYYY/MM/DD'));
        });

        $('input[name="datefilter"]').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });

    });
</script>

<script>

    $("#btnSearch").click(function () {

        var firstVal = $("#idFirst").val();
        var secondVal = $("#idSecond").val();





        var dateF = $('#idSecond').data('daterangepicker').startDate.format('YYYY-MM-DD');
        var dateT = $('#idSecond').data('daterangepicker').endDate.format('YYYY-MM-DD');



        if (secondVal == "") {
            dateF = "";
            dateT = "";
        }

        if (firstVal == "" && secondVal == "") {
            alert("Please enter atleast 1 value for search.");
            return;
        }
        else {



            $.ajax({
                type: 'GET',
                url: '/CharterParty/CP/index?pageNo=1&firstVal=' + firstVal + '&dateF=' + dateF + '&dateT=' + dateT,
                datatype: 'json',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                processData: false,
                success: function (data) {
                    $("#idCP").html('');
                    $("#idCP").html(data);
                },

            });
        }

    });

</script>

<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>