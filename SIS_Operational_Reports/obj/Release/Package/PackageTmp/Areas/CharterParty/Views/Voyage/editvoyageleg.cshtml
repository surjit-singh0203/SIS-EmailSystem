
@using DataBuildingLayer;
@model DataBuildingLayer.VoyageClass

@*<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>*@
<script src="~/assets/jquery-3.6.0.min.js"></script>

@{
    /**/

    ViewBag.Title = "editvoyageleg";
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}


@using (Html.BeginForm("editvoyageleg", "Voyage"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
    <div class="row" style="margin-top: 10px;">

        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div class="col-md">
                <h2>Edit Voyage Leg1</h2>
            </div>

            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">

                        <button name="Submit" type="submit" class="function-button submit-button"><i class="uil uil-check mr-2"></i>Submit</button>
                    </div>

                    <div class="col">

                        <button name="back" type="button" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>
                        @*<a name="back" id="btnBack" onclick="goBack()" class="function-button go-back"> << Go Back</a>*@
                    </div>
                </div>
            </div>

        </div>

    </div>
    <div class="container">
        <div class="row">
            <div class="col-md">
                <div class="mb-3 row">



                    <label for="inputPassword" class="col-sm-4 col-form-label">Leg Port (A)</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.LegPort_A, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                        <span id="messageImo"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Reason for Port Call (A)</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ReasonforPortCall_A, new SelectList(Model.PortStatusList, "Id", "Status"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                        <span id="messageCap"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Leg Port (B)</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.LegPort_B, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                        <span id="messageCap"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Reason for Port Call (B)</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ReasonforPortCall_B, new SelectList(Model.PortStatusList, "Id", "Status"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">DTG</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.DTG, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @min = 0, @max = "9999", @required = "true", @onKeyUp = "requiredValue(this)" } })
                        <span id="messageDTG"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">CP SOG</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.CP_SOG, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">CP Log Speed</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.CP_Log_Speed, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })
                    </div>

                </div>
            </div>
        </div>
    </div>





}

<div class="modal fade" id="ModalA" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="closeA" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    Port Name:  @Html.EditorFor(m => m.LegPort_othersA, new { @class = "form-control", @maxlength = 100 })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="closeA" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="submitA" class="btn btn-primary pull-right">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalB" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="closeB" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    Port Name: @Html.EditorFor(m => m.LegPort_othersB, new { @class = "form-control" , @maxlength = 100 })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="closeB" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="submitB" class="btn btn-primary pull-right">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    function goBack() {
        window.history.back();
    }
</script>

<script>

    $(document).ready(function () {
        $('input[name="LegPort_othersA"]').attr('maxlength', '100');
        $('input[name="LegPort_othersB"]').attr('maxlength', '100');
    });

</script>

