<script type="text/javascript">

    $('#closeA').click(function () {
        debugger
        $('#ModalA').modal('hide');
    });

</script>

<script type="text/javascript">

    $('#submitA').click(function () {
        debugger
        var LegPort_othersA = $('#LegPort_othersA').val();
        if (LegPort_othersA) {
            $('select[name="LegPort_A"]').append($('<option>', {
                value: LegPort_othersA,
                text: LegPort_othersA,
                selected: true
            }));
        }
        $('#ModalA').modal('hide');

    });

</script>


