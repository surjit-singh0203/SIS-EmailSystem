@model DataBuildingLayer.VoyageClass




<div id="voyage">

    @*<h4 style="text-align:center">


            @if (ViewBag.VesselName != null)
            {
                <p>Vessel Name :-  <b>@ViewBag.VesselName</b>  </p>
            }
        </h4>*@
    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
        <div class="col-md">
            <h2>Voyage Details</h2>
        </div>



        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }

        <div class="col-md button-row-top">
            <div class="row">
                <div class="col">
                    <button class="function-button submit-button">
                        <a class="function-button submit-button" href="@Url.Action("addvoyagedetail", "Voyage")">
                            <i class="fa fa-plus-circle mr-2"></i>Add Voyage
                        </a>
                    </button>
                </div>
                @*<div class="col">
                        <button name="back" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>

                    </div>*@
            </div>
        </div>

    </div>




    <div class="container">
        <div>
            @*<div class="col-md">
                <h4>Voyage Detail List</h4>

            </div>*@

            <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->



            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" autocomplete="off" placeholder="search by : voyage no." class="form-control" type="text" />
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div style="display:none" class="col m-1">

                    <input id="idSecond" name="datefilter" autocomplete="off" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text" />
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <table class="GeneratedTable centered-table">
                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Voyage Number</th>
                        <th>Voyage Start Port</th>
                        <th>Voyage End Port</th>
                        @if (StaticHelper.LoginUser == "master" || StaticHelper.LoginUser == "2off")
                        {
                            <th style="width: 350px;">Action</th>
                        }
                        </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.GetVoyageList)
                    {
                    <tr>
                        <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                        <td> @Html.DisplayFor(modelItem => item.VoyageNumber)</td>
                        <td> @Html.DisplayFor(modelItem => item.VoyageStartP)</td>
                        <td> @Html.DisplayFor(modelItem => item.VoyageEndP)</td>
                        @if (StaticHelper.LoginUser == "master" || StaticHelper.LoginUser == "2off")
                        {

                            <td>
                                <div class="row button-row">

                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("View Voyage Settings", "ViewVoyageDetail", "Voyage", new { id = item.Id }, new { onclick = "" })
                                    </button>


                                    <div class="col table-button-container">
                                        <button type="button" class="function-button table-button">
                                            @Html.ActionLink("Edit", "editvoyage", "Voyage", new { id = item.Id }, new { onclick = "" })
                                        </button>
                                    </div>
                                    <div class="col table-button-container">
                                        <button type="button" class="function-button table-button">
                                            @Html.ActionLink("Delete", "deletevoyage", "Voyage", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                        </button>
                                    </div>
                                </div>
                            </td>
                        }
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Codes by Quackit.com -->




        </div>

        @{
            var recCnt = "";
            if (Model.GetVoyageList.Count == 0)
            {
                recCnt = "No Record Found !";
            }
        }
        <p style="font-weight:bold; color:red"> @recCnt </p>
    </div>

</div>

<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script type="text/javascript">
    $(function () {

        $('input[name="datefilter"]').daterangepicker({
            autoUpdateInput: false,
            locale: {
                cancelLabel: 'Clear'
            }
        });

        $('input[name="datefilter"]').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('YYYY/MM/DD') + ' - ' + picker.endDate.format('YYYY/MM/DD'));
        });

        $('input[name="datefilter"]').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });

    });
</script>

