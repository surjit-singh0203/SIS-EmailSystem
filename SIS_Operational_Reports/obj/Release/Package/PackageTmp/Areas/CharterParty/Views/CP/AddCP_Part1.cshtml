    <script type="text/javascript">
        $("#EndDate").change(function () {
            var startDate = document.getElementById("StartDate").value;
            var endDate = document.getElementById("EndDate").value;

            var strtdt = '@Session["startDt"]';
            var enddt = '@Session["endDt"]';
            var first = strtdt.replace('00:00:00', '').trim();
            var second = enddt.replace('00:00:00', '').trim();

            //alert(first);
            //alert(endDate);
            //var sdd = Date.parse(startDate);
            //alert(sdd);

            if ((Date.parse(first) > Date.parse(endDate))) {
                alert("End date should be between " + first + " to " + second +".");
                document.getElementById("EndDate").value = "";
                return;
            }

            if ((Date.parse(second) < Date.parse(endDate))) {
                alert("End date should be between " + first + " to " + second + ".");
                document.getElementById("EndDate").value = "";
                return;
            }

            if ((Date.parse(startDate) > Date.parse(endDate))) {
                alert("End date should be greater than Start date");
                document.getElementById("EndDate").value = "";
                return;
            }
        });



    </script>

