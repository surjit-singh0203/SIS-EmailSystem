    <script>
        function vesselcheck(t) {
            /* var Id = t.value;*/
            var vesselid = $("#VesselID option:selected").val();
            // alert(Voyid);


            const url = window.location.href;
            const strs = url.split('/');
            const cpid = strs.at(-1);
            // alert(id);


            $.ajax({
                type: 'GET',
                url: '/CharterParty/CP/VesselDupCheck?vesselid=' + vesselid + '&cpid=' + cpid,
                cache: false,
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.Result === true) {

                        var ss = response.CPID;
                        if (ss == 1) {

                            alert("This vessel already exists in this CP !");
                            $("#VesselID").val('').trigger('change');
                        }


                    }
                    else {
                        toastr["error"](response.Message);
                    }
                },
                failure: function (response) {
                    toastr["error"](response.Message);
                }
            });

        }
    </script>

