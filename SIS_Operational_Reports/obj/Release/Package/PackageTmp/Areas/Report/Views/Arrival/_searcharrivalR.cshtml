@model DataBuildingLayer.ArrivalReport


<div id="arrival">

    <div>

        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
            <div class="col-md">
                <h2>Arrival-Report List</h2>
            </div>



            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">
                        <button class="function-button submit-button">
                            <a class="function-button submit-button" href="@Url.Action("Index", "Arrival")">
                                <i class="fa fa-plus-circle mr-2"></i>Add Arrival Report
                            </a>
                        </button>
                    </div>

                </div>
            </div>

        </div>

    </div>


    <div class="container">
        <div>
            @*<div class="col-md">
                    <h4>Arrival-Report List</h4>
                </div>*@

            <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->


            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" placeholder="saerch by : voyage no." autocomplete="off" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <table class="GeneratedTable centered-table">
                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Voyage No.</th>
                        <th>Place</th>
                        <th>EOSP</th>

                        <th>Status</th>
                        <th>Downlaod Report</th>
                        @*<th>Submit Date</th>*@
                        <th>Sync To Emial</th>
                        <th>Action</th>


                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.GetArrivalRList)
                    {


                        <tr>
                            <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                            <td> @Html.DisplayFor(modelItem => item.voyagenumber)</td>
                            <td> @Html.DisplayFor(modelItem => item.Place)</td>
                            @*<td> @Html.DisplayFor(modelItem => item.EOSP)</td>*@
                            @*<td>
                                    @{ DateTime? cdt1 = item.EOSP;
                                        if (cdt1 != null)
                                        {
                                            @Html.Raw(cdt1.Value.ToString("dd-MMM-yyyy")) } }
                                </td>*@

                            @if (item.EOSP.ToString() == "0001-01-01 00:00:00" || item.EOSP.ToString() == "01-01-0001 00:00:00")
                            {
                                <td></td>
                            }
                            else
                            {
                                {
                                    DateTime? cdt1 = item.EOSP;

                                    <td> @Html.Raw(cdt1.Value.ToString("dd-MMM-yyyy"))</td>
                                }
                            }
                            <td>

                                @{ var svd = item.SaveDraft;
                                    if (svd == true)
                                    {
                                        @Html.Raw("In Draft") }
                                    else
                                    {
                                        @Html.Raw("Submitted") } }
                            </td>


                            <td>
                                @if (svd == true)
                                {
                                    <span>N/A</span>
                                }
                                else
                                {
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("Download", "SyncReportDownload", "Arrival",
                                        new { VoyageId = item.VoyageId, Id = item.Id, ReportDate = item.EOSP }, null)
                                    </button>
                                }


                            </td>
                            <td>

                                @if (svd == true)
                                {
                                    <span>N/A</span>
                                }
                                else
                                {
                                    <button type="button" class="function-button table-button" onclick="openEmail('@item.VoyageId','@item.Id','@item.EOSP','@item.Place')">
                                        SYNC
                                    </button>
                                }
                            </td>
                            @*<td>
                                    @{ DateTime? cdt = item.CreatedDate;
                                        if (cdt != null)
                                        {
                                            @Html.Raw(cdt.Value.ToString("dd-MMM-yyyy")) } }
                                </td>*@
                            <td>

                                <div class="row button-row">
                                    <div class="col table-button-container">
                                        <button type="button" class="function-button table-button">
                                            @Html.ActionLink("Edit", "Edit", "Arrival", new { id = item.Id }, new { onclick = "" })
                                        </button>
                                    </div>
                                    @if (StaticHelper.LoginUser == "master")
                                    {
                                        <div class="col table-button-container">
                                            <button type="button" class="function-button table-button">
                                                @Html.ActionLink("Delete", "Delete", "Arrival", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                            </button>
                                        </div>
                                    }
                                </div>

                            </td>


                        </tr>
                    }


                </tbody>
            </table>
            <!-- Codes by Quackit.com -->


        </div>

        @{
            var recCnt = "";
            if (Model.GetArrivalRList.Count == 0)
            {
                recCnt = "No Record Found !";
            }
        }
        <p style="font-weight:bold; color:red"> @recCnt </p>
    </div>

</div>
<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>

    function openEmail(VoyageId, Id, reportDate, AtSeaPort) {
        debugger
        $.ajax({
            url: '/DailyNoon/SyncReportToGetEmail',
            type: 'GET',
            data: {
                VoyageId: VoyageId,
                Id: Id,
                ReportDate: reportDate
            },
            success: function (response) {

                var to = response.data[0].EmailTo;
                var cc = response.data[0].EmailCC;


                var subject = "Daily Noon Report Sync";

                var fileLink = window.location.origin + response.fileUrl;

                var body =
                    "Hello,%0D%0A%0D%0A" +

                    "The Arrival-Report has been generated.%0D%0A%0D%0A" +

                    "Report Details:%0D%0A" +
                    "----------------------------------%0D%0A" +
                    "Voyage Id : " + VoyageId + "%0D%0A" +
                    "EOSP : " + reportDate + "%0D%0A" +
                    "Place : " + AtSeaPort + "%0D%0A" +
                    "----------------------------------%0D%0A%0D%0A" +



                    "Regards,%0D%0A" +
                    "Reporting System";



                var url = "mailto:" + to +
                    "?cc=" + cc +
                    "&subject=" + encodeURIComponent(subject) +
                    "&body=" + body;


                window.location.href = url;
            }
        });

    }

</script>

