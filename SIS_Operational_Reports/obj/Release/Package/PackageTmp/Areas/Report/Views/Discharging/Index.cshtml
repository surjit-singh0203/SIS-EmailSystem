<script type="text/javascript">
    function requiredValue1(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 1000) /
                    1000).toFixed(3);
            }
        }
        if (value > 99999.9) {

            $("#" + id + "").val('');
        }

    }
</script>

