                        <th>Status</th>
                        <th>Action</th>
                        <th style="display:none">Download</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.GetNoonRList)
                    {
                    <tr>
                        <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                        <td> @Html.DisplayFor(modelItem => item.CPNo)</td>
                        <td> @Html.DisplayFor(modelItem => item.voyagenumber)</td>
                        <td> @Html.DisplayFor(modelItem => item.AtSeaOrPort)</td>
                        <td>
                            @{ DateTime? cdt1 = item.Date;
                                if (cdt1 != null)
                                {
                                    @Html.Raw(cdt1.Value.ToString("dd-MMM-yyyy")) } }
                        </td>
                        <td>
                            @{ var svd = item.SaveDraft;
                                if (svd == true)
                                {
                                    @Html.Raw("In Draft") }
                                else
                                {
                                    @Html.Raw("Submitted") } }
                        </td>
                        <td>

                            <div class="row button-row">
                                <div class="col table-button-container">
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("View/Edit", "Edit", "DailyNoon", new { id = item.Id, vesselid = item.VesselId }, new { onclick = "" })
                                    </button>
                                </div>
                                @*<div class="col table-button-container">
                    <button type="button" class="function-button table-button">
                        @Html.ActionLink("Delete", "Delete", "DailyNoon", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                    </button>
                </div>*@
                            </div>

                        </td>
                        <td>
                            <button style="display:none" type="button" class="function-button table-button">
                                @Html.ActionLink("Download Report", "DownloadExcel", "DailyNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "FCons" }, new { onclick = "" })
                            </button>
                        </td>

                    </tr>
                    }


                </tbody>
            </table>

        </div>

        @{
            var recCnt = "";
            if (Model.GetNoonRList.Count == 0)
            {
                recCnt = "No Record Found !";
            }
        }
        <p style="font-weight:bold; color:red"> @recCnt </p>
    </div>


</div>
