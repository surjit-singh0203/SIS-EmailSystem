
@model DataBuildingLayer.LoadingReport
@{
    ViewBag.Title = "LoadingRList";
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}

<script type="text/javascript" src="~/Content/search1.js"></script>
<script type="text/javascript" src="~/Content/search2.js"></script>
<script type="text/javascript" src="~/Content/search3.js"></script>
<link rel="stylesheet" type="text/css" href="~/Content/search.css" />

<div id="loading">

    <div>
        @*<h4 style="text-align:center">


                @if (ViewBag.VesselName != null)
                {
                    <p>Vessel Name :-  <b>@ViewBag.VesselName</b>  </p>
                }
            </h4>*@
        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
            <div class="col-md">
                <h2>Loading-Report List</h2>
            </div>

            @if (TempData["Error"] != null)
            {
                <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
            }
            @if (TempData["Success"] != null)
            {
                <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
            }

            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">
                        <button class="function-button submit-button">
                            <a class="function-button submit-button" href="@Url.Action("Index", "Loading")">
                                <i class="fa fa-plus-circle mr-2"></i>Add Loading Report
                            </a>
                        </button>
                    </div>
                    @*<div class="col">
                            <button name="back" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>

                        </div>*@
                </div>
            </div>

        </div>

    </div>


    <div class="container">
        <div>

            <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->

            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" placeholder="search by : voyage no." autocomplete="off" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <table class="GeneratedTable centered-table">

                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Voyage No.</th>
                        <th>Leg Port (A)</th>
                        <th>Port</th>
                        <th>Report Date</th>
                        <th>Status</th>
                        @*<th>Submit Date</th>*@
                        <th>Action</th>


                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.LoadingReportList)
                    {


                        <tr>
                            <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                            <td> @Html.DisplayFor(modelItem => item.VoyageNumber)</td>
                            <td> @Html.DisplayFor(modelItem => item.LegPort_A)</td>
                            <td> @Html.DisplayFor(modelItem => item.PortName)</td>
                            @*<td>

                                    @{
                                        DateTime? dt = item.ReportDateTime;
                                        if (dt != null)
                                        {
                                            @Html.Raw(dt.Value.ToString("dd-MMM-yyyy"))
                                        }
                                    }
                                </td>*@

                            @if (item.ReportDateTime.ToString() == "0001-01-01 00:00:00" || item.ReportDateTime.ToString() == "01-01-0001 00:00:00")
                            {
                                <td></td>
                            }
                            else
                            {
                                {
                                    DateTime? cdt1 = item.ReportDateTime;

                                    <td> @Html.Raw(cdt1.Value.ToString("dd-MMM-yyyy"))</td>
                                }
                            }

                            <td>

                                @{ var svd = item.SaveDraft;
                                    if (svd == true)
                                    {
                                        @Html.Raw("In Draft") }
                                    else
                                    {
                                        @Html.Raw("Submitted") } }
                            </td>
                            @*<td>
                                    @{ DateTime? cdt = item.CreatedDate;
                                        if (cdt != null)
                                        {
                                            @Html.Raw(cdt.Value.ToString("dd-MMM-yyyy")) } }
                                </td>*@
                            <td>

                                <div class="row button-row">
                                    <div class="col table-button-container">
                                        <button type="button" class="function-button table-button">
                                            @Html.ActionLink("Edit", "Edit", "Loading", new { id = item.Id }, new { onclick = "" })
                                        </button>
                                    </div>
                                    @if (StaticHelper.LoginUser == "master")
                                    {
                                        <div class="col table-button-container">
                                            <button type="button" class="function-button table-button">
                                                @Html.ActionLink("Delete", "Delete", "Loading", new { id = item.Id, VId = item.VesselId }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                            </button>
                                        </div>
                                    }
                                </div>

                            </td>


                        </tr>
                    }


                </tbody>
            </table>
            <!-- Codes by Quackit.com -->

            <nav aria-label="Page navigation example">
                <ul class="pagination">


                    @{
                        int totalRecords = 0;
                        foreach (var item in Model.LoadingReportList)
                        {
                            totalRecords = item.TotalCount;
                            break;
                        }
                        //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                        // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                        int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                        int tot_pages = totalRecords / pageSize;
                        int remainder = totalRecords % pageSize;

                        tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                        int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                        if (totalRecords > 0)
                        {
                            if (currPage == 0)
                            {
                                currPage = 1;
                            }

                            if (currPage != 1)
                            {
                                <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "LoadingRlist", "Loading", new { pageNo = 1 }, null)</a></li>
                            }

                            if (currPage != tot_pages)
                            {
                                for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                {
                                    if (cnt == currPage)
                                    {
                                        <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item">@Html.ActionLink(cnt.ToString(), "LoadingRlist", "Loading", new { pageNo = cnt }, null)</li>
                                    }

                                    if (cnt == tot_pages)
                                    {
                                        break;
                                    }
                                }
                            }


                            if (currPage == tot_pages)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                            }
                            else
                            {
                                <li class="page-item">@Html.ActionLink("Last", "LoadingRlist", "Loading", new { pageNo = tot_pages }, null)</li>
                            }
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>

</div>
<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').removeClass('active');
    $('#Menu6').addClass('active');
    $('#Menu7').removeClass('active');
    $('#Menu8').removeClass('active');
    $('#Menu9').removeClass('active');

</script>

<script type="text/javascript">
    $(function () {

        $('input[name="datefilter"]').daterangepicker({
            autoUpdateInput: false,
            locale: {
                cancelLabel: 'Clear'
            }
        });

        $('input[name="datefilter"]').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('YYYY/MM/DD') + ' - ' + picker.endDate.format('YYYY/MM/DD'));
        });

        $('input[name="datefilter"]').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });

    });
</script>

<script>
    $("#btnSearch").click(function () {
        var firstVal = $("#idFirst").val();
        var secondVal = $("#idSecond").val();
        var dateF = $('#idSecond').data('daterangepicker').startDate.format('YYYY-MM-DD');
        var dateT = $('#idSecond').data('daterangepicker').endDate.format('YYYY-MM-DD');
        if (secondVal == "") {
            dateF = "";
            dateT = "";
        }

        if (firstVal == "" && secondVal == "") {
            alert("Please enter atleast 1 value for search.");
            return;
        }
        else {

            $.ajax({
                type: 'GET',
                url: '/Report/Loading/LoadingRList?pageNo=1&firstVal=' + firstVal + '&dateF=' + dateF + '&dateT=' + dateT,
                datatype: 'json',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                processData: false,
                success: function (data) {

                    $("#loading").html('');
                    $("#loading").html(data);

                },
            });
        }
    });

</script>
