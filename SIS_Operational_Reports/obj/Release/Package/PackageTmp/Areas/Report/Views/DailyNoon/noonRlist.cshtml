                                        break;
                                    }
                                }
                            }

                            if (currPage == tot_pages)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                            }
                            else
                            {
                                <li class="page-item">@Html.ActionLink("Last", "noonRlist", "DailyNoon", new { pageNo = tot_pages }, null)</li>
