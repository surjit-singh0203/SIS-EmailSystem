<script>

    function openEmail(VoyageId, Id, reportDate, AtSeaPort) {
        debugger
    $.ajax({
        url: '/DailyNoon/SyncReportToGetEmail',
        type: 'GET',
        data: {
            VoyageId: VoyageId,
            Id: Id,
            ReportDate: reportDate
        },
        success: function (response) {

            var to = response.data[0].EmailTo;
            var cc = response.data[0].EmailCC;


            var subject = "Daily Noon Report Sync";

            var fileLink = window.location.origin + response.fileUrl;

            var body =
                "Hello,%0D%0A%0D%0A" +

                "The Daily Noon Report has been generated.%0D%0A%0D%0A" +

                "Report Details:%0D%0A" +
                "----------------------------------%0D%0A" +
                "Voyage Id : " + VoyageId + "%0D%0A" +
                "Report Date : " + reportDate + "%0D%0A" +
                "At Sea/Port : " + AtSeaPort + "%0D%0A" +
                "----------------------------------%0D%0A%0D%0A" +

                

                "Regards,%0D%0A" +
                "Reporting System";



            var url = "mailto:" + to +
                "?cc=" + cc +
                "&subject=" + encodeURIComponent(subject) +
                "&body=" + body;


            window.location.href = url;
        }
    });

}

</script>

