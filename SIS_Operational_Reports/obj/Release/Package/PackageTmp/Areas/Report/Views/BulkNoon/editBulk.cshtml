        debugger;

        var id1 = $("#Id1").val();
        var id2 = $("#Id2").val();
        var id3 = $("#Id3").val();
        var id4 = $("#Id4").val();
        if (id1 == "") { id1 = 0; }
        if (id2 == "") { id2 = 0; }
        if (id3 == "") { id3 = 0; }
        if (id4 == "") { id4 = 0; }
        /*var ttl = parseInt(ttlDis) + parseInt(value);*/
