<script>
    function Getfuelcons11(id) {

        $.ajax({
            type: 'GET',
            /*  url: '/Report/DailyNoon/Getfuelcons?VoyId=' + VoyId,*/
            url: '/Report/BulkNoon/Getfuelcons?NoonReportId=' + id,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {debugger

                if (response.Result === true) {
                    var FtypeList = response.ft;
                    var CPList = response.cp;
                    var FCList = response.fc;
                    var FROBList = response.frob;
                    var rowCount = FtypeList.length;
                    let len = rowCount - 1;
                    for (let i = 2; i <= 1; i++) {

                        var $tableBody = $('#tblFuelC').find("tbody"),
                            $trLast = $tableBody.find("tr:last"),
                            $trNew = $trLast.clone();

                        $trLast.after($trNew);
                    }
                    debugger;
                    var count = 0; var ss = ""; var ss1 = "";
                    var table = document.getElementById('tblFuelC');

                    var j = 4; var k = 1;
                    $.each(FCList, function (index, value) {
                        ss1 = value;
                        if (k == 5) {
                            k++;
                        }
                        if (k == 10) {
                            k++;
                        }

                        if (k == 20) {
                            inc = k;

                            dt = FCList[51];

                            if (j == 5 && k == 20) {
                                table.rows[j].cells[inc].children[0].value = dt;
                            }

                            k++;
                        }

                        if (index == 25) {
                            table.rows[j].cells[inc].children[0].value = ss1;
                            k++;
                        }
                        else {

                            if (index != 51) {

                                table.rows[j].cells[k].children[0].value = ss1.toFixed(3);
                                k++;
                            }
                            if (index == 51) {

                                k++;
                            }

                        }


                        if (k >= 30) {
                            k = 1;
                            j++;
                        }

                        //table.rows[j].cells[k].children[0].value = ss1;
                        //k++;
                        //if (k >= 28) {
                        //    k = 1;
                        //    j++;
                        //}
                    });


                    var table1 = document.getElementById('tblFuelRob');
                    var j = 2; var k = 1;
                    $.each(FROBList, function (index, value) {
                        ss = value;
                        //alert(ss);
                        debugger;
                        table1.rows[j].cells[k].children[0].value = ss;
                        j++;
                    });


                    AddinSubTotalEdit();
                    AddinSubTotalEdit1();
                    AddinSubTotalEdit2();
                    AddinSubTotalEdit3();

                    AddMainTotalInFC();
                    AddMainTotalInFC1();


                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });
    }



</script>



