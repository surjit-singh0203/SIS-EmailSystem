@model DataBuildingLayer.FreshWaterReport
@{
    /**/

    ViewBag.Title = "Index";
    int Id = Model.Id;
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}

<link href="~/css/flatpickr.min.css" rel="stylesheet" />
<script src="~/css/flatpickr.js"></script>

<style>

    .datetime-wrapper {
        position: relative;
        display: inline-block;
    }

    .datetime-icon {
        position: absolute;
        right: 30px;
        top: 35%;
        transform: translateY(-50%);
        pointer-events: none;
    }


    .col-form-label {
        font-size: 14px !important;
    }

    .report-actions {
        display: flex;
    }

    button.function-button.submit-button {
        border: solid 1px black !important;
    }

    button {
        background: black !important;
        color: white !important;
        border: none;
        padding: 6px 53px !important;
        font-size: 12px !important;
        border-radius: 3px !important;
    }

        button.function-button.draft-button, button.function-button.reset-button {
            background: transparent !important;
            color: #676969 !important;
            border: solid 1px #676969 !important;
            padding: 6px 53px !important;
            font-size: 12px !important;
            border-radius: 0.25rem;
        }

    .form-control {
        margin-bottom: 4px !important;
    }

    .container.mt-4 {
        padding: 36px;
        border: 1px solid #ced4da;
    }
</style>

<style>
   
    #cover-spin {
        position: fixed;
        width: 100%;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.7);
        z-index: 9999;
        display: none;
    }

    @@-webkit-keyframes spin {
        from {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    #cover-spin::after {
        content: '';
        display: block;
        position: absolute;
        left: 48%;
        top: 40%;
        width: 40px;
        height: 40px;
        border-style: solid;
        border-color: black;
        border-top-color: transparent;
        border-width: 4px;
        border-radius: 50%;
        -webkit-animation: spin .8s linear infinite;
        animation: spin .8s linear infinite;
    }

    table#tblFuelC td {
        text-align: center;
        width: 50px;
    }

    tr.small-titles td {
        max-width: 150px !important;
        word-wrap: break-word !important;
        white-space: normal !important;
    }

    input#Laden {
        margin-right: 10px;
    }

    input#Ballast {
        margin-left: 11px;
        margin-right: 7px;
    }

    textarea#Remarks {
        border: none;
    }

    input#Sea {
        margin-right: 7px;
    }

    input#Port {
        margin-left: 10px;
        margin-right: 6px;
    }
</style>

<div id="cover-spin"></div>

<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>
            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit FreshWater Report
            </h2>

        </div>
        <div class="col-md button-row-top">
            <button type="Submit" id="Submit" style="margin-right:5px" class="function-button submit-button right-aligned">Save</button>
            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>

@Html.HiddenFor(e => e.Id)
@Html.HiddenFor(x => x.File_Name)


