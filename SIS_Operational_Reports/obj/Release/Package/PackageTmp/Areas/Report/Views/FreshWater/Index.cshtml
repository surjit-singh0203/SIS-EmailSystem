<div class="second-freshreport">
    <div class="container mt-4">
        <div class="row">

            <label for="inputPassword" class="col-md-4 col-form-label">Port Name</label>
            <div class="col-sm-8">
                @*@Html.DropDownListFor(model => model.PortName, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })*@
                @Html.EditorFor(model => model.PortName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, } })
                <span id="msgPortName" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-md-4 col-form-label">Facility Name</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.Facility_Name, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, } })
                <span id="msgFacility_Name" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-md-4 col-form-label">Received Date</label>
            <div class="col-sm-8 datetime-wrapper">
                @if (Model.Id != 0)
                {
                    @Html.EditorFor(model => model.Received_Date, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerEdit", } })
                    <span class="datetime-icon" style="font-size: 15px; margin-right:-10px">&#128197;</span>
                }
                else
                {
                    @Html.EditorFor(model => model.Received_Date, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePicker", @placeholder = "yyyy-mm-dd  _ : _ : _" } })
                    <span class="datetime-icon" style="font-size: 15px; margin-right:-10px">&#128197;</span>
                }
                <span id="msgReceived_Date" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-md-4 col-form-label">Vendor Details</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.VendorDetails, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 500, } })
                <span id="msgVendorDetails" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Initial Meter Reading Supply(MT)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.Intial_Meter_Reading_MT_supplied, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 20, } })
                <span id="msgIntial_Meter_Reading_MT_supplied" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Final Meter Reading(MT)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.Final_Meter_Reading_MT, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 20, } })
                <span id="msgFinal_Meter_Reading_MT" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Difference Meter Reading(MT)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.Difference_in_Meter_Reading_MT, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 20, } })
                <span id="msgDifference_in_Meter_Reading_MT" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Received QTY(MT)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.QTY_supplied_MT, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 20, } })
                <span id="msgQTY_supplied_MT" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Attachment</label>
            <div class="col-sm-8">
                <input type="file" name="FreshWater_File" accept=".pdf, .doc, .docx, .jpg, .jpeg, .png" onchange="checkFileSize(this)" />

                @if (Model.Id != 0)
                {
                    <a href="@Url.Action("OpenPDF", "FreshWater" , new { fileName = Model.File_Name, fileExtension = Model.fileExtension   })" target="_blank" id="uploadedFileName"><b>@Model.File_Name</b></a>
                }
                <span id="msgPDFfile" style="color:red"></span>
            </div>


        </div>
    </div>
</div>


