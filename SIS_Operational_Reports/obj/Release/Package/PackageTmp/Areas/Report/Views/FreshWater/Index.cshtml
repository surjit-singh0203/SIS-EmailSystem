            enableTime: true,
            dateFormat: "Y-m-d H:i",
            time_24hr: true,
            //defaultDate: new Date()
        });
    });

</script>


<script>

    $(".check-decimal").on("keypress", function (event) {
        var charCode = (event.which) ? event.which : event.keyCode;
        var value = $(this).val();

        if (charCode == 46 && value.indexOf('.') != -1) {
            return false;
        }

        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }

        var finalValue = value + String.fromCharCode(charCode);
        var validDecimal = /^\d*\.?\d{0,3}$/;

        if (!validDecimal.test(finalValue)) {
            return false;
        }

        return true;
    });

</script>

<script>

    function goBack() {
        window.history.back();
    }

</script>

<script>

    $(".check-AlphaNumeric").on("input", function () {
        //  this.value = this.value.replace(/[^a-zA-Z0-9!@@#$%^&*(),.?":{}|<>]/g, '');
        this.value = this.value.replace(/[^a-zA-Z0-9!@@#$%^&*(),.?":{}|<> ]/g, '');

    });

</script>

<script>

    function checkFileSize(input) {
        debugger

        if (input.files.length > 0) {
            const fileSize = input.files[0].size;
            const maxSize = 200 * 1024;
            const fileType = input.files[0].type;

            if (fileSize > maxSize) {
                alert("File size exceeds 200KB. Please select a smaller file.");
                input.value = "";
            }

            const allowedTypes = ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "image/jpeg", "image/jpg", "image/png"];

            if (!allowedTypes.includes(fileType)) {
                alert("Only PDF, Word, Excel, JPG, and PNG files are allowed. Please select a valid file.");
                input.value = "";
                return;
            }

        }
    }

</script>


<script type="text/javascript">

    $("body").on("click", "#Submit", function () {

        SaveFreshWReport();

    });

</script>


