<script>

    $(".check-decimal").on("keypress", function (event) {
        var charCode = (event.which) ? event.which : event.keyCode;
        var value = $(this).val();

        if (charCode == 46 && value.indexOf('.') != -1) {
            return false;
        }

        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }

        var finalValue = value + String.fromCharCode(charCode);
        var validDecimal = /^\d*\.?\d{0,3}$/;


        if (!validDecimal.test(finalValue)) {
            return false;
        }

        if (finalValue.length > 7) {
            return false;
        }

        return true;
    });

</script>

<script type="text/javascript">
    function requiredValueDFT(arg) {
        // debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 1000) /
                    1000).toFixed(3);
            }
        }
        if (value > 30) {

            $("#" + id + "").val('');
        }

    }
</script>


<script>
    /*function BindPrtEdit(legportid) {*/
    function BindPrtEdit(Voyid) {


        $.ajax({
            type: 'GET',
            /* url: '/Report/Berthing/BindPortEdit?Legid=' + legportid,*/
            url: '/Report/Berthing/BindPort_Edit?Voyid=' + Voyid,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    $('#PortName').empty();
                    var prtname = response.PortName;

                    $('#PortName').append('<option value=""></option>');
                    for (var i = 0; i < response.Data.length; i++) {

                        var txt = response.Data[i].Text;
                        var valu = response.Data[i].Value;
                        // alert(txt);
                        $('#PortName').append('<option value="' + txt + '">' + txt + '</option>');

                    }
                    $("#PortName option[value='" + prtname + "']").attr('selected', 'selected');
                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });


    };
</script>

