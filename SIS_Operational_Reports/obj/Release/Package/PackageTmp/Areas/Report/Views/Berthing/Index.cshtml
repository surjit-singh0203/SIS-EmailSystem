<script>
    function sleep(milliseconds) {
        const date = Date.now();
        let currentDate = null;
        do {
            currentDate = Date.now();
        } while (currentDate - date < milliseconds);
    }
</script>

<script type="text/javascript">
    function requiredValue7(arg) {
        //debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 1000) /
                    1000).toFixed(3);
            }
        }
        $("#" + id + "").css('color', 'black');
        if (value > 9999999.99) {

            $("#" + id + "").val('');
        }

    }
</script>

<script type="text/javascript">
    function requiredValueMCR(arg) {
        // debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 1000) /
                    1000).toFixed(3);
            }
        }
        $("#" + id + "").css('color', 'black');
        if (value > 100) {

            $("#" + id + "").val('0.00');
            $("#msgMCR").text("MCR not more than 100%");
        }
        else {
            $("#msgMCR").text('');
        }

    }
</script>
