<style>


    .datetime-wrapper {
        position: relative;
        display: inline-block;
    }

    .datetime-icon1 {
        position: absolute;
        right: 5px;
        top: 45%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .fa, .fas {
        font-weight: 100 !important;
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #676969 !important;
    }

    .nav-link {
        color: #676969;
        border: solid 1px #676969 !important;
        margin: 5px;
    }

        .nav-link:hover {
            background-color: #676969 !important;
            color: white !important;
        }

    .tab-content {
        margin: 5px !important;
        box-shadow: 0px 16px 40px 0px #00000026 !important;
        width: 100% !important;
        padding: 10px;
    }

    .nav-link.active {
        font-weight: normal;
    }

    .tab-content .row .col-md .GeneratedTable {
        margin: 15px 4.8px;
    }
</style>

<style>

    #cover-spin {
        position: fixed;
        width: 100%;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.7);
        z-index: 9999;
        display: none;
    }

    @@-webkit-keyframes spin {
        from {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    #cover-spin::after {
        content: '';
        display: block;
        position: absolute;
        left: 48%;
        top: 40%;
        width: 40px;
        height: 40px;
        border-style: solid;
        border-color: black;
        border-top-color: transparent;
        border-width: 4px;
        border-radius: 50%;
        -webkit-animation: spin .8s linear infinite;
        animation: spin .8s linear infinite;
    }
	select {
   
    width: 100%!important;
}

.row.long-table {
overflow-x: scroll;
}
table#tblFuelC{
    width: 2100px!important;

    table-layout: fixed;

}
tr.small-titles {
    font-size: 12px!important;
}
tr.small-titles td {
    width: 209px!important;
    white-space: normal;
    word-wrap: break-word;
    min-width: 234px!important;
    display: table-cell;
}
td.datetime-wrapper {
    width: 100%!important;
}

span.datetime-icon {
    position: absolute;
    right: 35px;
    z-index: 1;
    top: 4px;
}
td.datetime-wrapper {
    position: relative;
}
</style>
<div id="cover-spin"></div>
<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>


            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var vslname = Model.VesselName;
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                Berthing Report (@vslname)
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>

@Html.HiddenFor(e => e.Id)
<div class="row" style="margin-top: 10px;">


    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @disabled = true, @onchange = "GetLeg(this)", @required = "true", })
                <span id="messageVoyid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Port</label>
            <div class="col-sm-8">
                @* @Html.DropDownListFor(model => model.PortName, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @onchange = "GetFacName(this)", @required = "true", })*@
                @Html.DropDownListFor(model => model.PortName, new SelectList(Model.PortList, "Id", "Port"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @disabled = true, @required = "true", @onchange = "GetFacName(this)", })

                <span id="msgPortName" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Berth Name</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.BerthName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, @required = "true", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgBerthName" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">




            <label for="inputPassword" class="col-sm-4 col-form-label">Leg</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.LegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", @disabled = true, @onchange = "GetBRCargo();bindport(this);", })
                <span id="msgLegPortId" style="color:red"></span>
            </div>




            <label for="inputPassword" class="col-sm-4 col-form-label">Facility Name</label>
            <div class="col-sm-8">

                @Html.DropDownListFor(model => model.FacilityName, new SelectList(Model.FacilityList, "FacilityName", "FacilityName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @disabled = true, @required = "true", })
                <span id="msgFacilityName" style="color:red"></span>

            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Report Date</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.ReportDate, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 20, @required = "true", @readonly = true, @placeholder = "yyyy-mm-dd" } })
                <span id="msgReportDate" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">In Port Status</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.PortStatus, new SelectList(Model.PortStatusList, "Id", "Status"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                <span id="msgPortStatus" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Fwd(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftFwd, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValueDFT(this)", @type = "number", @min = "0", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftFwd" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Mid(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftMid, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValueDFT(this)", @type = "number", @min = "0", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftMid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Aft(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftAft, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValueDFT(this)", @type = "number", @min = "0", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftAft" style="color:red"></span>
            </div>

        </div>

        <div class="col-md">

            <div class="row report-actions">

                <div style="display:none" id="SDraft" class="col">
                    <button onclick="SaveDraftFunction()" class="function-button draft-button">
                        Save Draft
                    </button>
                    <div hidden="hidden">
                        @Html.CheckBoxFor(model => model.SaveDraft)
                    </div>

                </div>

                <div style="display:none" class="col">
                    <button onClick="window.location.reload();" class="function-button reset-button">
                        Reset
                    </button>
                </div>
                @if (StaticHelper.UserRole == "Administrator")
                {
                    <div style="margin-left:250px" class="col">
                        <button id="btnSave" class="function-button submit-button">
                            Submit
                        </button>
                    </div>
                }
            </div>



        </div>

    </div>

</div>



