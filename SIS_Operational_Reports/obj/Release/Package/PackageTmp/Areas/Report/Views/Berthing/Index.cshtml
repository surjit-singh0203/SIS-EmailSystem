                            // table.rows[j].cells[k].children[0].value = ss1;
                            table.rows[j].cells[k].innerHTML = ss1;

                            table.rows[j].cells[k].setAttribute("contenteditable", true);

                            table.rows[j].cells[k].addEventListener("input", function (event) {
                                var inputText = event.target.textContent;

                                var cleanedText = inputText.replace(/[^0-9.]/g, '');

                               // if (/^\d*(\.\d{0,3})?$/.test(cleanedText)) {
                                if (/^\d{0,7}(\.\d{0,3})?$/.test(cleanedText)) {

                                    event.target.textContent = cleanedText;

                                } else {

                                    event.target.textContent = "";
                                }
                            });

                            k++;
                        }

                    });




                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });
    }



</script>
