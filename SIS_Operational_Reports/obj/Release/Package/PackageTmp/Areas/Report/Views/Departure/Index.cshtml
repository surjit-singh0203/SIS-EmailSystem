<script>
    function GetSlipValue() {

var dist = $('#EngineDist').val();
    var dist1 = $('#NoonToNoonDMG_Dist').val();

    var dist2 = dist - dist1;
    var dist3 = dist2 / dist;
    var dist4 = dist3 * 100;
    if (dist4 != "Infinity") {
        $('#Slip').val(dist4.toFixed(3));

}
}
</script>

<script>
    function GetLeg(t) {

var Id = t.value;
    var Voyid = $("#VoyageId option:selected").val();
    //alert(portName);

    if ($("#Id").val() == 0) {

        $("#ReportDate").val('');
    $("#ReportDate").prop("disabled", true);
}


    $.ajax({
        type: 'GET',
    url: '/Report/Departure/BindLeg?Voyid=' + Voyid,
    cache: false,
    contentType: false,
    processData: false,
    success: function (response) {

        if (response.Result === true) {
        $('#NextLegPortId').empty();
    $('#DepLegPortId').empty();

    $('#NextLegPortId').append('<option value=""></option>');
    for (var i = 0; i < response.Data.length; i++) {

                var txt = response.Data[i].Text;
    var valu = response.Data[i].Value;
    // alert(txt);
    $('#NextLegPortId').append('<option value="' + valu + '">' + txt + '</option>');

            }

    $('#DepLegPortId').append('<option value=""></option>');
    for (var i = 0; i < response.Data.length; i++) {

                var txt = response.Data[i].Text;
    var valu = response.Data[i].Value;
    // alert(txt);
    $('#DepLegPortId').append('<option value="' + valu + '">' + txt + '</option>');

            }
        }
    else {
        toastr["error"](response.Message);
        }
    },
    failure: function (response) {
        toastr["error"](response.Message);
    }
});


};
</script>

