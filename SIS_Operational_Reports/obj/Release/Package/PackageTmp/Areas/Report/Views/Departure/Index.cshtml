<style>

    .datetime-icon1 {
        position: absolute;
        right: 15px;
        top: 45%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .datetime-wrapper1 {
        position: relative;
        display: inline-block;
    }

    .datetime-wrapper {
        position: relative;
        display: inline-block;
    }

    .datetime-icon {
        position: absolute;
        right: 30px;
        top: 35%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .fa, .fas {
        font-weight: 100 !important;
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #676969 !important;
    }

    .nav-link {
        color: #676969;
        border: solid 1px #676969 !important;
        margin: 5px;
    }

        .nav-link:hover {
            background-color: #676969 !important;
            color: white !important;
        }

    .tab-content {
        margin: 5px !important;
        box-shadow: 0px 16px 40px 0px #00000026 !important;
        width: 100% !important;
        padding: 10px;
    }

    .nav-link.active {
        font-weight: normal;
    }

    .tab-content .row .col-md .GeneratedTable {
        margin: 15px 4.8px;
    }

    textarea#Remarks {
        border: none;
    }
	input.datetimePickerEdit.flatpickr-input {
	
	border:none;
	}
</style>

<style>

    #cover-spin {
        position: fixed;
        width: 100%;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.7);
        z-index: 9999;
        display: none;
    }

    @@-webkit-keyframes spin {
        from {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    #cover-spin::after {
        content: '';
        display: block;
        position: absolute;
        left: 48%;
        top: 40%;
        width: 40px;
        height: 40px;
        border-style: solid;
        border-color: black;
        border-top-color: transparent;
        border-width: 4px;
        border-radius: 50%;
        -webkit-animation: spin .8s linear infinite;
        animation: spin .8s linear infinite;
    }
	td.datetime-wrapper{
	width:230px!important;
	}
	
	
	div#chamge1 input {
    border:1px solid #aaa!important;
	border-radius: 3px;
}
.row.long-table {
    max-width: 2800px;
}
 table#tblFuelC td {
        text-align: center;
        min-width: 100px;
    }
table#tblFuelC {
    overflow-x: scroll;
    display: block;
    padding: 0px !important;
}
</style>
<div id="cover-spin"></div>
<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>

            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit Departure Report
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>
