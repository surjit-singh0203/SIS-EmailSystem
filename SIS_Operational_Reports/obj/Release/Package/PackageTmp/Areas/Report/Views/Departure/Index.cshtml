<script type="text/javascript">
      function DRCargoInsertion() {

          var VoyId = $("#VoyageId option:selected").val();

                var drcargo = [];
                var table = document.getElementById('tblCargo'),
                    rows = table.getElementsByTagName('tr'),
                    i, j, cells, customerId;
                // var rCount = table.rows.length;

                for (i = 2, j = rows.length; i < j; ++i) {
                    cells = rows[i].getElementsByTagName('td');
                    if (!cells.length) {
                        continue;
                    }



                    var DRCargo = {};

                    DRCargo.CargoName = cells[0].innerHTML;
                    DRCargo.BL_Qty = cells[1].children[0].value;
                    DRCargo.LoadPortalActual = cells[2].children[0].value;
                    DRCargo.Cargo_Temp = cells[3].children[0].value;
                    DRCargo.Completion_DateT = cells[4].children[0].value;
                    DRCargo.Rate = cells[5].children[0].value;
                    DRCargo.VoyId = VoyId;
                    DRCargo.LR_Cargo_Id = cells[6].children[0].value;

                    drcargo.push(DRCargo);

                }

                //alert(fuelconsumptions);

          drcargo = JSON.stringify(drcargo);

                $.ajax({
                    url: '@Url.Action("InsertDRCargo", "Departure")',
                    type: "POST",
                    data: { 'drcargo': drcargo },
                    dataType: "json",
                    beforeSend: function (x) {
                        if (x && x.overrideMimeType) {
                            x.overrideMimeType("application/j-son;charset=UTF-8");
                        }
                    },
                    success: function (result) {

                        window.location.href = result;
                    }
                });
            }
</script>

