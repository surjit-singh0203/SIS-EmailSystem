
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@model DataBuildingLayer.ExportPeram2

<div id="idCP">
    <div class="row">
        <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div>
                <h2 style="text-align:center">Sync Email Configurations</h2>
            </div>
            @if (TempData["success"] != null)
            {
                <p class="alert alert-success" id="successMessage">@TempData["success"]</p>
            }
            @if (TempData["error"] != null)
            {
                <p class="alert alert-danger" id="errorMessage">@TempData["error"]</p>
            }
            <div class="col-md button-row-top">
                <a class="btn btn-info" href="@Url.Action("Add", "SyncToEmailReport", new { area = "SyncToEmailReport" })">
                    Add
                </a>
            </div>
        </div>
    </div>

    <div class="wrapper wrapper-content">
        <div class="container">
            <div style="overflow:auto; height:auto;">
                <table class="GeneratedTable centered-table">
                    <thead>
                        <tr>
                            
                            <th>Vessel(s)</th>
                            <th>Email To</th>
                            <th>Email CC</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SyncEmailList != null && Model.SyncEmailList.Any())
                        {
                            var idx = 1;
                            foreach (var item in Model.SyncEmailList)
                            {
                                var vesselNames = DataBuildingLayer.CommonClass.GetVesselNamesByImoNo(item.VesselId);
                                <tr data-id="@item.Id">
                                   
                                    <td>@(string.IsNullOrEmpty(vesselNames) ? item.VesselId : vesselNames)</td>
                                    <td class="sync-email-wrap">@item.EmailTo</td>
                                    <td class="sync-email-wrap">@item.EmailCC</td>
                                    <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                    <td>
                                        <div class="row button-row">
                                            <div class="col table-button-container">
                                                <button type="button" class="function-button table-button">
                                                    @Html.ActionLink("Edit", "Add", "SyncToEmailReport", new { area = "SyncToEmailReport", id = item.Id }, new { onclick = "" })
                                                </button>
                                            </div>
                                            <div class="col table-button-container">
                                                <button type="button" class="function-button table-button btn-delete" title="Delete" data-id="@item.Id">Delete</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align:center; color:red; font-weight:bold;">No Record Found !</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .sync-email-wrap {
        word-wrap: break-word;
        word-break: break-word;
        white-space: normal;
        max-width: 200px;
    }
</style>

<script type="text/javascript">
    setTimeout(function () {
        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);
</script>

<script type="text/javascript">
    $(document).on('click', '.btn-delete', function () {
        if (!confirm('Are you sure you want to delete this record?')) return;
        var id = $(this).data('id');
        $.ajax({
            url: '/SyncToEmailReport/SyncToEmailReport/Delete',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res && res.success) {
                    $('tr[data-id="' + id + '"]').fadeOut(300, function () { $(this).remove(); });
                } else {
                    alert(res && res.message ? res.message : 'Error deleting record.');
                }
            },
            error: function () { alert('Error deleting record.'); }
        });
    });
</script>
