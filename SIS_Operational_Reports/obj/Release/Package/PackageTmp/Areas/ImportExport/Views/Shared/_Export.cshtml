@model DataBuildingLayer.ExportPeram
<h2>
    Export Data
</h2>

@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.15/css/bootstrap-multiselect.css" type="text/css" />
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.15/js/bootstrap-multiselect.js"></script>*@

<link rel="stylesheet" href="~/Content/bootstrap-multiselect.css" type="text/css" />
    <script type="text/javascript" src="~/Content/bootstrap-multiselect.js"></script>


<div class="row">
    @*<div class="col-sm-12 form-group">
            <input type="file" name="photo" id="photo" multiple />
        </div>*@

    <label for="inputPassword" class="col-sm-12 col-form-label">Voyage No. (Press Ctrl. Key for multiple select Voyage No.)</label>
    <div style="display: flex; align-items: flex-end">
        <div class="col-sm-4">

            @Html.ListBoxFor(m => m.VoyageIds, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), new { @class = "form-control listbox", @multiple = "multiple" })

            @*@Html.ListBoxFor(model => model.VoyageIds, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "form-control listbox" })*@
            <span id="messageVoyid" style="color:red"></span>
        </div>


        @*<label class="col-sm-12 col-form-label">Date From</label>

        <div class="col-sm-4 form-group">
                   @Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "Date", @required = "true", @oninvalid = "setCustomValidity('Please Select Range of Date From.')" } })
            <span id="msgETDDateTime" style="color:red"></span>
        </div>
        <br />
        <label class="col-sm-12 col-form-label">Date To</label>
        <div class="col-sm-4 form-group">

            @Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "Date", @required = "true", @oninvalid = "setCustomValidity('Please Select Range of Date To.')" } })

        </div>*@
        <div class="clearfix"></div>
        <div class="col-sm-4" style="margin-left: 10px;">
            <input name="submit" type="submit" style="margin-left:100px" value="Export" id="Export" class="btn peach-btn btn-block btn-info" />
        </div>
        <div class="col-sm-4">
            @*<button onclick="Export_Attachment()" class="btn peach-btn btn-block btn-info">Export-Attachment</button>*@
            <a href="javascript:void(0);" onclick="exportSelectedVoyages()" class="btn btn-sm btn-light btn-edit">
                <i class="uil uil-edit-alt mr-2"></i>Export-Attachment
            </a>
        </div>
        @*<div class="col-sm-4">
            <input name="submit" type="submit" value="Import Attachments" id="Import" class="btn peach-btn btn-block btn-warning" />
        </div>*@
    </div>
</div>

<script>

    function exportSelectedVoyages() { debugger
       
        var selectedValues = $('#VoyageIds').val();
        var VoyageId = selectedValues.join(',');
        
        if (VoyageId != "") {
       
            var url = "@Url.Action("DownloadZipFile", "ImportExport")" + "?VoyageId=" + VoyageId;
            window.location.href = url;

        } else {
            
            alert("Please select at least one Voyage.");
        }
    }

</script>
