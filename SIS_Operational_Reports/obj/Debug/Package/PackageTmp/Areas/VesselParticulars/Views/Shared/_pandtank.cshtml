<!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->



<div id="idtank">

    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
        <div class="col-md">
            <h2>
                Vessel Tank/Pump Setting
            </h2>

        </div>
        <div class="col-md button-row-top">
            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>

        </div>
    </div>


    <div class="container">
        <div>
            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" placeholder="search by : vessel name" autocomplete="off" class="form-control" type="text" />
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div style="display:none" class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>
            <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->





            <table class="GeneratedTable centered-table">
                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Vessel Name</th>
                        <th>IMO</th>
                        <th>Pump</th>
                        <th>Tank</th>



                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.GetVesselList)
                    {


                        <tr>
                            <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                            <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                            <td> @Html.DisplayFor(modelItem => item.ImoNo)</td>


                            <td>

                                <div class="row button-row">
                                    <div class="col table-button-container">
                                        <button type="button" class="function-button table-button">
                                            @Html.ActionLink("View", "Index", "Pump", new { ImoNo = item.ImoNo }, new { onclick = "" })
                                        </button>
                                    </div>

                                </div>

                            </td>
                            <td>
                                <div class="row button-row">

                                    <div class="col table-button-container">
                                        <button type="button" class="function-button table-button">
                                            @Html.ActionLink("View", "Index", "VesselTanks", new { ImoNo = item.ImoNo }, new { onclick = "" })
                                        </button>
                                    </div>
                                </div>
                            </td>


                        </tr>
                    }


                </tbody>
            </table>




        </div>
        <br />
        <br />


    </div>



</div>






