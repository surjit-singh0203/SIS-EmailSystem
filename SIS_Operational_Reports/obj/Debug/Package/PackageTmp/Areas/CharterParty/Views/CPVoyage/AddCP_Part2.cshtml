@using DataBuildingLayer;
@model DataBuildingLayer.CharterPartyClass

@{
    ViewBag.Title = "AddCP_Part2";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

<h2>Charter Party Main-CONSUMPTION</h2>

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>

    <h2>Main-CONSUMPTION</h2>

    <table id="tblMainCONSUMPTION" class="table" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th style="width:100px">Speed</th>
                <th style="width:100px">LADEN</th>
                <th style="width:100px">BALLAST</th>
                <th style="width:100px">VLSFO</th>
                <th style="width:100px">DO</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (CPMainCONSUMPTIONClass customer2 in Model.MainCONSUMPTION)
            {
                <tr>
                    <td>@customer2.Speed</td>
                    <td>@customer2.ME_LADEN</td>
                    <td>@customer2.ME_BALLAST</td>
                    <td>@customer2.AE_VLSFO</td>
                    <td>@customer2.AE_DO</td>
                    <td><input type="button" id="button2" value="Remove" onclick="Remove2(this)" /></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td><input type="text" id="txtSpeed" /></td>
                <td><input type="text" id="txtME_LADEN" /></td>
                <td><input type="text" id="txtME_BALLAST" /></td>
                <td><input type="text" id="txtAE_VLSFO" /></td>
                <td><input type="text" id="txtAE_DO" /></td>
                <td>
                    @if (StaticHelper.UserRole == "Administrator")
                    {
                        <input type="button" id="btnAdd2" value="Add" />
                    }
                </td>
            </tr>
        </tfoot>
    </table>


    <br />
    <input type="button" id="btnSave" value="Save All" />
    <script type="text/javascript" src="~/js/forAdd.js"></script>
    <script type="text/javascript" src="~/js/forAdd1.js"></script>


    <script>
        // 2nd Grid
        $("body").on("click", "#btnAdd2", function () {
            //Reference the Name and Country TextBoxes.
            var txtSpeed = $("#txtSpeed");
            var txtME_LADEN = $("#txtME_LADEN");
            var txtME_BALLAST = $("#txtME_BALLAST");
            var txtAE_VLSFO = $("#txtAE_VLSFO");
            var txtAE_DO = $("#txtAE_DO");

            //Get the reference of the Table's TBODY element.
            var tBody2 = $("#tblMainCONSUMPTION > TBODY")[0];

            //Add Row.
            var row2 = tBody2.insertRow(-1);

            //Add Speed cell.
            var cell2 = $(row2.insertCell(-1));
            cell2.html(txtSpeed.val());

            //Add ME_LADEN cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtME_LADEN.val());

            //Add ME_BALLAST cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtME_BALLAST.val());

            //Add AE_VLSFO cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtAE_VLSFO.val());

            //Add AE_DO cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtAE_DO.val());

            //Add Button cell.
            cell2 = $(row2.insertCell(-1));
            var btnRemove = $("<input />");
            btnRemove.attr("id", "button2");
            btnRemove.attr("type", "button");
            btnRemove.attr("onclick", "Remove2(this);");
            btnRemove.val("Remove");
            cell2.append(btnRemove);

            //Clear the TextBoxes.
            txtSpeed.val("");
            txtME_LADEN.val("");
            txtME_BALLAST.val("");
            txtAE_VLSFO.val("");
            txtAE_DO.val("");
        });

        function Remove2(button) {
            //Determine the reference of the Row using the Button.
            var row2 = $(button).closest("TR");
            var name = $("TD", row2).eq(0).html();
            if (confirm("Do you want to delete: " + name)) {
                //Get the reference of the Table.
                var table2 = $("#tblMainCONSUMPTION")[0];

                //Delete the Table row using it's Index.
                table2.deleteRow(row2[0].rowIndex);
            }
        };



    </script>


