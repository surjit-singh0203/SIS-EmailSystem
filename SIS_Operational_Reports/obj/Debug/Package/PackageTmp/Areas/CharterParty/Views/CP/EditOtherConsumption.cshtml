@using DataBuildingLayer;
@model CPOtherCONSUMPTIONClass
@{
    ViewBag.Title = "EditOtherConsumption";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


@using (Html.BeginForm("EditOtherConsumption", "CP"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)

	<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>
            <h2>
                Edit Other-Consumption
            </h2>
			@*<ol class="breadcrumb">
                        <li><a href="">Home</a></li>
                        <li><a href="">Form</a></li>
                        <li><a>Create</a></li>
                    </ol>*@
            
        </div>
        		<div class="col-md button-row-top">
					@*<button name="Submit" type="submit" class="btn btn-success btn-width" onclick="this.form.submit();this.disabled = true; this.value = 'Submit...';"><i class="uil uil-check mr-2"></i>Submit</button>*@
                <button name="Submit" type="submit" class="btn btn-success btn-width"><i class="uil uil-check mr-2"></i>Submit</button>
                <button name="Reset" onClick="window.location.reload();" type="reset" id="btnReset" class="btn btn-danger btn-width"><i class="uil uil-redo mr-2"></i>Reset</button>
                <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> << Go Back</a>
                </div>
    </div>
	</div>
	
    <div id="page-wrapper" class="content">

        
        <div class="wrapper wrapper-content">
            <div class="container">
                <div class="form-body">
                    <div class="row">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div style="display:none">
                            @Html.TextBoxFor(model => model.Id, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control", @maxlength = 50, @required = "true", } })

                        </div>

                        <div style="display:none">
                            @Html.TextBoxFor(model => model.CPId, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control", @maxlength = 50, @required = "true", } })
                            <div class="error"></div>
                        </div>

                        <div class="col-md-8 mx-auto">
                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">Other-Consumption<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">

                                    @Html.EditorFor(model => model.Consumption, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @readonly=true, @required = "true", } })
                                    @*@Html.EditorFor(model => model.Consumption, new { @class = "form-control bottom-border-input", @disabled = "true", @autocomplete = "off", @onkeydown = "return false", @required = "true" })*@
                                    <span id="messageImo"></span>
                                </div>
                            </div>

                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">AE_VLSFO<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.AE_VLSFO, new { htmlAttributes = new { @onkeypress = "return isNumberKey(event)", @class = "form-control bottom-border-input check-decimal", @placeholder = "0.000", @autocomplete = "off",   @required = "true" } })
                                    <span id="messageImo"></span>
                                </div>
                            </div>
                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">AE_MDO<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.AE_MDO, new { htmlAttributes = new { @onkeypress = "return isNumberKey(event)", @class = "form-control bottom-border-input check-decimal", @placeholder = "0.000", @autocomplete = "off",   @required = "true" } })
                                    <span id="messageImo"></span>
                                </div>
                            </div>
                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">BOILER_MDO<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.BOILER_MDO, new { htmlAttributes = new { @onkeypress = "return isNumberKey(event)", @class = "form-control bottom-border-input check-decimal", @placeholder = "0.000", @autocomplete = "off",   @required = "true" } })
                                    <span id="messageImo"></span>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

<script>

        $('#Menu1').removeClass('active');
        $('#Menu2').removeClass('active');
        $('#Menu3').addClass('active');
        $('#Menu4').removeClass('active');
        $('#Menu5').removeClass('active');


</script>
<script>
    function goBack() {
        window.history.back();
    }
</script>

<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>

<script type="text/javascript">

    $(".check-decimal").on("keypress", function (event) {
        var charCode = (event.which) ? event.which : event.keyCode;
        var value = $(this).val();

        // Check for '.' and ensure there's only one
        if (charCode == 46 && value.indexOf('.') != -1) {
            return false;
        }

        // Allow only backspace, delete, and numeric values
        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }

        // Check for valid decimal values (e.g., .333, 0.963, 2.333)
        var finalValue = value + String.fromCharCode(charCode);
        var validDecimal = /^\d*\.?\d{0,3}$/; // allow up to 3 decimal places

        if (!validDecimal.test(finalValue)) {
            return false;
        }

        return true;
    });

</script>