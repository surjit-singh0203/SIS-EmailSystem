@using DataBuildingLayer;
@model DataBuildingLayer.VoyageClass
@{
                /**/

                ViewBag.Title = "insertleg";
                Layout = "~/Views/Shared/_LayoutMain.cshtml";
}


<table id="tblvoyageleg" class="GeneratedTable" cellpadding="0" cellspacing="0">
    <thead>
        <tr>

            <th id="LegA">
                Leg Port (A)
            </th>
            <th id="ReasonA">
                Reason for Port Call (A)
            </th>
            <th id="LegB">
                Leg Port (B)
            </th>
            <th id="ReasonB">
                Reason for Port Call (B)

            </th>
            <th id="LegDTG" >DTG</th>
            <th id="LegCP_SOG">CP SOG</th>
            <th id="LegCP_Log_Speed">CP Log Speed</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (VoyageLeg VLeg in Model.VoyageLegList)
        {
        <tr>
            <td>@VLeg.LegPort_A</td>
            <td>@VLeg.ReasonforPortCall_A</td>
            <td>@VLeg.LegPort_B</td>
            <td>@VLeg.ReasonforPortCall_B</td>
            <td>@VLeg.DTG</td>
            <td>@VLeg.CP_SOG</td>
            <td>@VLeg.CP_Log_Speed</td>
            <td><input class="btn btn-info" type="button" value="Remove" onclick="Remove(this)" /></td>
        </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td> @Html.DropDownListFor(model => model.LegPort_A, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>

            <td>  @Html.DropDownListFor(model => model.ReasonforPortCall_A, new SelectList(Model.PortStatusList, "Status", "Status"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            <td> @Html.DropDownListFor(model => model.LegPort_B, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            <td>  @Html.DropDownListFor(model => model.ReasonforPortCall_B, new SelectList(Model.PortStatusList, "Status", "Status"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            <td>@Html.EditorFor(model => model.DTG, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 8,  @max = "9999", @required = "true", @onKeyUp = "requiredValue2(this)" } })</td>
            <td>  @Html.DropDownListFor(model => model.CP_SOG, new SelectList(Model.SpeedStatusList, "Speed", "Speed"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            @*<td> @Html.EditorFor(model => model.CP_SOG, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>*@
            <td> @Html.EditorFor(model => model.CP_Log_Speed, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
            <td>
                @if (StaticHelper.UserRole == "Administrator")
                {
                    <input class="btn btn-info" type="button" id="btnAdd" value="Add" />
                }
                </td>


        </tr>
    </tfoot>
</table>





<input class="btn btn-success btn-width" type="button" id="btnSave" value="Save All" />


<script type="text/javascript">
    function requiredValue1(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 1) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }
        if (value > 99.99) {

            $("#" + id + "").val('');
        }

    }
</script>
