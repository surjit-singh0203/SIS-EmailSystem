<script type="text/javascript" src="~/js/addremoveRows.js"></script>
<script type="text/javascript">
    $("body").on("click", "#btnAdd", function () {
        //Reference the Name and Country TextBoxes.

        debugger;
        var rsnA = $("#ReasonforPortCall_A option:selected").text();
        var rsnB = $("#ReasonforPortCall_B option:selected").text();

        var legA = $("#LegPort_A option:selected").text();
        var legB = $("#LegPort_B option:selected").text();


        if (legA == "") {
            alert("Please Choose Leg Port(A)");
            return;
        }
        if (rsnA == "") {
            alert("Please Choose Reason for Port Call (A)");
