            return;
        }
       
       


     
        var txtLegA = $("#LegPort_A");

      

        var txtRsnA = $("#ReasonforPortCall_A");
        var txtLegB = $("#LegPort_B");
        var txtRsnB = $("#ReasonforPortCall_B");

        var txtDTG = $("#DTG");
        var txtCP_SOG = $("#CP_SOG");
        var txtCP_Log_Speed = $("#CP_Log_Speed");

        //Get the reference of the Table's TBODY element.
        var tBody = $("#tblvoyageleg > TBODY")[0];

        //Add Row.
        var row = tBody.insertRow(-1);

        //Add Name cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtLegA.val());

        //Add Height cell.
        cell = $(row.insertCell(-1));
        //alert(VesselName);
        debugger;
        cell.html(txtRsnA.val());

        //Add Capacity cell.
        cell = $(row.insertCell(-1));
        cell.html(txtLegB.val());

        //Add Capacity cell.
        cell = $(row.insertCell(-1));
        cell.html(txtRsnB.val());

        //Add DTG cell.
        cell = $(row.insertCell(-1));
        cell.html(txtDTG.val());

        //Add CP_SOG cell.
        cell = $(row.insertCell(-1));
        cell.html(txtCP_SOG.val());

        //Add Log_Speed cell.
        cell = $(row.insertCell(-1));
        cell.html(txtCP_Log_Speed.val());

        //Add Button cell.
        cell = $(row.insertCell(-1));
        var btnRemove = $("<input />");
        btnRemove.attr("type", "button");
        btnRemove.attr("class", "btn btn-danger btn-width");
        btnRemove.attr("onclick", "Remove(this);");
        btnRemove.val("Remove");
        cell.append(btnRemove);

        //Clear the TextBoxes.
        txtLegA.val("");
        txtRsnA.val("");
        txtLegB.val("");
        txtRsnB.val("");
    });

    function Remove(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        if (confirm("Do you want to delete: " + name)) {
            //Get the reference of the Table.
            var table = $("#tblvoyageleg")[0];

            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        }
    };

    $("body").on("click", "#btnSave", function () {
        //Loop through the Table rows and build a JSON array.

        //var url = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
        //var urlparam = url[0].split('=');
        var result = getUrlVars()["id"];
    //    var ww = this.href.substring(this.href.lastIndexOf('/') + 1);
        //alert(result);
        var voyage = new Array();
        $("#tblvoyageleg TBODY TR").each(function () {
            var row = $(this);
            var VG = {};
            VG.LegPort_A = row.find("TD").eq(0).html();
            VG.ReasonforPortCall_A = row.find("TD").eq(1).html();
            VG.LegPort_B = row.find("TD").eq(2).html();
            VG.ReasonforPortCall_B = row.find("TD").eq(3).html();
            VG.DTG = row.find("TD").eq(4).html();
            VG.CP_SOG = row.find("TD").eq(5).html();
            VG.CP_Log_Speed = row.find("TD").eq(6).html();
            VG.Id = result;
            voyage.push(VG);
        });
        var origin = window.location.origin;
        // alert(origin);
        //Send the JSON array to Controller using AJAX.
        $.ajax({
            type: "POST",

            url: "/CharterParty/Voyage/insertlegD",
            data: JSON.stringify(voyage),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                //alert(r + " record(s) inserted.");

               // window.location = origin + "/CharterParty/Voyage/addfuel?vid=" + r + "";

                if (response.Success) {
                    //alert("CP_Part2 Completed" + response.Data);
                    window.location.href = "/CharterParty/Voyage/" + response.Data;
                } else {
                    //alert("CP_Part1 Error");
                    //window.location.href = "/CharterParty/CP/AddCP_Part1"
                }
            }

            //success: function (json) {

            //    if (json.isRedirect) {
            //        window.location.href = json.redirectUrl;
            //    }
            //},
        });
    });
</script>


<script>
    function getUrlVars() {
        var vars = [], hash;
        var hashes = window.location.href.slice(window.location.href.indexOf('/') + 1).split('&');
        for (var i = 0; i < hashes.length; i++) {
            hash = hashes[i].split('=');
            vars.push(hash[0]);
            vars[hash[0]] = hash[1];
        }
        return vars;
    }
</script>