<script>

    $("#btnSearch").click(function () {
        var Ship_CD = "";
        Ship_CD = $("#VesselIDs").val();
        var year = 2023;
      //  alert(Ship_CD);
        debugger;

        if (Ship_CD == "") {
            alert("Please Select Vessel from Dropdown.");
            return;
        }
  
        else {

            $("#test1").html("");
            var ai = {
                year: year,
                Ship_CD: Ship_CD,
            }
            $.ajax({
                type: "post",
                url: '/Report/DNVGL/_DNVGLReport?year=' + year + '&Ship_CD=' + Ship_CD,
                data: JSON.stringify(ai),
                datatype: "json",
                success: function (data) {
                    if (data.trim() != "") {
                        $("#test1").fadeIn("fast");
                        $("#test1").html("");
                        $("#test1").html(data);
                    }
                    else {
                        $("#test1").html("");
                        $("#test1").html('<div class="text-danger card-avatar text-center"><img class="imgnorecord" src="../Include/Admin/img/norecord.png"/><br/>no record found</div>');
                    }
                },
                error: function (data) {
                    $("#test1").html("");
                    $("#test1").html(data);
                }
            });

        }

    });

</script>



<script>

    $(function () {
        $('#VesselIDs').multiselect({
