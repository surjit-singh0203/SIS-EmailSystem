


@model DataBuildingLayer.DailyNoonReport



<div id="test">
    <div>
        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
            <div class="col-md">
                <h2>Bulk Noon-Report</h2>
            </div>
        </div>
    </div>
    <div id="idMaindiv" class="container">
        <div>
            <div class="search-row">
                <div class="col m-1">

                    @Html.DropDownListFor(model => model.VesselId, new SelectList(Model.VesselList, "Value", "Text"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                </div>
                <div class="col m-1">

                    <input id="idFirst" placeholder="search by : voyage no." autocomplete="off" class="form-control" type="text">

                </div>

                <div class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">

                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>

                <a href='@Url.Action("DownloadExcel", "bulkNoon")' class="function-button submit-button m-1">Export</a>
            </div>

            <table class="GeneratedTable centered-table">
                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Vessel Name</th>
                        <th>Voyage No.</th>
                        <th>Leg</th>
                        <th>Status</th>
                        <th>In Port Status</th>
                        <th>CP Speed</th>
                        <th>Report Date</th>
                        <th>Speed Distance Time    </th>
                        <th>Engine    </th>

                        <th>Fuel ROB    </th>
                        <th>LO & Ho Consumption</th>
                        <th>Fuel Consumption</th>

                        @*<th>Action</th>*@
                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.GetNoonRList)
                    {


                        <tr>
                            <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                            <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                            <td> @Html.DisplayFor(modelItem => item.voyagenumber)</td>
                            <td> @Html.DisplayFor(modelItem => item.LegPortName)</td>
                            <td> @Html.DisplayFor(modelItem => item.Status)</td>
                            <td> @Html.DisplayFor(modelItem => item.AtSeaOrPort)</td>
                            <td> @Html.DisplayFor(modelItem => item.CP_Speed)</td>
                            <td> @Html.DisplayFor(modelItem => item.Date)</td>
                            <td>
                                <button type="button" class="function-button table-button">
                                    @Html.ActionLink("View Detail", "Edit", "BulkNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "SpeedDis" }, new { onclick = "" })
                                </button>
                            </td>
                            <td>
                                <button type="button" class="function-button table-button">
                                    @Html.ActionLink("View Detail", "Edit", "BulkNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "Eng" }, new { onclick = "" })
                                </button>
                            </td>
                            <td>
                                <button type="button" class="function-button table-button">
                                    @Html.ActionLink("View Detail", "Edit", "BulkNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "FRob" }, new { onclick = "" })
                                </button>
                            </td>
                            <td>
                                <button type="button" class="function-button table-button">
                                    @Html.ActionLink("View Detail", "Edit", "BulkNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "LoHoCons" }, new { onclick = "" })
                                </button>
                            </td>
                            <td>
                                <button type="button" class="function-button table-button">
                                    @Html.ActionLink("View Detail", "Edit", "BulkNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "FCons" }, new { onclick = "" })
                                </button>
                            </td>
                            @*<td>
                                <button type="button" class="function-button table-button">
                                    @Html.ActionLink("Download", "DownloadExcel", "BulkNoon", new { id = item.Id, vesselid = item.VesselId, actionName = "FCons" }, new { onclick = "" })
                                </button>
                            </td>*@
                        </tr>
                    }


                </tbody>
            </table>




