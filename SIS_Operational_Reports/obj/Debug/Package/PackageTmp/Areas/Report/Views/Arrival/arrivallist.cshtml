    <div class="container">
        <div>
            @*<div class="col-md">
                    <h4>Arrival-Report List</h4>
                </div>*@

            <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->


            <div class="search-row">

                <div class="col m-1">
                    @*@Html.DropDownListFor(model => model.VesselIDs, new SelectList(Model.VesselList, "Value", "Text"), new { @class = "form-control importexport", @multiple = "multiple", })*@

                    @Html.DropDownListFor(model => model.VesselId, new SelectList(Model.VesselList, "Value", "Text"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2",  @required = "true", })
                </div>
                <div class="col m-1">

                    <input id="idFirst" placeholder="search by : voyage no." autocomplete="off" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <table class="GeneratedTable centered-table">
                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Voyage No.</th>
                        <th>Place</th>
                        <th>EOSP</th>

                        <th>Status</th>
                        <th>Vessel Name</th>
                        @*<th>Submit Date</th>*@

                        <th>Action</th>

                        <th>Download</th>


                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.GetArrivalRList)
                    {


                    <tr>
                        <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                        <td> @Html.DisplayFor(modelItem => item.voyagenumber)</td>
                        <td> @Html.DisplayFor(modelItem => item.Place)</td>
                        @*<td> @Html.DisplayFor(modelItem => item.EOSP)</td>*@
                        <td>
                            @{ DateTime? cdt1 = item.EOSP;
                                if (cdt1 != null)
                                {
                                    @Html.Raw(cdt1.Value.ToString("dd-MMM-yyyy")) } }
                        </td>


                        <td>

                            @{ var svd = item.SaveDraft;
                                if (svd == true)
                                {
                                    @Html.Raw("In Draft") }
                                else
                                {
                                    @Html.Raw("Submitted") } }
                        </td>
                        @*<td>
            @{ DateTime? cdt = item.CreatedDate;
                if (cdt != null)
                {
                    @Html.Raw(cdt.Value.ToString("dd-MMM-yyyy")) } }
        </td>*@
                        <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                        <td>

                            <div class="row button-row">
                                <div class="col table-button-container">
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("View/Edit", "Edit", "Arrival", new { id = item.Id, vesselid = item.VesselId }, new { onclick = "" })
                                    </button>
                                </div>

                            </div>

                        </td>

                        <td>
                            <button type="button" class="function-button table-button">
                                @Html.ActionLink("Download Report", "DownloadExcel", "Arrival", new { id = item.Id, vesselid = item.VesselId, actionName = "FCons" }, new { onclick = "" })
                            </button>
                        </td>


                    </tr>
                    }


                </tbody>
            </table>
            <!-- Codes by Quackit.com -->

            <nav aria-label="Page navigation example">
                <ul class="pagination">


                    @{
                        int totalRecords = 0;
                        foreach (var item in Model.GetArrivalRList)
                        {
                            totalRecords = item.TotalCount;
                            break;
                        }
                        //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                        // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                        int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                        int tot_pages = totalRecords / pageSize;
                        int remainder = totalRecords % pageSize;

                        tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                        int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                        if (totalRecords > 0)
                        {
                            if (currPage == 0)
                            {
                                currPage = 1;
                            }

                            if (currPage != 1)
                            {
                                <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "arrivallist", "Arrival", new { pageNo = 1 }, null)</a></li>
                            }

                            if (currPage != tot_pages)
                            {
                                for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                {
                                    if (cnt == currPage)
                                    {
                                        <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item">@Html.ActionLink(cnt.ToString(), "arrivallist", "Arrival", new { pageNo = cnt }, null)</li>
                                    }

                                    if (cnt == tot_pages)
                                    {
                                        break;
                                    }
                                }
                            }


                            if (currPage == tot_pages)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                            }
                            else
                            {
                                <li class="page-item">@Html.ActionLink("Last", "arrivallist", "Arrival", new { pageNo = tot_pages }, null)</li>
                            }
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>

</div>
<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

