                                        using (SqlDataAdapter adp = new SqlDataAdapter("SELECT EOSP AS Date FROM ArrivalReport WHERE CAST(EOSP AS date) = CONVERT(date, '" + rptdt + "', 120)", ConnectionBulder.con))
