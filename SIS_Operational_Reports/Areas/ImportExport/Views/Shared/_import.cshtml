<script type="text/javascript">
    $(document).ready(function () {
        $('#photo').change(function () {

            var fp = $("#photo");
            var lg = fp[0].files.length;
            var items = fp[0].files;
            var fileSize = 0;

            var fileName = document.querySelector('#photo').value;

            if (!fileName.endsWith('.xlsx') && !fileName.endsWith('.xls') && !fileName.endsWith('.XLS') && !fileName.endsWith('.XLSX')) {
                alert('Please upload excel file only.');
                document.getElementById("photo").value = null;
                return false;
            }
            if (lg > 0) {
                for (var i = 0; i < lg; i++) {
                    fileSize = fileSize + items[i].size;
                }
                if (fileSize >= 10485760) {
                    alert('File size must not be more than 10 MB');
                    $('#photo').val('');
                }
            }

        });
    });
</script>



