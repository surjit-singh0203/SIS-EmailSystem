
@{
    ViewBag.Title = "Import";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Import Data</h2>


<div class="content-wrapper">
    <section class="content-header">
        @*<h1>
                Import/ Export
            </h1>*@
    </section>
    <section class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="box box-info">
                    <div class="box-header with-border">
                        <div>
                            @using (Html.BeginForm("Import", "ImportExport", FormMethod.Post, new { area = "ImportExport", enctype = "multipart/form-data" }))
                            {
                                <div class="col-md-6">
                                    @Html.Partial("_import")
                                </div>

                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>



