@model DataBuildingLayer.ErrorLogClass

@{
    //test git
    ViewBag.Title = "ErrorLog";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div id="idCP">

    <div class="page-heading page-header-flex">
        <div>
            <h1 class="page-title">
              Error Log
            </h1>
        </div>        
    </div>
    <div class="wrapper wrapper-content">
        <div class="container">           
            <div class="table-responsive">
                <table class="GeneratedTable centered-table">
                    <thead>
                        <tr>
                            <th>Sr. No.</th>
                            <th>Sheet Name</th>
                            <th>Imported Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = 0;
                        }
                        @foreach (var item in Model.ErrorLogInfo)
                        {
                            count++;
                        <tr>
                            <td> @count</td>
                            <td> @Html.DisplayFor(modelItem => item.SheetName)</td>

                            <td>
                                @{ DateTime? cdt1 = item.ImportDate;
                                    if (cdt1 != null)
                                    {
                                        @Html.Raw(cdt1.Value.ToString("dd-MMM-yyyy")) } }
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
