<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.24/jquery-ui.min.js"></script>
<script type="text/javascript">
    $(function () {

        $("#tbltanks").sortable({
            // items: 'tr',
            // items: 'tr:not(tr:first-child)',
            cursor: 'pointer',
            axis: 'y',
            dropOnEmpty: false,
            start: function (e, ui) {
                ui.item.addClass("selected");
            },
            stop: function (e, ui) {
                ui.item.removeClass("selected");
                $(this).find("tr").each(function (index) {
                    if (index > 0) {
                        debugger;
                        $(this).find("td").eq(0).html(index);
                        //$(this).find("td").val(index + 1);

                    }
                });
            }
        });
    });
</script>
<script>



        function SaveData() {


            var tanklist = []; // list object
            //$('#tbl1 > tbody  > tr').each(function () { //loop in table list

            $('#tbltanks tr').each(function () {
                debugger;
                var tanks = {};
                var name = $(this).find("td").eq(2).html();
                var height = $(this).find("td").eq(3).html();
                var capacity = $(this).find("td").eq(4).html();
                var tankstypeid = $(this).find("td").eq(5).html();



                tanks.Name = name;
                tanks.Height = height;
                tanks.Capacity = capacity;
                tanks.TanksTypeId = tankstypeid;
                tanklist.push(tanks);
            });


            debugger;
            tanklist = JSON.stringify(tanklist);



            $.ajax({
                url: '@Url.Action("InsertInOrder", "VesselTanks")',
                type: "POST",
                data: { 'tanklist': tanklist },
                dataType: "json",
                beforeSend: function (x) {
                    if (x && x.overrideMimeType) {
                        x.overrideMimeType("application/j-son;charset=UTF-8");
                    }
                },
                success: function (result) {
                    debugger;
                    window.location.href = result;
                }
            });



        }

</script>


