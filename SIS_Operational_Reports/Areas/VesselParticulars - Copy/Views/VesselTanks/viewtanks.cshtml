        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>
    function getUrlVars() {
        var vars = [], hash;
        var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
        for (var i = 0; i < hashes.length; i++) {
            hash = hashes[i].split('=');
            vars.push(hash[0]);
            vars[hash[0]] = hash[1];
        }
        return vars;
    }
</script>

<script>
    var result = getUrlVars()["typeid"];
    if (result == "1") {

        $("#idtitle").html("Cargo Tanks List");
    }
    if (result == "2") {
        $("#idtitle").html("Cargo Holds List");
    }
    if (result == "3") {
        $("#idtitle").html("Ballast Tanks List");
    }
    if (result == "4") {
        $("#idtitle").html("Void Spaces List");
    }
    if (result == "5") {
        $("#idtitle").html("Bunker Tanks List");
    }
    if (result == "6") {
        $("#idtitle").html("Lube Oil Tanks List");
    }
    if (result == "7") {
        $("#idtitle").html("Fresh Water Tanks List");
    }
    if (result == "8") {
        $("#idtitle").html("Other Tanks List");
    }
    if (result == "9") {
        $("#idtitle").html("Other Spaces List");
    }

</script>


