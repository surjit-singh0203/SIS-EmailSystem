<div class="container">
    <div class="row">
        

        <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->


        <table class="GeneratedTable centered-table">
            <thead>
                <tr>
                    <th style="display:none">Id</th>
                    <th>Tank Type</th>
                    <th>Maintaining ROBs</th>

                    <th>Action</th>


                </tr>

            </thead>
            <tbody>
                @{
                    int count = 0;
                    var No = "No";
                    var Yes = "Yes";
                    bool MaintainROBs = true;
                }
                @foreach (var item in Model.GetTanksTypeList)
                {

                    MaintainROBs = item.MaintainingROBs;
                    count++;


                <tr>
                    <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                    <td> @Html.DisplayFor(modelItem => item.TankType)</td>

                    @if (MaintainROBs == true)
                    {
                        <td>
                            <label id="radYes_@(count)" onchange="valCheck('@(Yes + count)')" class="radio-inline"><input type="radio" checked name="optradio('@(Yes + count)')" required>Yes</label>

                            <label id="radNo_@(count)" onchange="valCheck('@(No + count)')" class="radio-inline"><input type="radio" name="optradio('@(Yes + count)')" required>No</label>

                        </td>
                    }

                    else
                    {
                        <td>
                            <label id="radYes_@(count)" onchange="valCheck('@(Yes + count)')" class="radio-inline"><input type="radio" name="optradio('@(Yes + count)')" required>Yes</label>

                            <label id="radNo_@(count)" onchange="valCheck('@(No + count)')" class="radio-inline"><input type="radio" checked name="optradio('@(Yes + count)')" required>No</label>

                        </td>
                    }

                    @if (MaintainROBs == true)
                    {
                        <td>
                            <div id="action_@(count)" style="display:block">
                                <a href="@Url.Action("inserttank", "VesselTanks", new { typeid = count })" class="btn btn-sm btn-light btn-edit">
                                    <i class="uil uil-edit-alt mr-2"></i>Add
                                </a>
                                |
                                <a href="@Url.Action("viewtanks", "VesselTanks", new { typeid = count })" class="btn btn-sm btn-light btn-edit">
                                    <i class="uil uil-edit-alt mr-2"></i>View
                                </a>

                            </div>
                        </td>
                    }
                    else
                    {
                        <td>
                            <div id="action_@(count)" style="display:none">
                                <a href="@Url.Action("inserttank", "VesselTanks", new { typeid = count })" class="btn btn-sm btn-light btn-edit">
                                    <i class="uil uil-edit-alt mr-2"></i>Add
                                </a>
                                |
                                <a href="@Url.Action("viewtanks", "VesselTanks", new { typeid = count })" class="btn btn-sm btn-light btn-edit">
                                    <i class="uil uil-edit-alt mr-2"></i>View
                                </a>

                            </div>
                        </td>
                    }


                    </tr>
                }


            </tbody>
        </table>
        <!-- Codes by Quackit.com -->


    </div>
</div>

