                                                            }

                                                            if (data.Reports[i] == "N")
                                                            {
                                                                <a target="_blank" href="/Report/DailyNoon/EditFromDashboard?reportdate=@data.Date[i]&vesselid=@data.ImoNo">N</a>
                                                            }

                                                            if (data.Reports[i] == "B")
                                                            {
                                                                <a target="_blank" href="/Report/Berthing/EditFromDashboard?reportdate=@data.Date[i]&vesselid=@data.ImoNo">B</a>
                                                            }

                                                            if (data.Reports[i] == "D")
                                                            {
