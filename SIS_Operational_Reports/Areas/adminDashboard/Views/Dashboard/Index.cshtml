                                List<ReportList> Report = new List<ReportList>();
                                //string M_Date = year + "-" + month + "-" + j;
                                //DateTime Date_M = Convert.ToDateTime(M_Date).Date;

                                using (SqlDataAdapter adapter = new SqlDataAdapter("spDashboardReport3", ConnectionBulder.con))
                                {
                                    adapter.SelectCommand.CommandType = CommandType.StoredProcedure;
                                    adapter.SelectCommand.Parameters.AddWithValue("@Contract_Year", year);
                                    adapter.SelectCommand.Parameters.AddWithValue("@Contract_Month", monthName);
                                    adapter.SelectCommand.Parameters.AddWithValue("@VesselId", item.ImoNo);
                                    // adapter.SelectCommand.Parameters.AddWithValue("@Action", "VoyageList");
                                    using (DataTable dt = new DataTable())
                                    {
                                        adapter.Fill(dt);
                                        if (dt.Rows.Count > 0)
                                        {
                                            for (int i = 0; i < dt.Rows.Count; i++)
                                            {

                                                string D_Date = year + "-" + month + "-" + k;
                                                // DateTime Date1 = Convert.ToDateTime(D_Date).Date;
                                                string D_Date1 = dt.Rows[i]["Date"].ToString();
                                                string Date1 = Convert.ToDateTime(dt.Rows[i]["Date"]).ToString("yyyy/MM/dd");
                                                DateTime Date2 = Convert.ToDateTime(D_Date1).Date;
                                                //if (Date2 > Date1)
                                                //{
                                                //    TimeSpan difference = Date1 - Date2;
                                                //    int daysDifference = difference.Days;
                                                //    Date1 = Date1.AddDays(daysDifference);
                                                //    k+=daysDifference;
                                                //}
                                                //if (Date2 < Date1)
                                                //{
                                                //    TimeSpan difference = Date1 - Date2;
                                                //    int daysDifference = difference.Days;
                                                //    Date1 = Date1.AddDays(daysDifference);
                                                //    k -= daysDifference;
                                                //}

                                                ReportList existingEntry = Report.FirstOrDefault(r => r._Date == Date1.ToString());

                                                if (existingEntry == null)
                                                {
                                                    // Create a new entry if it doesn't exist
                                                    existingEntry = new ReportList
                                                    {
                                                        _Date = Date1.ToString(),
                                                        // Date = Convert.ToDateTime(dt.Rows[i]["Date"]),
                                                        Date = new List<DateTime>(),
                                                        ImoNo = item.ImoNo,
                                                        Reports = new List<string>()
                                                    };
                                                    Report.Add(existingEntry);

                                                    existingEntry.Reports.Add(dt.Rows[i]["Report"].ToString());
                                                    existingEntry.Date.Add(Convert.ToDateTime(dt.Rows[i]["Date"]));
                                                }
                                                else
                                                {
                                                    // Add the report to the existing entry
                                                    existingEntry.Reports.Add(dt.Rows[i]["Report"].ToString());
                                                    existingEntry.Date.Add(Convert.ToDateTime(dt.Rows[i]["Date"]));
                                                }

                                                //if (Date2 == Date1)
                                                //{
                                                //    k++;
                                                //}

