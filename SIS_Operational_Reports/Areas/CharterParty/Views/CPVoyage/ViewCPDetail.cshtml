@using DataBuildingLayer;
@model CharterPartyClass
@{
    ViewBag.Title = "ViewCPDetail";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}
<h1> Charter Party Detail</h1>
<div class="page-heading page-header-flex">

  <h4 style="text-align:center" >


        @if (ViewBag.VesselName != null)
        {
            <p>Vessel Name :-  <b>@ViewBag.VesselName</b>  </p>
        }
    </h4>

    <table class="table">
        <thead>
            <tr>
                <th style="display:none">ID</th>
                <th>Charter Party ID</th>

                <th>Start Date</th>
                <th>End Date</th>

                <th>Voyage Type</th>


            </tr>

        </thead>
        <tbody>



            <tr>
                <td style="display:none"> @Html.DisplayFor(modelItem => modelItem.Id)</td>
                <td> @Html.DisplayFor(modelItem => modelItem.CPNo)</td>

                <td>
                    @{
                        var csdate = Model.StartDate.ToString("dd-MMM-yyyy");
                        @Html.Raw(csdate);
                    }
                </td>
                <td>
                    @{
                        var CEdate = Model.EndDate.ToString("dd-MMM-yyyy");
                        @Html.Raw(CEdate);
                    }
                </td>

                <td> @Html.DisplayFor(modelItem => modelItem.VoyageType)</td>



            </tr>



        </tbody>
    </table>
    <a name="back" id="btnBack" href="@Url.Action("Index", "CPVoyage")" class="btn btn-primary btn-width"> << Go Back</a>
    <!--<div class="form-actions">-->
    @*<button name="Submit" type="submit" class="btn btn-success btn-width" onclick="this.form.submit();this.disabled = true; this.value = 'Submit...';"><i class="uil uil-check mr-2"></i>Submit</button>*@
    <!--<button name="Submit" type="submit" class="btn btn-success btn-width"><i class="uil uil-check mr-2"></i>Submit</button>
        <button name="Reset" type="reset" id="btnReset" class="btn btn-danger btn-width"><i class="uil uil-redo mr-2"></i>Reset</button>
        <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> << Go Back</a>
    </div>-->


</div>


<div class="wrapper wrapper-content">
    <div class="container">

        <div class="form-body">
            <div class="table-responsive">
                <h3 class="card-title">Charter Party Vessels</h3>
                @*<div>
                    <a href="@Url.Action("AddCP_Part1", "CPVoyage", new { id = Model.Id })" class="btn btn-sm btn-light btn-edit">
                        <i class="uil uil-edit-alt mr-2"></i>Add Vessels
                    </a>
                </div>*@
                <table class="table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th>Vessel Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                          


                        </tr>

                    </thead>
                    <tbody>

                        @foreach (var item in Model.CPVesselInfo)
                        {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.CPId)</td>
                                @*<td> @Html.DisplayFor(modelItem => item.VesselID)</td>*@
                                <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                                <td>
                                    @{
                                        var sdate = item.StartDate.ToString("dd-MMM-yyyy");
                                        @Html.Raw(sdate);
                                    }
                                </td>
                                <td>
                                    @{
                                        var Edate = item.EndDate.ToString("dd-MMM-yyyy");
                                        @Html.Raw(Edate);
                                    }
                                </td>

                              

                            </tr>
                        }


                    </tbody>
                </table>
            </div>


            <div class="table-responsive">
                <h3 class="card-title">Charter Party Main Consumption</h3>
               
                <table class="table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th style="display:none">CPId</th>
                            <th>Speed</th>
                            <th>LADEN</th>
                            <th>BALLAST</th>
                            <th>VLSFO</th>
                            <th>MDO</th>
                           


                        </tr>

                    </thead>
                    <tbody>

                        @foreach (var item in Model.MainCONSUMPTION)
                        {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.CPId)</td>
                                @*<td> @Html.DisplayFor(modelItem => item.VesselID)</td>*@
                                <td> @Html.DisplayFor(modelItem => item.Speed)</td>
                                <td> @Html.DisplayFor(modelItem => item.ME_LADEN)</td>
                                <td> @Html.DisplayFor(modelItem => item.ME_BALLAST)</td>
                                <td> @Html.DisplayFor(modelItem => item.AE_VLSFO)</td>
                                <td> @Html.DisplayFor(modelItem => item.AE_DO)</td>

                             


                            </tr>
                        }


                    </tbody>
                </table>
            </div>


            <div class="table-responsive">
                <h3 class="card-title">Charter Party Other Consumption</h3>
               
                <table class="table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th style="display:none">CPId</th>
                            <th>Other Consumption</th>
                            <th>VLSFO</th>
                            <th>MDO</th>
                            <th>BOILER_MDO</th>
                          

                        </tr>

                    </thead>
                    <tbody>

                        @foreach (var item in Model.OtherCONSUMPTION)
                        {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.CPId)</td>
                                <td> @Html.DisplayFor(modelItem => item.Consumption)</td>
                                <td> @Html.DisplayFor(modelItem => item.AE_VLSFO)</td>
                                <td> @Html.DisplayFor(modelItem => item.AE_MDO)</td>
                                <td> @Html.DisplayFor(modelItem => item.BOILER_MDO)</td>
                             

                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>


    </div>
</div>

