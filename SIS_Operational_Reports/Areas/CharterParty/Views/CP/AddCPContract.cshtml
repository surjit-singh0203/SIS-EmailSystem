@using DataBuildingLayer;
@model CharterPartyClass

@{
    ViewBag.Title = "AddCPContract";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


@using (Html.BeginForm("AddCPContract", "CP"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
  // @Html.HiddenFor(e => e.CPNo)


    <div class="row">
        <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div>

                <h2>
                    @{
                        var idcheck = Model.Id.ToString();
                        var addEdit = "";
                        if (idcheck == "0")
                        {
                            addEdit = "Add";
                        }
                        else
                        {
                            addEdit = "Edit";
                        }
                    }


                    @addEdit Charter Party
                </h2>
                @*<ol class="breadcrumb">
                        <li><a href="">Home</a></li>
                        <li><a href="">Form</a></li>
                        <li><a>Create</a></li>
                    </ol>*@
            </div>
            <div class="col-md button-row-top">

                @*<button name="Submit" type="submit" class="btn btn-success btn-width" onclick="this.form.submit();this.disabled = true; this.value = 'Submit...';"><i class="uil uil-check mr-2"></i>Submit</button>*@
                <button name="Submit" type="submit" class="btn btn-success btn-width"><i class="uil uil-check mr-2"></i>Submit</button>
                <button name="Reset" onClick="window.location.reload();" type="reset" id="btnReset" class="btn btn-danger btn-width"><i class="uil uil-redo mr-2"></i>Reset</button>
                <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> << Go Back</a>
            </div>
        </div>
    </div>


    <div id="page-wrapper" class="content">
        <div class="wrapper wrapper-content">
            <div class="container">
                <div class="form-body">
                    <div class="row">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-md-8 mx-auto">
                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">Charter Party ID<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.CPNo, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control", @maxlength = 50, @required = "true", } })
                                    <div class="error"></div>
                                </div>
                            </div>

                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">Charter Party Name<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.CPName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control", @maxlength = 100, @required = "true", } })
                                    <div class="error"></div>
                                </div>
                            </div>

                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">Start Date<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @* @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @type = "date", @onkeydown = "return false", @required = "true" })*@
                                    @*@Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @autocomplete = "off", @required = "true", @class = "form-control", @type = "date" } })*@
                                    @*@Html.EditorFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @Type = "Date", @maxlength = 20, @required = "true", @readonly = true, @placeholder = "yyyy-mm-dd" } })*@

                                    <input type="date" class="form-control" id="StartDate" name="StartDate"
                                           value="@Model.strtdt"
                                          >
                                    @*<input class="form-control"  data-val="true" data-val-date="The field InitialDate must be a date." id="StartDate" name="StartDate" type="date" bind="@Model.StartDate" bind:format="yyyy-MM-dd" value="3/30/2015">*@

                                    <span id="messageImo"></span>
                                </div>
                            </div>
                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">End Date<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">
                                    @*@Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @type = "date", @onkeydown = "return false", @required = "true" })*@

                                    @*@Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @autocomplete = "off", @required = "true", @class = "form-control", @type = "date" } })*@

                                    <input type="date" id="EndDate" class="form-control" name="EndDate"
                                           value="@Model.enddt">

                                    <span id="messageImo"></span>
                                </div>
                            </div>
                            <div class="row form-group ">
                                <label class="col-sm-4 col-form-label">
                                    <label class="control-label">Voyage Type<sup>*</sup></label>
                                </label>
                                <div class="col-sm-8">

                                    @Html.DropDownListFor(model => model.VoyageType, new SelectList(Model.VoyageTypeList, "Value", "Text"), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })
                                    <div class="error"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

<script>
    var ID = '@Model.Id'
    if (ID == 0) {
       // $('#CPNo').removeProp('disabled');
    } else {
        $("#CPNo").attr("readonly", "readonly");
        //$('#CPNo').prop('disabled', 'disabled');
    }

    @*var dt = '@Model.strtdt';


    alert(dt);*@
</script>
<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').addClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').removeClass('active');


</script>

<script>

</script>
<script>
    function goBack() {
        window.history.back();
    }
</script>

<script type="text/javascript">
    $("#EndDate").change(function () {
        var startDate = document.getElementById("StartDate").value;
        var endDate = document.getElementById("EndDate").value;

        if ((Date.parse(startDate) > Date.parse(endDate))) {
            alert("End date should be greater than Start date");
            document.getElementById("EndDate").value = "";
        }
    });


    $("#StartDate").change(function () {
        var startDate = document.getElementById("StartDate").value;
        var endDate = document.getElementById("EndDate").value;

        if ((Date.parse(startDate) > Date.parse(endDate))) {
            alert("End date should be greater than Start date");
            document.getElementById("StartDate").value = "";
        }
    });
</script>