    <script>
        // 2nd Grid
        $("body").on("click", "#btnAdd2", function () {
            //Reference the Name and Country TextBoxes.
            var txtSpeed = $("#txtSpeed");
            var txtME_LADEN = $("#txtME_LADEN");
            var txtME_BALLAST = $("#txtME_BALLAST");
            var txtAE_VLSFO = $("#txtAE_VLSFO");
            var txtAE_DO = $("#txtAE_DO");

            //alert(txtSpeed.val());

            if (txtSpeed.val() == "") {
                alert("Please Enter Speed");
                return;
            }
            if (txtME_LADEN.val() == "") {
                alert("Please Enter Laden");
                return;
            }
            if (txtME_BALLAST.val() == "") {
                alert("Please Enter Ballast");
                return;
            }
            if (txtAE_VLSFO.val() == "") {
                alert("Please Enter VLSFO");
                return;
            }
            if (txtAE_DO.val() == "") {
                alert("Please Enter DO");
                return;
            }


            //Get the reference of the Table's TBODY element.
            var tBody2 = $("#tblMainCONSUMPTION > TBODY")[0];

            //Add Row.
            var row2 = tBody2.insertRow(-1);

            //Add Speed cell.
            var cell2 = $(row2.insertCell(-1));
            cell2.html(txtSpeed.val());

            //Add ME_LADEN cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtME_LADEN.val());

            //Add ME_BALLAST cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtME_BALLAST.val());

            //Add AE_VLSFO cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtAE_VLSFO.val());

            //Add AE_DO cell.
            cell2 = $(row2.insertCell(-1));
            cell2.html(txtAE_DO.val());

            //Add Button cell.
            cell2 = $(row2.insertCell(-1));
            var btnRemove = $("<input />");
            btnRemove.attr("id", "button2");
            btnRemove.attr("type", "button");
            btnRemove.attr("onclick", "Remove2(this);");
            btnRemove.val("Remove");
            cell2.append(btnRemove);

            //Clear the TextBoxes.
            txtSpeed.val("");
            txtME_LADEN.val("");
            txtME_BALLAST.val("");
            txtAE_VLSFO.val("");
            txtAE_DO.val("");
        });

        function Remove2(button) {
            //Determine the reference of the Row using the Button.
            var row2 = $(button).closest("TR");
            var name = $("TD", row2).eq(0).html();
            if (confirm("Do you want to delete: " + name)) {
                //Get the reference of the Table.
                var table2 = $("#tblMainCONSUMPTION")[0];

                //Delete the Table row using it's Index.
                table2.deleteRow(row2[0].rowIndex);
            }
        };



    </script>

    <script type="text/javascript">
        function requiredValue(arg) {
            debugger;
            var id = arg.getAttribute('id');
            var value = arg.value;

            var dec = document.getElementById(id).value;
            if (dec.includes(".")) {
                var res = dec.substring(dec.indexOf(".") + 2);
                var kl = res.split("");
                if (kl.length > 2) {
                    document.getElementById(id).value = (parseInt(dec * 100) /
                        100).toFixed(3);
                }
            }
            if (value > 999.99) {

                $("#" + id + "").val('');
            }

        }
    </script>

    <script type="text/javascript">
        function requiredValue1(arg) {


            var id = arg.getAttribute('id');
            var value = arg.value;

            var dec = document.getElementById(id).value;
            if (dec.includes(".")) {
                var res = dec.substring(dec.indexOf(".") + 2);
                var kl = res.split("");
                if (kl.length > 1) {
                    document.getElementById(id).value = (parseInt(dec * 100) /
                        100).toFixed(1);
                }
            }
            if (value > 99.99) {

                $("#" + id + "").val('');
            }

        }
    </script>

    <script type="text/javascript">
        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode;
            if (charCode != 46 && charCode > 31
                && (charCode < 48 || charCode > 57))
                return false;

            return true;
        }
    </script>
