@model DataBuildingLayer.CargoGradeClass
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}




<div id="iduser">




    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
        <div class="col-md">
            <h2>
                Cargo Grade Management
            </h2>

        </div>
        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
        @if (StaticHelper.UserRole == "Administrator")
        {
            <div class="col-md button-row-top">
               
                <a class="btn btn-info m-1" href="@Url.Action("AddCargoGrade", "Port")"> Add Cargo Grades </a>

            </div>
        }
    </div>


 



    <div class="wrapper wrapper-content">
        <div class="container">

            

            <div class="table-responsive">



                <table class="GeneratedTable centered-table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>

                            <th>Sr.No.</th>

                            <th>Cargo Grade Name</th>

                            @if (StaticHelper.UserRole == "Administrator")
                            {

                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{

                            int count = 1;
                        }


                        @foreach (var item in Model.GetCargoGradeList)
                        {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>


                                

                                <td> @count</td>

                               
                                <td> @Html.DisplayFor(modelItem => item.Cargo)</td>

                                @if (StaticHelper.UserRole == "Administrator")
                                {

                                    <td>

                                        <div class="row button-row">
                                            <div class="col table-button-container">
                                                <button type="button" class="function-button table-button">
                                                    <a href="@Url.Action("EditCargo", "Port", new { id = item.Id })" class="function-button table-button">
                                                        Edit
                                                    </a>
                                                </button>
                                            </div>

                                            <div class="col table-button-container">
                                                <button type="button" class="function-button table-button">
                                                    @Html.ActionLink("Delete", "DeleteCargo", "Port", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                                </button>
                                            </div>
                                        </div>


                                    </td>
                                }
                            </tr>
                            count++;
                        }


                    </tbody>
                </table>

                @{
                    var recCnt = "";
                    if (Model.GetCargoGradeList.Count == 0)
                    {
                        recCnt = "No Record Found !";
                    }
                }
                <p style="font-weight:bold; color:red"> @recCnt </p>

                <nav aria-label="Page navigation example">
                    <ul class="pagination">


                        @{
                            int totalRecords = 0;
                            foreach (var item in Model.GetCargoGradeList)
                            {
                                totalRecords = item.TotalCount;
                                break;
                            }
                            //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                            // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                            //int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                            int pageSize = 20;

                            int tot_pages = totalRecords / pageSize;
                            int remainder = totalRecords % pageSize;

                            tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                            int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                            if (totalRecords > 0)
                            {
                                if (currPage == 0)
                                {
                                    currPage = 1;
                                }

                                if (currPage != 1)
                                {
                                    <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "cargogradeList", "Port", new { pageNo = 1 }, null)</a></li>
                                }

                                if (currPage != tot_pages)
                                {
                                    for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                    {
                                        if (cnt == currPage)
                                        {
                                            <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item">@Html.ActionLink(cnt.ToString(), "cargogradeList", "Port", new { pageNo = cnt }, null)</li>
                                        }

                                        if (cnt == tot_pages)
                                        {
                                            break;
                                        }
                                    }
                                }


                                if (currPage == tot_pages)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                                }
                                else
                                {
                                    <li class="page-item">@Html.ActionLink("Last", "cargogradeList", "Port", new { pageNo = tot_pages }, null)</li>
                                }
                            }
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>





