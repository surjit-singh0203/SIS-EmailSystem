@model DataBuildingLayer.CargoGradeClass
@{
    ViewBag.Title = "AddPort";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



@using (Html.BeginForm("AddCargoGrade", "Port", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
    <div class="row" style="border-bottom: solid 1px #676969; padding: 10px 0; margin-bottom: 20px;">
        <div class="col-md">
            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit Cargo Grades





            </h2>
        </div>


        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
        <div class="col-md button-row-top">
            <button name="Submit" type="submit" class="btn btn-success btn-width">Submit</button>
            <button name="Reset" onClick="window.location.reload();" type="reset" id="btnReset" class="btn btn-danger btn-width">Reset</button>

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> << Go Back</a>
        </div>
    </div>


    <div class="wrapper wrapper-content">
        <div class="container">

            <div class="form-body">
                <div class="row">
                    <div class="col-md-8 mx-auto">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })



                        <div class="row form-group ">
                            <label class="col-sm-4 col-form-label">
                                <label class="control-label">Cargo Grade Name<sup>*</sup></label>
                            </label>
                            <div class="col-sm-8">
                                @Html.EditorFor(model => model.Cargo, new { htmlAttributes = new {  @class = "form-control", @required = "true", @maxlength = 50 } })

                                <span id="messageDia"></span>
                            </div>
                        </div>

                       

                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        $('#Menu1').addClass('active');
        $('#Menu2').removeClass('active');
        $('#Menu3').removeClass('active');
        $('#Menu4').removeClass('active');
        $('#Menu5').removeClass('active');
    </script>
    <script>
        function goBack() {
            window.history.back();
        }
    </script>


    <script type="text/javascript">

        setTimeout(function () {

            $('#successMessage').fadeOut('fast');
            $('#errorMessage').fadeOut('fast');
        }, 3000);


    </script>

