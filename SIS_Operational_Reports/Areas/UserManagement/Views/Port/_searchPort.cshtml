
@model DataBuildingLayer.PortListClass


<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
<link rel="stylesheet" href="~/Content/userPage-multiselect.css" type="text/css" />

<style type="text/css">
    .multiselect-container > li > a > label.checkbox {
        width: 250px;
    }

    .dropdown-menu-custom-settings {
        top: 0% !important;
        left: 230px !important;
        width: 100% !important;
        background-color: #0f3976;
    }

    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark {
        border-radius: 0;
        padding: 8px 0;
    }


    .collapse.navbar-collapse {
        display: flex !important;
        justify-content: flex-end;
    }

    .navbar-brand {
        margin-right: 4px;
        text-decoration: none;
        white-space: nowrap;
        padding: 5px 12px;
    }

    label {
        font-weight: 400;
    }

    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark {
        margin-bottom: 0;
    }

    .h1, .h2, .h3, h1, h2, h3 {
        margin: 0;
    }
</style>
<div id="iduser">

    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
        <div class="col-md">
            <h2>
                Port Management
            </h2>

        </div>
        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
        @if (StaticHelper.UserRole == "Administrator")
        {
            <div class="col-md button-row-top">
                <button type="button" class="btn btn-info btn-lg" data-toggle="modal" data-target="#myModal">Export List</button>
                <a class="btn btn-info m-1" href="@Url.Action("AddPort", "Port")"> Add Port </a>

            </div>
        }
    </div>


    <div class="wrapper wrapper-content">
        <div class="container">

            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" autocomplete="off" placeholder="search by : port name & country name" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div style="display:none" class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <div class="table-responsive">



                <table class="GeneratedTable centered-table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th>Country Name</th>
                            <th>Port Name</th>

                            <th>Facility Name</th>


                            <th>Longitude</th>
                            <th>Latitude</th>
                            @if (StaticHelper.UserRole == "Administrator")
                            {

                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>



                        @foreach (var item in Model.GetPortList)
                        {


                        <tr>
                            <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>

                            <td> @Html.DisplayFor(modelItem => item.CountryName)</td>
                            <td> @Html.DisplayFor(modelItem => item.PortName)</td>
                            <td> @Html.DisplayFor(modelItem => item.FacilityName)</td>
                            <td> @Html.DisplayFor(modelItem => item.Longitude) </td>
                            <td> @Html.DisplayFor(modelItem => item.Latitude) </td>

                            @if (StaticHelper.UserRole == "Administrator")
                            {

                                <td>

                                    <div class="row button-row">
                                        <div class="col table-button-container">
                                            <button type="button" class="function-button table-button">
                                                <a href="@Url.Action("Edit", "Port", new { id = item.Id })" class="function-button table-button">
                                                    Edit
                                                </a>
                                            </button>
                                        </div>

                                        <div class="col table-button-container">
                                            <button type="button" class="function-button table-button">
                                                @Html.ActionLink("Delete", "Delete", "Port", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                            </button>
                                        </div>
                                    </div>


                                </td>
                            }
                        </tr>
                        }


                    </tbody>
                </table>

                @{
                    var recCnt = "";
                    if (Model.GetPortList.Count == 0)
                    {
                        recCnt = "No Record Found !";
                    }
                }
                <p style="font-weight:bold; color:red"> @recCnt </p>

            </div>
        </div>
    </div>
</div>
<script>

    $('#Menu1').addClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').removeClass('active');


</script>

<script type="text/javascript" src="~/Content/userPage_multiselect.js"></script>
<script>

    $('#PortIDs').multiselect({
        includeSelectAllOption: true,
        enableCaseInsensitiveFiltering: true,
        maxHeight: 350,
        numberDisplayed: 1,
        onSelectAll: function () {
        }
    });
</script>


<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>




<script>

    $("#btnSearch").click(function () {

        var firstVal = $("#idFirst").val();


        if (firstVal == "") {
            alert("Please enter port name for search.");
            return;
        }
        else {


            $.ajax({
                type: 'GET',
                url: '/UserManagement/Port/index?pageNo=1&firstVal=' + firstVal,
                datatype: 'json',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                processData: false,
                success: function (data) {

                    // alert(data);
                    /* if (response.Result === true) {*/

                    //window.location.reload();

                    $("#iduser").html('');
                    $("#iduser").html(data);


                    //;

                    // $("#idMaindiv").html('');

                    //$("#idMaindiv").html(data);
                    // alert(data);
                    //}
                    //else {
                    //    toastr["error"](response.Message);
                    //}
                },
                //failure: function (response) {
                //    toastr["error"](response.Message);
                //}
            });

        }



    });

</script>