        function GetRanks(t) {
            debugger;
            var Id = t.value;
            var portName = $("#DepId option:selected").val();
            //alert(portName);


            $.ajax({
                type: 'GET',
                url: '/UserManagement/User/GetRanks?Did=' + portName,
                cache: false,
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.Result === true) {
                        $('#UserName').empty();
                        //alert(433);
                        debugger;
                        $('#UserName').append('<option value="">None Selected</option>');
                        for (var i = 0; i < response.Data.length; i++) {
                            debugger;
                            var txt = response.Data[i].Text;
                            var valu = response.Data[i].Value;
                            // alert(txt);
                            $('#UserName').append('<option value="' + valu + '">' + txt + '</option>');

                        }
                        // $('#RankId').append('<option value="">Other</option>');

                    }
                    else {
                        toastr["error"](response.Message);
                    }
                },
                failure: function (response) {
                    toastr["error"](response.Message);
                }
            });

