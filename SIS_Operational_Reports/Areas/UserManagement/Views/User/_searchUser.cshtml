
@model DataBuildingLayer.UserDetail


<div id="iduser">

    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
        <div class="col-md">
            <h2>
                User Management
            </h2>
            @*<ol class="breadcrumb">
                <li><a href="">Home</a></li>
                <li><a href="">Form</a></li>
                <li><a>Create</a></li>
            </ol>*@
        </div>
        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
        @if (StaticHelper.UserRole == "Administrator")
        {
            <div class="col-md button-row-top">
                <a class="btn btn-info m-1" href="@Url.Action("AddUser", "User")"> Add User </a>

            </div>
        }
        </div>


    <div class="wrapper wrapper-content">
        <div class="container">

            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" autocomplete="off" placeholder="search by : user email" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div style="display:none" class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <div class="table-responsive">

                @*<div class="mb-lg-1 row">
            <div style="margin-left:550px" class="col-sm-3">

                <input id="idFirst" class="form-control" type="text" />
                <span id="messageLat" style="color:red"></span>
            </div>

            <div class="col-sm-3">

                <input id="idSecond" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text" />
                <span id="messageLat" style="color:red"></span>
            </div>


            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">
                        <button id="btnSearch" class="function-button submit-button">

                            <i class="fa fa-plus-circle mr-2"></i>Search

                        </button>
                    </div>

                </div>
            </div>

        </div>*@

                <table class="GeneratedTable centered-table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            @*<th>Assign Vessel</th>*@
                            @*<th>User Name</th>*@
                            <th>User Email</th>

                            <th>User Role</th>

                            @*<th>User Type</th>*@
                            <th>Assign Vessel</th>

                            @if (StaticHelper.UserRole == "Administrator")
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>



                        @foreach (var item in Model.GetUserList)
                        {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                @*<td>
                            @Html.DisplayFor(modelItem => item.VesselName)
                        </td>*@
                                @*<td> @Html.DisplayFor(modelItem => item.UserName)</td>*@
                                <td> @Html.DisplayFor(modelItem => item.UserEmail)</td>


                                <td> @Html.DisplayFor(modelItem => item.DeptName)</td>




                                @*<td>
                                    @Html.DisplayFor(modelItem => item.UserType)
                                </td>*@

                                <td>
                                    @Html.DisplayFor(modelItem => item.AssignVessel)
                                </td>
                                @if (StaticHelper.UserRole == "Administrator")
                                {
                                    <td>

                                        <div class="row button-row">
                                            <div class="col table-button-container">
                                                <button type="button" class="function-button table-button">
                                                    <a href="@Url.Action("Edit", "User", new { id = item.Id })" class="function-button table-button">
                                                        Edit
                                                    </a>
                                                </button>
                                            </div>

                                            <div class="col table-button-container">
                                                <button type="button" class="function-button table-button">
                                                    @Html.ActionLink("Delete", "Delete", "User", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                                </button>
                                            </div>
                                        </div>


                                    </td>
                                }
                            </tr>
                        }


                    </tbody>
                </table>

                @{
                    var recCnt = "";
                    if (Model.GetUserList.Count == 0)
                    {
                        recCnt = "No Record Found !";
                    }
                }
                <p style="font-weight:bold; color:red"> @recCnt </p>
                <nav aria-label="Page navigation example">
                    <ul class="pagination">


                        @{
                            int totalRecords = 0;
                            foreach (var item in Model.GetUserList)
                            {
                                totalRecords = item.TotalCount;
                                break;
                            }
                            //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                            // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                            int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                            int tot_pages = totalRecords / pageSize;
                            int remainder = totalRecords % pageSize;

                            tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                            int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                            if (totalRecords > 0)
                            {
                                if (currPage == 0)
                                {
                                    currPage = 1;
                                }

                                if (currPage != 1)
                                {
                                    <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "index", "User", new { pageNo = 1 }, null)</a></li>
                                }

                                if (currPage != tot_pages)
                                {
                                    for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                    {
                                        if (cnt == currPage)
                                        {
                                            <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item">@Html.ActionLink(cnt.ToString(), "index", "User", new { pageNo = cnt }, null)</li>
                                        }

                                        if (cnt == tot_pages)
                                        {
                                            break;
                                        }
                                    }
                                }


                                if (currPage == tot_pages)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                                }
                                else
                                {
                                    <li class="page-item">@Html.ActionLink("Last", "index", "User", new { pageNo = tot_pages }, null)</li>
                                }
                            }
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
<script>

    $('#Menu1').addClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').removeClass('active');


</script>

<script type="text/javascript">
    $(function () {

        $('input[name="datefilter"]').daterangepicker({
            autoUpdateInput: false,
            locale: {
                cancelLabel: 'Clear'
            }
        });

        $('input[name="datefilter"]').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('YYYY/MM/DD') + ' - ' + picker.endDate.format('YYYY/MM/DD'));
        });

        $('input[name="datefilter"]').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });

    });
</script>

