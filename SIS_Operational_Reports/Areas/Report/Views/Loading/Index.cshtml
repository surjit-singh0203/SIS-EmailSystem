@model DataBuildingLayer.LoadingReport
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@*<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">*@

<link href="~/css/flatpickr.min.css" rel="stylesheet" />
<script src="~/css/flatpickr.js"></script>
@*<link href="~/css/all.min.css" rel="stylesheet" />*@

<style>

    .datetime-wrapper {
        position: relative;
        display: inline-block;
    }

    .datetime-wrapper2 {
        position: relative;
        /*display: inline-block;*/
    }

    .datetime-icon {
        position: absolute;
        right: 30px;
        top: 35%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .datetime-icon1 {
        position: absolute;
        right: 5px;
        top: 45%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .fa, .fas {
        font-weight: 100 !important;
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #676969 !important;
    }

    .nav-link {
        color: #676969;
        border: solid 1px #676969 !important;
        margin: 5px;
    }

        .nav-link:hover {
            background-color: #676969 !important;
            color: white !important;
        }

    .tab-content {
        margin: 5px !important;
        box-shadow: 0px 16px 40px 0px #00000026 !important;
        width: 100% !important;
        padding: 10px;
    }

    .nav-link.active {
        font-weight: normal;
    }

    .tab-content .row .col-md .GeneratedTable {
        margin: 15px 4.8px;
    }

    /* Hide the internal Id columns in the Cargo and Stoppage tables — the JS still
       relies on those cells being present (it reads column indices), so we hide them
       visually with display:none instead of removing the markup. Without this rule
       the tables show an unwanted "id" / "Id" column with raw PK values like 1028. */
    #tblCargo thead th:first-child,
    #tblCargo tbody td:first-child,
    #tblCargo tfoot td:first-child,
    #tblStoppage thead th:first-child,
    #tblStoppage tbody td:first-child,
    #tblStoppage tfoot td:first-child {
        display: none;
    }

    /* Force the cargo table to fit the container width and wrap long header text
       onto multiple lines, matching the production layout. Without table-layout:fixed
       each column expands to fit its header on one line and the table overflows the
       viewport, producing a wide horizontal scrollbar. */
    #tblCargo {
        table-layout: fixed;
        width: 100%;
    }

    #tblCargo th,
    #tblCargo td {
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
    }
</style>

<style>

    #cover-spin {
        position: fixed;
        width: 100%;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.7);
        z-index: 9999;
        display: none;
    }

    @@-webkit-keyframes spin {
        from {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    #cover-spin::after {
        content: '';
        display: block;
        position: absolute;
        left: 48%;
        top: 40%;
        width: 40px;
        height: 40px;
        border-style: solid;
        border-color: black;
        border-top-color: transparent;
        border-width: 4px;
        border-radius: 50%;
        -webkit-animation: spin .8s linear infinite;
        animation: spin .8s linear infinite;
    }
	input.datetimePickerEdit.flatpickr-input {
    border: none!important;
}
td.datetime-wrapper {
    width: 100%;
}
select {
   
    width: 100%!important;
}
</style>
<div id="cover-spin"></div>
<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>


            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var vslname = Model.VesselName;
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                Loading Report (@vslname)
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>

