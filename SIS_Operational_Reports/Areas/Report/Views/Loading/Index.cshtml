<script type="text/javascript">


    $(".check-number").on("keypress", function (event) {

        var charCode = (event.which) ? event.which : event.keyCode;
        var value = $(this).val();

        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }

        var finalValue = value + String.fromCharCode(charCode);

        if (finalValue.length > 7) {
            return false;
        }

        return true;
    });

</script>

