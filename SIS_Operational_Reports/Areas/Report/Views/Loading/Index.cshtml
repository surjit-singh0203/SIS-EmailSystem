<script>


    function GetLRCargoEdit(id) {

        $.ajax({
            type: 'GET',
            /*  url: '/Report/DailyNoon/Getfuelcons?VoyId=' + VoyId,*/
            url: '/Report/Loading/GetLRCargoEdit?LoadingReportId=' + id,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    var LRCargoList = response.lrc;
                    var CountCargo = response.cntlrc;

                    //alert(FtypeList);

                    debugger;
                    var rowCount = CountCargo;
                    let len = rowCount;
                    for (let i = 1; i <= len; i++) {

                     EditCountCargo();


                    }

                    debugger;

                    var count = 0; var ss = ""; var ss1 = "";
                    var table = document.getElementById('tblCargo');
                    var loginUser = '@StaticHelper.LoginUser';
                   // alert(loginUser);

                    var j = 1; var k = 0;
                    $.each(LRCargoList, function (index, value) {
                        ss1 = value;
                        debugger;

                        if (k == 0) {
                           // table.rows[j].cells[k].children[0].value = ss1;

                            table.rows[j].cells[k].innerHTML = ss1;

                              /*  table.rows[j].cells[k].setAttribute("contenteditable", true);*/
                            k++;
                        }

                        else if (k == 1) {

                            table.rows[j].cells[k].setAttribute('style', 'disabled: false;');

                            var x = table.rows[j].cells[k].appendChild(document.createElement("INPUT"));
                            x.classList.add("datetimePickerEdit");

                            var calendarIcon = document.createElement("SPAN");
                            calendarIcon.innerHTML = "📅";
                            calendarIcon.style.cursor = "pointer";
                            table.rows[j].cells[k].appendChild(calendarIcon);

                            var savedDateValue = '';

                            if (ss1 != null) {
                                var now = new Date(ss1);
                                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                                x.value = now.toISOString().slice(0, 16);
                                var DT = x.value;
                                x.value = DT.replace('T', ' ');
                                savedDateValue = x.value;
                            }

                            flatpickr(x, {
                                enableTime: true,
                                dateFormat: "Y-m-d H:i",
                                time_24hr: true,
                                clickOpens: false,
