@model DataBuildingLayer.LoadingReport
@{
    ViewBag.Title = "Index";
    int Id = Model.Id;
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}

@*<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">*@

<link href="~/css/flatpickr.min.css" rel="stylesheet" />
<script src="~/css/flatpickr.js"></script>

<style>

    td.datetime-wrapper {
        border: none !important;
    }

        td.datetime-wrapper .datetime-icon {
            margin-right: -51px !important;
            top: 15px;
        }

    input.datetimePickerEdit.flatpickr-input {
        border: none !important;
    }

    .datetime-wrapper2 {
        position: relative;
        /*display: inline-block;*/
    }

    .datetime-wrapper {
        position: relative;
        display: inline-block;
    }

    .datetime-icon {
        position: absolute;
        right: 30px;
        top: 35%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .datetime-icon1 {
        position: absolute;
        right: 5px;
        top: 45%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .fa, .fas {
        font-weight: 100 !important;
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #676969 !important;
    }

    .nav-link {
        color: #676969;
        border: solid 1px #676969 !important;
        margin: 5px;
    }

        .nav-link:hover {
            background-color: #676969 !important;
            color: white !important;
        }

    .tab-content {
        margin: 5px !important;
        box-shadow: 0px 16px 40px 0px #00000026 !important;
        width: 100% !important;
        padding: 10px;
    }

    .nav-link.active {
        font-weight: normal;
    }

    .tab-content .row .col-md .GeneratedTable {
        margin: 15px 4.8px;
    }

    .col-form-label {
        padding: 0px !important;
        padding-top: 10px !important;
    }

    textarea#Remarks {
        border: none;
    }

    td.datetime-wrapper {
        width: 100% !important;
    }

        td.datetime-wrapper .datetime-icon {
            margin-right: 0px !important;
            top: 15px;
        }

    .datetime-icon {
        top: 42% !important;
    }
</style>

<style>

    #cover-spin {
        position: fixed;
        width: 100%;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        background-color: rgba(255,255,255,0.7);
        z-index: 9999;
        display: none;
    }

    @@-webkit-keyframes spin {
        from {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    #cover-spin::after {
        content: '';
        display: block;
        position: absolute;
        left: 48%;
        top: 40%;
        width: 40px;
        height: 40px;
        border-style: solid;
        border-color: black;
        border-top-color: transparent;
        border-width: 4px;
        border-radius: 50%;
        -webkit-animation: spin .8s linear infinite;
        animation: spin .8s linear infinite;
    }

    div#divIDheader input {
        /* border: 1px solid #aaaaaa !important;*/
        border-radius: 3px;
    }

    .col-form-label {
        padding: 0px !important;
        padding-top: 0px !important;
        margin-bottom: 0px !important;
    }

    input#btnAddStoppage {
        width: 100% !important;
    }

    table#tblStoppage td {
        padding-left: 0px !important;
    }

    table.GeneratedTable td {
        border-width: 1px;
        border-color: #676969;
        border-style: solid;
        padding-left: 8px !important;
    }

    span.datetime-icon {
        margin-right: 0px !important;
    }

    input#btnAdd {
        padding: 6px 23px !important;
    }

    input#StopRe {
        width: 100%;
    }

    div#divIDheader .col-sm-8.datetime-wrapper {
        border: 1px solid #aaa !important;
        border-radius: 3px;
        height: 34px;
        /* margin-left: -1px; */
        width: 63%;
    }

    .col-form-label {
        padding: 0px !important;
        padding-top: 0px !important;
        margin-bottom: 0px !important;
    }


    div#divIDheader .col-sm-8.datetime-wrapper {
        padding: 0px !important;
    }
</style>


<div id="cover-spin"></div>
<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>


            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit Loading Report
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>

@Html.HiddenFor(e => e.Id)
<div id="divIDheader" class="row" style="margin-top: 10px;">


    <div class="col-md">

        <div class="mb-3 row">

            @if (Id == 0)
            {
                <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @onchange = "GetLeg(this)", @required = "true", })
                    <span id="messageVoyid" style="color:red"></span>
                </div>
            }
            else
            {

                <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @onchange = "GetLeg(this)", @required = "true", @disabled = "disabled" })
                    <span id="messageVoyid" style="color:red"></span>
                </div>

            }

            <label for="inputPassword" class="col-sm-4 col-form-label mt-3">ETD Date & Time</label>
            <div class="col-sm-8 datetime-wrapper mt-3">
                @*<input type="datetime-local" class="form-control bottom-border-input" placeholder="Select">*@
                @*@Html.EditorFor(model => model.ETDDateTime, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 20, @required = "true", @readonly = true, @placeholder = "yyyy-mm-dd" } })*@
                @* @Html.EditorFor(model => model.ETDDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local" } })*@
                @if (Model.Id != 0)
                {
                    @Html.EditorFor(model => model.ETDDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerEdit", } })
                    @*<i class="fas fa-calendar-alt datetime-icon"></i>*@
                    <span class="datetime-icon" style="font-size: 15px; margin-right:-10px">&#128197;</span>
                }
                else
                {
                    @Html.EditorFor(model => model.ETDDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePicker", @placeholder = "yyyy-mm-dd  _ : _ : _", } })
                    @*<i class="fas fa-calendar-alt datetime-icon"></i>*@
                    <span class="datetime-icon" style="font-size: 15px; margin-right:-10px">&#128197;</span>
                }
                <span id="msgETDDateTime" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Leg</label>
            <div class="col-sm-8">

                @Html.DropDownListFor(model => model.LegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", @onchange = "bindport(this)", })
                <span id="msgLegPortId" style="color:red"></span>

            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Port</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.PortName, new SelectList(Model.PortList, "Id", "Port"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })
                <span id="msgPortName" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">

        @if (Id == 0)
        {
            <div class="mb-3 row">

                <label for="inputPassword" class="col-sm-4 col-form-label">Report Date & Time</label>
                <div class="col-sm-8 datetime-wrapper">
                    @* @{
                            var currentDate = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss");
                        }
                        @Html.EditorFor(model => model.ReportDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local", @max = currentDate } })*@
                    @Html.EditorFor(model => model.ReportDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerT", @placeholder = "YYYY-MM-DD  -- : -- : --", } })
                    @*<i class="fas fa-calendar-alt datetime-icon"></i>*@
                    <span class="datetime-icon" style="font-size: 15px; margin-right:-10px">&#128197;</span>
                    <span id="msgReportDateTime" style="color:red"></span>
                </div>

            </div>
        }
        else
        {
            <div class="mb-3 row">

                <label for="inputPassword" class="col-sm-4 col-form-label">Report Date & Time</label>
                <div class="col-sm-8 datetime-wrapper">
                    @* @Html.EditorFor(model => model.ReportDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local", @disabled = "disabled" } })*@
                    @Html.EditorFor(model => model.ReportDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerEdit", @disabled = "disabled" } })
                    @*<i class="fas fa-calendar-alt datetime-icon"></i>*@
                    <span class="datetime-icon" style="font-size: 15px; margin-right:-10px">&#128197;</span>
                    <span id="msgReportDateTime" style="color:red"></span>
                </div>

            </div>
        }


    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Fwd</label>
            <div class="col-sm-8">
                @*@Html.EditorFor(model => model.DraftFwd, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "number", @min = "0", @onKeyUp = "requiredValueDFT(this)", @maxlength = 5, @required = "true", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })*@
                @Html.EditorFor(model => model.DraftFwd, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @type = "number", @min = "0", @required = "true", @onKeyUp = "requiredValueDFT(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftFwd" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Mid</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftMid, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "number", @min = "0", @onKeyUp = "requiredValueDFT(this)", @maxlength = 5, @required = "true", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftMid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Aft</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftAft, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "number", @min = "0", @onKeyUp = "requiredValueDFT(this)", @maxlength = 5, @required = "true", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftAft" style="color:red"></span>
            </div>

        </div>

        <div class="col-md">

            <div class="row report-actions">
                <div class="col">
                    <button id="btnSave1" class="function-button submit-button">
                        Submit
                    </button>
                </div>
                <div id="SDraft" class="col">
                    <button onclick="SaveDraftFunction()" class="function-button draft-button">
                        Save Draft
                    </button>
                    <div hidden="hidden">
                        @Html.CheckBoxFor(model => model.SaveDraft)
                    </div>

                </div>
                @if (Model.SaveDraft != true)
                {
                    <div class="col">
                        <button onClick="window.location.reload();" class="function-button reset-button">
                            Reset
                        </button>
                    </div>
                }
            </div>

        </div>

    </div>

</div>



<div class="align-items-start">
    <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" style="width: 100%; display: flow-root;">
        <button class="nav-link active" id="v-pills-home-tab" data-bs-toggle="pill" data-bs-target="#v-pills-home"
                type="button" role="tab" aria-controls="v-pills-home" aria-selected="true" style="width:10%;float:left">
            Cargo-1
        </button>
        <button class="nav-link" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile"
                type="button" role="tab" aria-controls="v-pills-profile" aria-selected="false" style="width:10%;float:left">
            Cargo-2
        </button>

    </div>
    <div class="tab-content" id="v-pills-tabContent">

        <div class="tab-pane fade show active" id="v-pills-home" role="tabpanel" aria-labelledby="v-pills-home-tab">

            <div class="col-md">
                <div class="row">
                    <div class="col-xl">
                        <div class="row">

                            <table id="tblCargo" class="GeneratedTable" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th width="120px">Cargo Grades</th>
                                        <th width="210px">
                                            Commence Loading Date & Time
                                        </th>
                                        <th>
                                            Terminal Loading Rate (m3/hr)
                                        </th>
                                        <th>
                                            Loading Rate Accepted by Vessel (m3/hr)
                                        </th>
                                        <th> Average Achieved Loading Rate (m3/hr) </th>
                                        <th>No of Manifold / Hoses by Terminal</th>
                                        <th>Size of Manifold / Hoses by Terminal (Inches)</th>
                                        <th>No of Manifold / Hoses by Vessel</th>
                                        <th>Size of Manifold / Hoses by Vessel (Inches)</th>
                                        <th>Shore Line Distance (mtrs)</th>
                                        <th>Quantity onboard (MT)</th>
                                        <th>Balance Quantity to be Loaded (MT)</th>
                                        <th width="210px">ETC Comp Date & Time</th>
                                        <th width="210px">Actual Comp Date & Time</th>

                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var VLeg in Model.CargoLists)
                                    {
                                        <tr>
                                            @*<td>@VLeg.CargoName</td>*@
                                            <td>@VLeg.CargoName</td>
                                            <td>@VLeg.LoadingDatetime</td>
                                            <td>@VLeg.TerminalLoadingRate</td>
                                            <td>@VLeg.LoadingRateAccepted</td>
                                            <td>@VLeg.AverageAchievedLoadingRate</td>
                                            <td>@VLeg.No_Manifold_Hoses_by_Terminal</td>
                                            <td>@VLeg.Size_of_Manifold_Hoses_by_Terminal</td>
                                            <td>@VLeg.No_Manifold_Hoses_by_Vessel</td>
                                            <td>@VLeg.Size_of_Manifold_Hoses_by_Vessel</td>
                                            <td>@VLeg.ShoreLineDistance</td>
                                            <td>@VLeg.QuantityOnboard</td>
                                            <td>@VLeg.BalanceQuantityLoaded</td>
                                            <td>@VLeg.EstCompDateTime</td>
                                            <td>@VLeg.ActualCompDateTime</td>
                                            <td><input class="btn btn-info" type="button" value="Remove" onclick="Remove(this)" /></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>

                                        @*<td> @Html.EditorFor(model => model.CargoName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 30, @required = "true" } })</td>*@

                                        <td> @Html.DropDownListFor(model => model.CargoName, new SelectList(Model.CargoNameList, "Cargo", "Cargo"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>

                                        @* <td> @Html.EditorFor(model => model.LoadingDatetime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local" } })</td>*@
                                        <td class="datetime-wrapper2">@Html.EditorFor(model => model.LoadingDatetime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerEdit", @placeholder = "YYYY-MM-DD  _ : _ " } }) <span class="datetime-icon" style="font-size: 15px; margin-right:-20px">&#128197;</span></td>
                                        <td> @Html.EditorFor(model => model.TerminalLoadingRate,@*"{0:F3}",*@new { htmlAttributes = new { @autocomplete = "off", @min = "0", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>

                                        <td> @Html.EditorFor(model => model.LoadingRateAccepted, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.AverageAchievedLoadingRate, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.No_Manifold_Hoses_by_Terminal, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-number", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.Size_of_Manifold_Hoses_by_Terminal, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.No_Manifold_Hoses_by_Vessel, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-number", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.Size_of_Manifold_Hoses_by_Vessel, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.ShoreLineDistance, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @required = "true", @min = "0", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.QuantityOnboard, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @required = "true", @min = "0", @onKeyUp = "requiredValue8(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        <td> @Html.EditorFor(model => model.BalanceQuantityLoaded, "{0:F3}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input check-decimal", @maxlength = 7, @min = "0", @required = "true", @onKeyUp = "requiredValue8(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
                                        @*<td> @Html.EditorFor(model => model.ActualCompDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local" } })</td>*@
                                        <td class="datetime-wrapper2">@Html.EditorFor(model => model.EstCompDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerEdit", @placeholder = "YYYY-MM-DD  _ : _ " } }) <span class="datetime-icon" style="font-size: 15px; margin-right: -20px">&#128197;</span></td>
                                        <td class="datetime-wrapper2">@Html.EditorFor(model => model.ActualCompDateTime, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input datetimePickerEdit", @placeholder = "YYYY-MM-DD  _ : _ " } }) <span class="datetime-icon" style="font-size: 15px; margin-right:-20px">&#128197;</span></td>

                                        <td><input class="btn btn-info" type="button" id="btnAdd" value="Add" /></td>


                                    </tr>
                                </tfoot>
                            </table>

                        </div>

                    </div>

                </div>
            </div>

        </div>
        <div class="tab-pane fade" id="v-pills-profile" role="tabpanel" aria-labelledby="v-pills-profile-tab">
            <div class="row">
                <div class="col-md">
                    <div class="row">
                        <div class="col-xl">

                            <div class="row">
                                <!-- Speed - Distance - Time Table -->
                                <table class="GeneratedTable">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Letter of Protests</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @*<tr>
                                                <td>LOP Type</td>
                                                <td>Issued/ Recd</td>
                                            </tr>*@
                                        <tr>
                                            <td>Time</td>
                                            <td>
                                                @Html.DropDownListFor(model => model.Times, new SelectList(Model.LOPList, "Value", "Text"), "----Select----", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", })
                                                <span id="msgTimes" style="color:red"></span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Rate</td>
                                            <td>
                                                @Html.DropDownListFor(model => model.Rate, new SelectList(Model.LOPList, "Value", "Text"), "----Select----", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", })
                                                <span id="msgRate" style="color:red"></span>
                                            </td>
