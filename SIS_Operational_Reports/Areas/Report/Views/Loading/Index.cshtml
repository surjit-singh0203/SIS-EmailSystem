<script type="text/javascript">
    function charCount() {
        var textEntered = document.getElementById('Remarks').value;
        var msg = document.getElementById('remaining');
        var counter = (500 - (textEntered.length));
        if (counter == 0) {
            $('#remaining').css('color', 'red');
        }
        else {
            $('#remaining').css('color', 'gray');
        }
        msg.textContent = counter + "/500";
    }
    var el = document.getElementById('Remarks');
    el.addEventListener('keyup', charCount, false);
</script>


