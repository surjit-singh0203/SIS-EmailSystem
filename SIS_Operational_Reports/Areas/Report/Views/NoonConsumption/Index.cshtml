<script>

    $("#btnSearch").click(function () {



        var firstVal = $("#idFirst").val();
        var secondVal = $("#idSecond").val();
        var vsl = $("#VesselId").val();
        var cpid = $("#CPID").val();


        debugger;


        var dateF = $('#idSecond').data('daterangepicker').startDate.format('YYYY-MM-DD');
        var dateT = $('#idSecond').data('daterangepicker').endDate.format('YYYY-MM-DD');




        if (secondVal == "") {
            dateF = "";
            dateT = "";
        }

        if (firstVal == "" && secondVal == "" && vsl == "" && secondVal == "") {
            alert("Please enter atleast 1 value for search.");
            return;
        }
        //if (vsl == "") {
        //    alert("Please choose vessel first");
        //    return;
        //}
        else {



            $.ajax({
                type: 'GET',
                url: '/Report/NoonConsumption/Index?pageNo=1&firstVal=' + firstVal + '&dateF=' + dateF + '&dateT=' + dateT + '&Vessel=' + vsl + '&CPID=' + cpid,
                datatype: 'json',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                processData: false,
                success: function (data) {


                    $("#test").html('');
                    $("#test").html(data);



                },

            });

        }



    });

</script>
<script>
    function GetCP(t) {


        var Id = t.value;
        var Vslid = $("#VesselId option:selected").val();
        //alert(portName);



        $.ajax({
            type: 'GET',
            url: '/Report/NoonConsumption/BindCP?VesselId=' + Vslid,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    $('#CPID').empty();


                    // $('#cpid').val(response.CPID);
                    // alert(ddd);

                    debugger;
                    $('#CPID').append('<option value="">None Selected</option>');
                    for (var i = 0; i < response.Data.length; i++) {
                        debugger;
                        var txt = response.Data[i].Text;
                        var valu = response.Data[i].Value;
                        // alert(txt);
                        $('#CPID').append('<option value="' + valu + '">' + txt + '</option>');

                    }
                    // $('#RankId').append('<option value="">Other</option>');
                    //$("#LegPortId option[value=5]").attr('selected', 'selected');
                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });




    };
</script>


<script>
    function GetCPDate(t) {


        var Id = t.value;
        var cpid = $("#CPID option:selected").val();
        //alert(portName);



        $.ajax({
            type: 'GET',
            url: '/Report/NoonConsumption/BindCPDate?Cpid=' + cpid,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {

                    //alert(response.StartDate);
                    var mindate = new Date(response.StartDate);
                    var maxdate = new Date(response.EndDate);

                    $('input[name="datefilter"]').daterangepicker({
                        autoUpdateInput: false,
                        "minDate": mindate,
                        "maxDate": maxdate,
                        locale: {
                            cancelLabel: 'Clear',



                        }
                    });
                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });




    };
</script>
