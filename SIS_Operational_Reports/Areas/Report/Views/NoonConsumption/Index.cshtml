                </div>

                <div class="col m-6">
                    @Html.DropDownListFor(model => model.CPID, new SelectList(Model.CPNameList, "Value", "Text"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", @onchange = "GetCPDate(this)", })
