<script>
    function bindport(t) {

        var Id = t.value;
        var Legid = $("#LegPortId option:selected").val();
        //alert(portName);


        $.ajax({
            type: 'GET',
            url: '/Report/Arrival/BindPort?Legid=' + Legid,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    $('#PortName').empty();


                    $('#PortName').append('<option value="">None Selected</option>');
                    for (var i = 0; i < response.Data.length; i++) {

                        var txt = response.Data[i].Text;
                        var valu = response.Data[i].Value;
                        // alert(txt);
                        $('#PortName').append('<option value="' + txt + '">' + txt + '</option>');

                    }
                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });


    };
</script>

