                        @autocomplete = "off",
                        @class = "form-control bottom-border-input",
                        @type = "datetime-local"
           }
                })

                <span id="msgETB" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">EOSP</label>
            <div class="col-sm-8">

                @Html.EditorFor(model => model.EOSP, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local" } })

                <span id="msgEOSP" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">
        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Fwd(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftFwd, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @type = "number", @min = "0", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftFwd" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Mid(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftMid, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @type = "number", @min = "0", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftMid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Aft(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftAft, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @type = "number", @min = "0", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftAft" style="color:red"></span>
            </div>

        </div>

        <div class="col-md">
            <div class="row">
                <div class="col">
                    <button id="btnSave" class="function-button submit-button">
                        Submit
                    </button>
                </div>
                <div id="SDraft" class="col">
                    <button onclick="SaveDraftFunction()" class="function-button draft-button">
                        Save Draft
                    </button>
                    <div hidden="hidden">
                        @Html.CheckBoxFor(model => model.SaveDraft)
                    </div>

                </div>
                <div class="col">
                    <button type="reset" class="function-button reset-button">
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


