                @Html.EditorFor(model => model.NOR, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @type = "datetime-local" } })

                <span id="msgNOR" style="color:red"></span>
            </div>


        </div>
    </div>

    <div class="col-md">
        <div class="mb-3 row">




