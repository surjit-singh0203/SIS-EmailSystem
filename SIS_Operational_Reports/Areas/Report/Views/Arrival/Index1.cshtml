@model DataBuildingLayer.ArrivalReport
@{
    /**/

    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}

<style>
    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #676969 !important;
    }

    .nav-link {
        color: #676969;
        border: solid 1px #676969 !important;
        margin: 5px;
    }

        .nav-link:hover {
            background-color: #676969 !important;
            color: white !important;
        }

    .tab-content {
        margin: 5px !important;
        box-shadow: 0px 16px 40px 0px #00000026 !important;
        width: 100% !important;
        padding: 10px;
    }

    .nav-link.active {
        font-weight: normal;
    }

    .tab-content .row .col-md .GeneratedTable {
        margin: 15px 4.8px;
    }
</style>

<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>


            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit Arrival Report
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@Html.HiddenFor(e => e.Id)
@Html.HiddenFor(e => e.HiddenTotalSum)
<div class="row" style="margin-top: 10px;">

    <div class="col-md">
        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @onchange = "GetLeg(this)", @required = "true", })
                <span id="messageVoyid" style="color:red"></span>
            </div>



            <label for="inputPassword" class="col-sm-4 col-form-label">Lat</label>
            <div class="col-sm-8">


                @Html.EditorFor(model => model.Lat1, new { htmlAttributes = new { @autocomplete = "off", @class = "col-sm-3", @maxlength = 2, @required = "true", @onkeypress = "return isNumberKey(event)", @onKeyUp = "requiredValueLat(this)", @step = "any" } })
                <b style="font-size:large">&#176</b>

                @Html.EditorFor(model => model.Lat2, new { htmlAttributes = new { @autocomplete = "off", @class = "col-sm-3", @maxlength = 2, @required = "true", @onkeypress = "return isNumberKey(event)", @onKeyUp = "requiredValueLatLong(this)", @step = "any" } })
                <b style="font-size:large">'</b>

                @Html.DropDownListFor(model => model.Lat3, new SelectList(Model.NS, "Value", "Text"), "", htmlAttributes: new { @class = "col-sm-2 select2", @required = "true", })


                <span id="msgLat" style="color:red"></span>
            </div>
            <div style="display:none" class="col-sm-8">
                @Html.EditorFor(model => model.Latitude, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 20, @required = "true", onkeypress = "long(this.value)" } })
                <span id="messageLat" style="color:red"></span>
            </div>



            <label for="inputPassword" class="col-sm-4 col-form-label">Place</label>
            <div class="col-sm-8 radio-column">

                <input onclick="eventTwo()" type="radio" id="Sea" name="location-status" value="CSS">
                <label onclick="eventTwo()" for="Sea">Anchorage</label><br>
                <input onclick="eventOne()" type="radio" id="Port" name="location-status" value="JavaScript">
                <label onclick="eventOne()" for="Port">Berth</label>
                <span id="msgPlace" style="color:red"></span>
                <div style="display:none;">
                    @Html.TextBoxFor(m => m.Place)
                </div>

            </div>
        </div>
    </div>

    <div class="col-md">
        <div class="mb-3 row">

            @*<label for="inputPassword" class="col-sm-4 col-form-label">Place</label>
                <div class="col-sm-8 radio-column">

                    <input onclick="eventTwo()" type="radio" id="Sea" name="location-status" value="CSS">
                    <label onclick="eventTwo()" for="Sea">Anchorage</label><br>
                    <input onclick="eventOne()" type="radio" id="Port" name="location-status" value="JavaScript">
                    <label onclick="eventOne()" for="Port">Berth</label>
                    <span id="msgPlace" style="color:red"></span>
                    <div style="display:none;">
                        @Html.TextBoxFor(m => m.Place)
                    </div>

                </div>*@

            <label for="inputPassword" class="col-sm-4 col-form-label">Leg</label>
            <div class="col-sm-8">

                @*@Html.DropDownListFor(model => model.LegPortId, Model.LegPortList, htmlAttributes: new { @class = "form-control bottom-border-input", @required = "true", })*@
                @Html.DropDownListFor(model => model.LegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", @onchange = "GetARCargo();GetDisByLeg1(this);bindport(this);", })
                <span id="msgLegPortId" style="color:red"></span>
            </div>


            <label for="inputPassword" class="col-sm-4 col-form-label">Long</label>
