                <span id="messageLong" style="color:red"></span>
            </div>
            <div class="col-sm-8">

                @Html.EditorFor(model => model.Long1, new { htmlAttributes = new { @autocomplete = "off", @class = "col-sm-3", @maxlength = 3, @required = "true", @onkeypress = "return isNumberKey(event)", @onKeyUp = "requiredValueLong(this)", @step = "any" } })
                <b style="font-size:large">&#176</b>

                @Html.EditorFor(model => model.Long2, new { htmlAttributes = new { @autocomplete = "off", @class = "col-sm-3", @maxlength = 3, @required = "true", @onkeypress = "return isNumberKey(event)", @onKeyUp = "requiredValueLatLong(this)", @step = "any" } })
