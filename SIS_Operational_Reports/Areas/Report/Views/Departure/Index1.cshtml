                                        <tr>
                                            <td> </td>
                                            <td>Oil</td>
                                            <td>Water</td>
                                            <td>Total</td>
                                        </tr>
                                        <tr>
                                            <td>Slops Disposed(m3)</td>
                                            <td> @Html.EditorFor(model => model.SlopsDisposed_Oil, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                            <td> @Html.EditorFor(model => model.SlopsDisposed_Water, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>

                                            <td> @Html.EditorFor(model => model.SlopsDisposed_Total, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                        </tr>
                                        <tr>
                                            <td>Slops ROB(m3)</td>
                                            <td> @Html.EditorFor(model => model.SlopsROB_Oil, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                            <td> @Html.EditorFor(model => model.SlopsROB_Water, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                            <td> @Html.EditorFor(model => model.SlopsROB_Total, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                        </tr>
                                        <tr>
                                            <td>Bilge Disposed(m3)</td>
