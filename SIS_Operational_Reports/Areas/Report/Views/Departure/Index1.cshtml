                            <thead>
                                <tr>
                                    <th colspan="2">Manoeuvring</th>
                                </tr>

                            </thead>
                            <tbody>
                                <tr>
                                    <td>Manoeuvring Hours</td>
                                    <td> @Html.EditorFor(model => model.Manoeuvring_Hrs, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                </tr>
                                <tr>
                                    <td>Manoeuvring Distance</td>
                                    <td> @Html.EditorFor(model => model.Manoeuvring_Distance, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                </tr>

                            </tbody>
                        </table>
                        <!-- table-end -->

                        <table class="GeneratedTable">
                            <thead>
                                <tr>
                                    <th colspan="2">Weather</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Sea State</td>

                                    <td>
                                        @Html.DropDownListFor(model => model.SeaState, new SelectList(Model.SeaStateList, "Value", "Text"), "----Select----", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })

                                        <span id="msgSeaState" style="color:red"></span>
                                    </td>
                                    @*<td> @Html.EditorFor(model => model.SeaState, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })  </td>*@

                                </tr>
                                <tr>
                                    <td>Wind Direction</td>

                                    <td>@Html.DropDownListFor(model => model.WindDirection, new SelectList(Model.WindDirectionList, "Value", "Text"), "----Select----", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })  <span id="msgWindDirection" style="color:red"></span></td>
                                    @*<td> @Html.EditorFor(model => model.WindDirection, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })  </td>*@
                                </tr>
                                <tr>
                                    <td>Wind Force</td>
                                    <td>@Html.DropDownListFor(model => model.WindForce, new SelectList(Model.WindForceList, "Value", "Text"), "----Select----", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })<span id="msgWindForce" style="color:red"></span> </td>
                                    @*<td> @Html.EditorFor(model => model.WindForce, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })  </td>*@
                                </tr>
                                <tr>
                                    <td>Swell Direction</td>
                                    @*<td> @Html.EditorFor(model => model.SwellDirection, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })  <span id="msgSwellDirection" style="color:red"></span></td>*@
                                    <td>@Html.DropDownListFor(model => model.SwellDirection, new SelectList(Model.WindDirectionList, "Value", "Text"), "----Select----", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })  <span id="msgSwellDirection" style="color:red"></span></td>

                                </tr>
                                <tr>
                                    <td>Swell Height</td>
                                    <td> @Html.EditorFor(model => model.SwellHeight, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                </tr>
                                <tr>
                                    <td>Wave Length</td>
                                    <td> @Html.EditorFor(model => model.WaveLength, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                </tr>
                                <tr>
                                    <td>Wave Height</td>
                                    <td> @Html.EditorFor(model => model.WaveHeight, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })  </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row">
                        <table id="tblNonRoutineEvents" class="GeneratedTable">
                            <thead>
                                <tr>
                                    <th colspan="3">Non-Routine Events</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td> </td>
                                    <td> Owners/Charterers Account</td>
                                    <td> Hrs.</td>
                                </tr>
                                <tr>
                                    <td>Stopage at Sea</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", }) </td>
                                    <td><input id="IdFirst" onclick="firstFunc()" maxlength="5" type='text' onblur="myFunction1()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                                <tr>
                                    <td>Deviation</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", }) </td>
                                    <td><input type='text' id="IdSecond" maxlength="5" onclick="secondFunc()" onblur="myFunction2()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                                <tr>
                                    <td>Slow Steaming</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", }) </td>
                                    <td><input type='text' id="IdThird" maxlength="5" onclick="thirdFunc()" onblur="myFunction3()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                                <tr>
                                    <td>Bad Weather</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", }) </td>
                                    <td><input type='text' id="IdFourth" maxlength="5" onclick="fourthFunc()" onblur="myFunction4()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                                <tr>
                                    <td>COT Preparation</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select  bottom-border-input", @required = "true", }) </td>
                                    <td><input type='text' id="IdFifth" maxlength="5" onclick="fifthFunc()" onblur="myFunction5()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                                <tr>
                                    <td>Cargo Heating</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select bottom-border-input", @required = "true", }) </td>
                                    <td><input type='text' id="IdSixth" maxlength="5" onclick="sixthFunc()" onblur="myFunction6()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                                <tr>
                                    <td>BW Exchange</td>

                                    <td>@Html.DropDownListFor(model => model.OwChaterer, new SelectList(Model.OwChList, "Value", "Text", "Owners"), "", htmlAttributes: new { @class = "mdb-select bottom-border-input", @required = "true", }) </td>
                                    <td><input type='text' id="IdSeventh" maxlength="5" onclick="seventhFunc()" onblur="myFunction7()" onkeyup="requiredValueHours(this)" onkeypress="return isNumberKey(event)" class='table-inputs'> </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>

                <div class="col-md">

                    <div class="row">
                        <!-- Speed - Distance - Time Table -->
                        <table class="GeneratedTable">
                            <thead>
                                <tr>
                                    <th colspan="2">Other Receipts, Repairs, Crew Change &amp; Landed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>CTM (Mention Currency &amp; Amount)</td>
                                    <td>
                                        @Html.EditorFor(model => model.CTM, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })
                                        <span id="msgCTM" style="color:red"></span>
                                    </td>

                                </tr>
                                <tr>
                                    <td>SPARES (Mention Revision Numbers)</td>
                                    <td>
                                        @Html.EditorFor(model => model.Spares, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })
                                        <span id="msgSpares" style="color:red"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>STORES (Mention Revision Numbers)</td>
                                    <td>
                                        @Html.EditorFor(model => model.Stores, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })
                                        <span id="msgStores" style="color:red"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>REPAIRS CONDUCTED (Mention details)</td>
                                    <td>
                                        @Html.EditorFor(model => model.RepairsConducted, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })
                                        <span id="msgRepairsConducted" style="color:red"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>CREW CHANGE (No of Crew)</td>
                                    <td>
                                        @Html.EditorFor(model => model.CrewChange, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })
                                        <span id="msgCrewChange" style="color:red"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ITEMS LANDED (Mention Details)</td>
                                    <td>
                                        @Html.EditorFor(model => model.ItemsLanded, new { htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 20, @required = "true", } })
                                        <span id="msgItemsLanded" style="color:red"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <!-- table-end -->
                    </div>
                    <div class="row">
                        <!-- Speed - Distance - Time Table -->
                        <table class="GeneratedTable">
                            <thead>
                                <tr>
                                    <th colspan="2">Departure Report Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Departure Report<br>Remarks</td>
                                    <td> @Html.TextAreaFor(model => model.Remarks, new { @style = "width:370px", @placeholder = "max 500 character", htmlAttributes = new { @autocomplete = "off", @class = "table-inputs", @maxlength = 500, @required = "true", } })  <span id="msgRemarks" style="color:red"></span> </td>
                                </tr>
                            </tbody>
                        </table>
                        <!-- table-end -->
                    </div>

                </div>


            </div>
        </div>

        <div class="tab-pane fade" id="v-pills-profile" role="tabpanel" aria-labelledby="v-pills-profile-tab">
            <div class="row">
                <div class="col-md">
                    <div class="row">
                        <div class="col-xl">


                            <div class="row">
                                <table class="GeneratedTable">
                                    <thead>
                                        <tr>
                                            <th colspan="4">Slops / Bilge Disposed &amp; ROB</th>
                                        </tr>
                                    </thead>
