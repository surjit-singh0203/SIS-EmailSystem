@model DataBuildingLayer.DepartureReport
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}

<style>
    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: #676969 !important;
    }

    .nav-link {
        color: #676969;
        border: solid 1px #676969 !important;
        margin: 5px;
    }

        .nav-link:hover {
            background-color: #676969 !important;
            color: white !important;
        }

    .tab-content {
        margin: 5px !important;
        box-shadow: 0px 16px 40px 0px #00000026 !important;
        width: 100% !important;
        padding: 10px;
    }

    .nav-link.active {
        font-weight: normal;
    }

    .tab-content .row .col-md .GeneratedTable {
        margin: 15px 4.8px;
    }
</style>
<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>

            <h2>
                @{
                    var idcheck = Model.Id.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit Departure Report
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
        </div>
    </div>
</div>

@Html.HiddenFor(e => e.Id)


<div class="row" style="margin-top: 10px;">


    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @onchange = "GetLeg(this);Getfuelcons5(this)", @required = "true", })
                <span id="messageVoyid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Next Leg</label>
            <div class="col-sm-8">
                @*@Html.DropDownListFor(model => model.NextLegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", @onchange = "GetDisByLeg1(this)", })
                    <span id="msgLegPortId" style="color:red"></span>*@


                @Html.DropDownListFor(model => model.NextLegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", @onchange = "bindport1(this)", })
                <span id="msgNextLegPortId" style="color:red"></span>



            </div>







            <label for="inputPassword" class="col-sm-4 col-form-label">Report Date</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.ReportDate, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 20, @required = "true", @readonly = true, @placeholder = "yyyy-mm-dd" } })
                <span id="msgReportDate" style="color:red"></span>
            </div>


        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">





            <label for="inputPassword" class="col-sm-4 col-form-label">Leg</label>
            <div class="col-sm-8">


                @Html.DropDownListFor(model => model.DepLegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", @onchange = "bindport(this);GetDRCargo()", })
                <span id="msgDepLegPortId" style="color:red"></span>


            </div>


            <label for="inputPassword" class="col-sm-4 col-form-label">Next Port</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.NextPort, new SelectList(Model.PortList, "Id", "Port"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })
                <span id="msgNextPort" style="color:red"></span>
            </div>


        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Dep. Port</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.DeparturePort, new SelectList(Model.PortList, "Id", "Port"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })
                <span id="msgDeparturePort" style="color:red"></span>
            </div>


            <label for="inputPassword" class="col-sm-4 col-form-label">ETA</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.ETA, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 20, @required = "true", @readonly = true, @placeholder = "yyyy-mm-dd" } })
                <span id="msgETA" style="color:red"></span>
            </div>



        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Fwd(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftFwd, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftFwd" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Mid(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftMid, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftMid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Aft(Mtrs)</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftAft, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftAft" style="color:red"></span>
            </div>

        </div>

        <div class="col-md">

            <div class="row">
                <div class="col">
                    <button id="btnSave" class="function-button submit-button">
                        Submit
                    </button>
                </div>
                <div id="SDraft" class="col">
                    <button onclick="SaveDraftFunction()" class="function-button draft-button">
                        Save Draft
                    </button>
                    <div hidden="hidden">
                        @Html.CheckBoxFor(model => model.SaveDraft)
                    </div>

                </div>

                <div class="col">
                    <button class="function-button reset-button">
                        Reset
                    </button>
                </div>
            </div>


        </div>

    </div>

</div>

<div class="d-flex align-items-start">
    <div class="nav flex-column nav-pills me-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
        <button class="nav-link active" id="v-pills-home-tab" data-bs-toggle="pill" data-bs-target="#v-pills-home"
                type="button" role="tab" aria-controls="v-pills-home" aria-selected="true">
            Navigation
        </button>
        <button class="nav-link" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile"
                type="button" role="tab" aria-controls="v-pills-profile" aria-selected="false">
            Engine
        </button>
        <button class="nav-link" id="v-pills-messages-tab" data-bs-toggle="pill" data-bs-target="#v-pills-messages"
                type="button" role="tab" aria-controls="v-pills-messages" aria-selected="false">
            Cargo
        </button>
    </div>
    <div class="tab-content" id="v-pills-tabContent">

        <div class="tab-pane fade show active" id="v-pills-home" role="tabpanel" aria-labelledby="v-pills-home-tab">
            <div class="row">



                <div class="col-md">

