<script>


    function GetDRCargoEdit(id) {

        $.ajax({
            type: 'GET',
            /*  url: '/Report/DailyNoon/Getfuelcons?VoyId=' + VoyId,*/
            url: '/Report/Departure/GetdRCargoEdit?DepReportId=' + id,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    var DRCargoList = response.drc;
                    var CountCargo = response.cntdrc;

                    //alert(FtypeList);

                    var rowCount = CountCargo;
                    let len = rowCount;
                    for (let i = 2; i <= len; i++) {

                        var $tableBody = $('#tblCargo').find("tbody"),
                            $trLast = $tableBody.find("tr:last"),
                            $trNew = $trLast.clone();

                        $trLast.after($trNew);
                    }




                    debugger;

                    //for (var i = rowCount - 4; i > 0; i--) {
                    //    tblFuelC.deleteRow(i);
                    //}
                    var count = 0; var ss = ""; var ss1 = "";
                    var table = document.getElementById('tblCargo');


                    var j = 2; var k = 0;
                    $.each(DRCargoList, function (index, value) {
                        ss1 = value;

                        if (k == 0) {
                            table.rows[j].cells[k].innerHTML = ss1;
                            k++;
                        }
                        else if (k == 6) {
                            k = 0;
                            j++;
                            table.rows[j].cells[k].innerHTML = ss1;
                            k++;
                        }
                        else {
                            table.rows[j].cells[k].children[0].value = ss1;
                            k++;
                        }
                    });




                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });
    }



</script>

