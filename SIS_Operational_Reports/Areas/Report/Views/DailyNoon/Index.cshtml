            Bunker2 = parseFloat($("#IdFuelBunker2").val()).toFixed(3);
            var sum = parseFloat(Bunker2) + parseFloat(FuelRob2) - parseFloat(idmdototal);
            sum = sum.toFixed(3);
            $("#IdFuelRob1").val(sum);
        }
        if (FuelRob2 == "" && idmdototal != "" && Bunker2 != "") {
