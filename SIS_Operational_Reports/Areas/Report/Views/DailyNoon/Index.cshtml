    input#Sea {
        margin-right: 7px;
    }

    input#Port {
        margin-left: 10px;
        margin-right: 6px;
    }
</style>
<div id="cover-spin"></div>
<div class="row">
    <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div>
            <h2>
                @{

                    var ssr = Request.Url.AbsoluteUri.Contains("Edit");
                    var dtchk11 = DateTime.Now.AddDays(-1);

                    var dtchk = Convert.ToString(dtchk11.ToShortDateString());
                    DateTime dtchk1 = Convert.ToDateTime(Model.Date);
                    var ss = dtchk1.ToShortDateString();

                    var idcheck = Model.Id.ToString();
                    var isSubmit = Model.IsSubmit.ToString();
                    var addEdit = "";
                    if (idcheck == "0")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        if (dtchk.ToString() == ss.ToString())
                        {
                            if (ssr == true)
                            {
                                addEdit = "Edit";
                            }
                            else
                            {

                                addEdit = "Add";
                            }
                        }
                        else
                        {
                            addEdit = "Edit";
                        }
                    }

                    if (isSubmit == "False")
                    {
                        addEdit = "Add";
                    }
                    else
                    {
                        addEdit = "Edit";
                    }
                }


                @addEdit Daily Noon Report
            </h2>

        </div>
        <div class="col-md button-row-top">

            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> &lt;&lt; Go Back</a>
           
        </div>
    </div>
</div>

