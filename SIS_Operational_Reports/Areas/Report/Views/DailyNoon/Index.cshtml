        if (idmdototal != "") {
            idmdototal = parseFloat(idmdototal).toFixed(3);
            $("#idmdototal").text(idmdototal);
        }

        if (FuelRob2 != "" && idmdototal != "" && Bunker2 != "") {
            FuelRob2 = parseFloat($("#FuelRob2").val());
