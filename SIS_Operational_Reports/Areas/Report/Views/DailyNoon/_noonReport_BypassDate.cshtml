@using DataBuildingLayer;
@model DailyNoonReportAllow


<table  id="tblByPassNoonreport_Date" class="GeneratedTable centered-table">
    <thead>
        <tr>
            <th style="display:none">Id</th>
            <th style="display:none">VesselID</th>
            <th>Vessel Name</th>
            <th>Noon Report Allow</th>
            <th>User</th>

            @if (StaticHelper.UserRole == "Administrator" || StaticHelper.UserRole == "Superintendent")
            {
                <th>Action</th>
            }


        </tr>

    </thead>
    <tbody>

        @foreach (var item in Model.ByPass_NDPList)
        {

            <tr>
                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                <td style="display:none"> @Html.DisplayFor(modelItem => item.VesselID)</td>
                <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                <td> @Html.DisplayFor(modelItem => item.allow_Noondate)</td>
                <td>@Html.DisplayFor(modelItem => item.userName)</td>

                @if (StaticHelper.UserRole == "Administrator" || StaticHelper.UserRole == "Superintendent")
                {
                    <td width="300px">
                        <button type="button" class="btn btn-sm btn-light btn-delete">
                            <i class="uil uil-trash-alt mr-2"></i>
                            @Html.ActionLink("Delete", "DeleteNoonReport_ByPassDate", "DailyNoon", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })

                        </button>
                    </td>
                }

            </tr>
        }


    </tbody>
</table>

<nav aria-label="Page navigation example">
    <ul class="pagination">


        @{

            string search1= ViewBag.search1;
            string search2 = ViewBag.search2;
            int totalRecords = 0;
            foreach (var item in Model.ByPass_NDPList)
            {
                totalRecords = item.TotalCount;
                break;
            }
            //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
            // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

            int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

            int tot_pages = totalRecords / pageSize;
            int remainder = totalRecords % pageSize;

            tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

            int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

            if (totalRecords > 0)
            {
                if (currPage == 0)
                {
                    currPage = 1;
                }

                if (currPage != 1)
                {
                    <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "NoonReportallowList", "DailyNoon", new { pageNo = 1 }, null)</a></li>
                }

                if (currPage != tot_pages)
                {
                    for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                    {
                        if (cnt == currPage)
                        {
                            <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                        }
                        else
                        {
                            <li class="page-item">@Html.ActionLink(cnt.ToString(), "NoonReportallowList", "DailyNoon", new { pageNo = cnt }, null)</li>
                        }

                        if (cnt == tot_pages)
                        {
                            break;
                        }
                    }
                }

                //if (search1 == "" && search2 == "")
                //{

                if (currPage == tot_pages)
                {
                    <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                  }
                  else
                  {
                    <li class="page-item">@Html.ActionLink("Last", "NoonReportallowList", "DailyNoon", new { pageNo = tot_pages }, null)</li>
                  }

                //}
            }
          }
    </ul>
</nav>
