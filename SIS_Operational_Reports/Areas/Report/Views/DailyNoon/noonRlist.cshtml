                <ul class="pagination">
                    @{
                        //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                        int totalRecords = 0;
                        foreach (var item in Model.GetNoonRList)
                        {
                            totalRecords = item.TotalCount;
                            break;
                        }

                        int tot_pages = totalRecords / 10;
                        int remainder = totalRecords % 10;

                        tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                        int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                        if (totalRecords > 0)
                        {
                            if (currPage == 0)
                            {
                                currPage = 1;
                            }

                            if (currPage != 1)
                            {
                                <li>@Html.ActionLink("First", "noonRlist", "DailyNoon", new { pageNo = 1 }, null)</li>
                            }

                            if (currPage != tot_pages)
                            {
                                for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                {
                                    if (cnt == currPage)
                                    {
                                        <li class="active"><a href="#">@cnt</a></li>
                                    }
                                    else
                                    {
                                        <li>@Html.ActionLink(cnt.ToString(), "noonRlist", "DailyNoon", new { pageNo = cnt }, null)</li>
                                    }

                                    if (cnt == tot_pages)
                                    {
                                        break;
                                    }
                                }
                            }


                            if (currPage == tot_pages)
                            {
                                <li class="active"><a href="#">@tot_pages</a></li>
                            }
                            else
                            {
                                <li>@Html.ActionLink("Last", "noonRlist", "DailyNoon", new { pageNo = tot_pages }, null)</li>
                            }
                        }
                    }
                </ul>
