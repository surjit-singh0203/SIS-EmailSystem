@using DataBuildingLayer;
@model DataBuildingLayer.BunkerReport


<style>
td#newset {
    width: 450px!important;
    word-break: break-all;
    white-space: normal;
}
a#FormatforPrint {
    display: none;
}

</style>
<div id="test">
    <table id="tblBunkerReport" class="GeneratedTable centered-table">
        <thead>
            <tr>
                <th style="display:none">Id</th>
                <th>Voyage No.</th>
                <th>Vessel Name</th>
                @*<th>Report Date</th>*@
                <th>Port Name</th>
                <th>Supplier</th>
                <th>Barge Name</th>
                @*<th>Status</th>*@
                @*<th>Submit Date</th>*@

                <th style="width: 150px;">Action</th>

            </tr>

        </thead>
        <tbody>

            @foreach (var item in Model.BunkerReportList)
            {

            <tr>
                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                <td> @Html.DisplayFor(modelItem => item.voyagenumber)</td>
                <td>@Html.DisplayFor(modelItem => item.VesselName)</td>
                @*<td></td>*@
                <td> @Html.DisplayFor(modelItem => item.PortName)</td>
                <td id="newset"> @Html.DisplayFor(modelItem => item.Supplier) </td>
                <td id="newset"> @Html.DisplayFor(modelItem => item.BargeName) </td>
                @*<td> </td>*@
                <td>
                    <div class="row button-row">
                        <div class="col table-button-container">
                            <button type="button" class="function-button table-button">
                                @Html.ActionLink("View/Edit", "Edit", "Bunker", new { id = item.Id, vslid = item.VesselId }, new { onclick = "" })
                            </button>
                        </div>
                        @*<div class="col table-button-container">
                    <button type="button" class="function-button table-button">
                        @Html.ActionLink("Delete", "Delete", "Bunker", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                    </button>
                </div>*@
                    </div>
                </td>

            </tr>
            }


        </tbody>
    </table>

    <nav aria-label="Page navigation example">
        <ul class="pagination">


            @{

                string search1 = ViewBag.search1;
                string search2 = ViewBag.search2;
                int totalRecords = 0;
                foreach (var item in Model.BunkerReportList)
                {
                    totalRecords = item.TotalCount;
                    break;
                }
                //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                int tot_pages = totalRecords / pageSize;
                int remainder = totalRecords % pageSize;

                tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                if (totalRecords > 0)
                {
                    if (currPage == 0)
                    {
                        currPage = 1;
                    }

                    if (currPage != 1)
                    {
                        <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "BunkerReportList", "Bunker", new { pageNo = 1 }, null)</a></li>
                    }

                    if (currPage != tot_pages)
                    {
                        for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                        {
                            if (cnt == currPage)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                            }
                            else
                            {
                                <li class="page-item">@Html.ActionLink(cnt.ToString(), "BunkerReportList", "Bunker", new { pageNo = cnt }, null)</li>
                            }

                            if (cnt == tot_pages)
                            {
                                break;
                            }
                        }
                    }

                    //if (search1 == "" && search2 == "")
                    //{

                    if (currPage == tot_pages)
                    {
                        <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                    }
                    else
                    {
                        <li class="page-item">@Html.ActionLink("Last", "BunkerReportList", "Bunker", new { pageNo = tot_pages }, null)</li>
                    }

                    //}
                }
            }
        </ul>
    </nav>
</div>
