<div class="container">
    <div class="row">
        	<div class= "inline-content" style= "margin-top: 10px; padding: 0;">
            <h4>Voyage Leg Details</h4>
            <a href="@Url.Action("insertleg", "Voyage", new { vid = Model.VoyageId })" class="btn btn-sm btn-light btn-edit">
                <i class="uil uil-edit-alt mr-2"></i>Add Voyage Leg
            </a>
        
		</div>

        <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->


        <table class="GeneratedTable centered-table">
            <thead>
                <tr>
                    <th style="display:none">Id</th>
                    <th style="display:none">VoyageId</th>
                    <th>LegPort A</th>
                    <th>LegPort B</th>
                    <th>ReasonforPortCall A</th>
                    <th>ReasonforPortCall B</th>
                    <th>DTG</th>
                    <th>CP_SOG</th>
                    <th>CP_Log_Speed</th>
                    @if (StaticHelper.LoginUser == "master" || StaticHelper.LoginUser == "2off")
                    {
                        <th>Action</th>
                    }
                    </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.GetVoyageLegList)
                {
                <tr>
                    <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                    <td style="display:none"> @Html.DisplayFor(modelItem => item.VoyageId)</td>
                    <td> @Html.DisplayFor(modelItem => item.LegPort_A)</td>
                    <td> @Html.DisplayFor(modelItem => item.LegPort_B)</td>

                    <td style="display:none"> @Html.DisplayFor(modelItem => item.ReasonforPortCall_A)</td>
                    <td style="display:none"> @Html.DisplayFor(modelItem => item.ReasonforPortCall_B)</td>


                    <td> @Html.DisplayFor(modelItem => item.ReasonA)</td>
                    <td> @Html.DisplayFor(modelItem => item.ReasonB)</td>
                    <td> @Html.DisplayFor(modelItem => item.DTG)</td>
                    <td> @Html.DisplayFor(modelItem => item.CP_SOG)</td>
                    <td> @Html.DisplayFor(modelItem => item.CP_Log_Speed)</td>

                    @if (StaticHelper.LoginUser == "master" || StaticHelper.LoginUser == "2off")
                    {
                        <td>
                            <div class="row button-row">
                                <div class="col table-button-container">
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("Edit", "editvoyageleg", "Voyage", new { id = item.Id }, new { onclick = "" })
                                    </button>
                                </div>
                                <div class="col table-button-container">
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("Delete", "deletevoyageleg", "Voyage", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                    </button>
                                </div>
                            </div>
                        </td>

                    }
                    </tr>
                }
            </tbody>
        </table>
        <!-- Codes by Quackit.com -->


    </div>
</div>



<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>


