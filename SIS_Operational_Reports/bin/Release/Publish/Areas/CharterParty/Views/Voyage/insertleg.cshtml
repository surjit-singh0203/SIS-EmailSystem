@using DataBuildingLayer;
@model DataBuildingLayer.VoyageClass
@{
    /**/

    ViewBag.Title = "insertleg";
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}


<style>

    .modal-header {
        justify-content: end;
    }

    button.closeA {
        background: tansparent;
        font-size: 19px;
        color: border;
        border-radius: 3px;
        border: 1px solid gray;
    }

    button#submitA {
        background: black;
        border-color: black;
    }

    input#LegPort_othersA {
        width: 100%;
    }

</style>

<div class="row" style="margin-top: 10px;">

    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div class="col-md">
            <h4>Add Voyage Leg</h4>
        </div>
        <div class="col-md button-row-top">
            <button name="back" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>

        </div>
    </div>


</div>

<table id="tblvoyageleg" class="GeneratedTable" cellpadding="0" cellspacing="0">
    <thead>
        <tr>

            <th id="LegA">
                Leg Port (A)*
            </th>
            <th id="ReasonA">
                Reason for Port Call (A)*
            </th>
            <th id="LegB">
                Leg Port (B)*
            </th>
            <th id="ReasonB">
                Reason for Port Call (B)*

            </th>
            <th id="LegDTG">DTG(nm)*</th>
            <th id="LegCP_SOG">CP SOG(kts)*</th>
            <th id="LegCP_Log_Speed">CP Log Speed(kts)*</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (VoyageLeg VLeg in Model.VoyageLegList)
        {
            <tr>
                <td>@VLeg.LegPort_A</td>
                <td>@VLeg.ReasonforPortCall_A</td>
                <td>@VLeg.LegPort_B</td>
                <td>@VLeg.ReasonforPortCall_B</td>
                <td>@VLeg.DTG</td>
                <td>@VLeg.CP_SOG</td>
                <td>@VLeg.CP_Log_Speed</td>
                @*<td><input class="btn btn-info" type="button" value="Remove" onclick="Remove(this)" /></td>*@
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td> @Html.DropDownListFor(model => model.LegPort_A, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>

            <td>  @Html.DropDownListFor(model => model.ReasonforPortCall_A, new SelectList(Model.PortStatusList, "Status", "Status"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            <td> @Html.DropDownListFor(model => model.LegPort_B, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            <td>  @Html.DropDownListFor(model => model.ReasonforPortCall_B, new SelectList(Model.PortStatusList, "Status", "Status"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            <td>@Html.EditorFor(model => model.DTG, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 7, @max = "99999", @required = "true", @onKeyUp = "requiredValue2(this)" } })</td>
            <td>  @Html.DropDownListFor(model => model.CP_SOG, new SelectList(Model.SpeedStatusList, "Speed", "Speed"), "", htmlAttributes: new { @class = "form-control bottom-border-input select2", @required = "true", })</td>
            @*<td> @Html.EditorFor(model => model.CP_SOG, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>*@
            <td> @Html.EditorFor(model => model.CP_Log_Speed, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @step = "any" } })</td>
            <td><input class="btn btn-info" type="button" id="btnAdd" value="Add" /></td>



        </tr>
    </tfoot>
</table>

<div class="modal fade" id="DisplayModalA" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="closeA" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    Port Name:  @Html.EditorFor(m => m.LegPort_othersA, new { @class = "form-control bottom-border-input",  })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="closeA" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="submitA" class="btn btn-primary pull-right">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="DisplayModalB" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="closeB" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    Port Name: @Html.EditorFor(m => m.LegPort_othersB, new { @class = "form-control bottom-border-input", })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="closeB" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button id="submitB" class="btn btn-primary pull-right">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="inline-content" style="justify-content: center; margin-top: 10px;">
    <input class="btn btn-success btn-width" type="button" id="btnSave" value="Save All" />
</div>

<script type="text/javascript">
    function requiredValue1(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 1) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }
        if (value > 99.99) {

            $("#" + id + "").val('');
        }

    }
</script>
<script type="text/javascript">
    function requiredValue2(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 1) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }
        if (value > 99999.99) {

            $("#" + id + "").val('');
        }

    }
</script>

