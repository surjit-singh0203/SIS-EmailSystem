<div class="wrapper wrapper-content">
    <div class="container">

        <div class="form-body">
            <table class="GeneratedTable">
                <thead>
                    <tr>
                        <th style="display:none">ID</th>
                        <th>Charter Party ID</th>
                        <th>Charter Party Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>

                        <th>Voyage Type</th>


                    </tr>

                </thead>
                <tbody>



                    <tr>
                        <td style="display:none"> @Html.DisplayFor(modelItem => modelItem.Id)</td>
                        <td> @Html.DisplayFor(modelItem => modelItem.CPNo)</td>
                        <td> @Html.DisplayFor(modelItem => modelItem.CPName)</td>
                        <td>
                            @{
                                @*@ViewBag.startdate= Model.StartDate;*@
                                Session["startDt"] = Model.StartDate;

                                var csdate = Model.StartDate;
                                @Html.Raw(csdate);
                            }
                        </td>
                        <td>
                            @{
                                Session["endDt"] = Model.EndDate;
                                var CEdate = Model.EndDate;
                                @Html.Raw(CEdate);
                            }
                        </td>

                        <td> @Html.DisplayFor(modelItem => modelItem.VoyageType)</td>



                    </tr>



                </tbody>
            </table>
            <div class="table-responsive">
                <div class="inline-content" style="margin-top: 20px;">
                    <h3>Charter Party Vessels</h3>
                    <div>
                        @if (StaticHelper.UserRole == "Administrator")
                        {
                            <a href="@Url.Action("AddCP_Part1", "CP", new { id = Model.Id })" class="btn btn-sm btn-light btn-edit">
                                <i class="uil uil-edit-alt mr-2"></i>Add Vessels
                            </a>
                        }
                    </div>
                </div>
                <table class="GeneratedTable">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th>Vessel Name</th>
                            <th>Imo No</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            @if (StaticHelper.UserRole == "Administrator")
                            {
                                <th>Action</th>
                            }

                        </tr>

                    </thead>
                    <tbody>

                        @foreach (var item in Model.CPVesselInfo)
                        {


                            <tr>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.CPId)</td>
                                @*<td> @Html.DisplayFor(modelItem => item.VesselID)</td>*@
                                <td> @Html.DisplayFor(modelItem => item.VesselName)</td>
                                <td> @Html.DisplayFor(modelItem => item.VesselID)</td>
                                <td>
                                    @{
                                        var sdate = item.StartDate.ToString("dd-MMM-yyyy");
                                        @Html.Raw(sdate);
                                    }
                                </td>
                                <td>
                                    @{
                                        var Edate = item.EndDate.ToString("dd-MMM-yyyy");
                                        @Html.Raw(Edate);
                                    }
                                </td>

                                @*<td width="100px">
                                        <a href="@Url.Action("ViewCPDetail", "CP", new { id = item.Id })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>View Detail
                                        </a>
                                    </td>*@


                                @if (StaticHelper.UserRole == "Administrator")
                                {
                                    <td width="300px">

                                        <a href="@Url.Action("EditVesselinfo", "CP", new { id = item.Id, CPId = item.CPId })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>Edit
                                        </a>


                                        |
                                        <button type="button" class="btn btn-sm btn-light btn-delete">
                                            <i class="uil uil-trash-alt mr-2"></i>
                                            @Html.ActionLink("Delete", "Delete", "CP", new { id = item.Id, CPId = item.CPId, tbl = "CPpart1" }, new { onclick = "return confirm('Are sure wants to delete?');" })

                                        </button>
                                    </td>
                                }

                            </tr>
                        }


                    </tbody>
                </table>
            </div>


            <div class="table-responsive">
                <div class="inline-content" style="margin-top: 20px;">
                    <h3>Charter Party Main Consumption</h3>
                    <div>
                        @if (StaticHelper.UserRole == "Administrator")
                        {
                            <a href="@Url.Action("AddCP_Part2", "CP", new { id = Model.Id })" class="btn btn-sm btn-light btn-edit">
                                <i class="uil uil-edit-alt mr-2"></i>Add Main Consumption
                            </a>
                        }
                    </div>
                </div>
                <table class="GeneratedTable">
                    <thead>
                        <tr style="background: #676969; color: white;">
                            <th style="text-align: center; border: solid 1px white;"></th>
                            <th style="text-align: center; border: solid 1px white;" colspan="2">ME Consumption</th>
                            <th style="text-align: center; border: solid 1px white;" colspan="2">AE Consumption</th>

                            <th></th>
                        </tr>

                        <tr style="background: white; color: #676969;">
                            <th style="text-align: center; color: #676969;">Speed <br>(Knots) </th>
                            <th style="text-align: center; color: #676969;">LADEN<br>VLSFO (MTS/DAY)</th>
                            <th style="text-align: center; color: #676969;">BALLAST<br>VLSFO (MTS/DAY)</th>
                            <th style="text-align: center; color: #676969;">VLSFO (MTS/DAY)</th>
                            <th style="text-align: center; color: #676969;">DO (MTS/DAY)</th>
                            @if (StaticHelper.UserRole == "Administrator")
                            {
                                <th style="text-align: center; color: #676969;">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model.MainCONSUMPTION)
                        {


                            <tr>

                                @{
                                    string first = String.Format("{0:0.000}", item.Speed);
                                    string sec = String.Format("{0:0.000}", item.ME_LADEN);
                                    string thrd = String.Format("{0:0.000}", item.ME_BALLAST);
                                    string frth = String.Format("{0:0.000}", item.AE_VLSFO);
                                    string fiv = String.Format("{0:0.000}", item.AE_DO);
                                }
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.CPId)</td>
                                @*<td> @Html.DisplayFor(modelItem => item.VesselID)</td>*@
                                <td> @Html.DisplayFor(modelItem => item.Speed)</td>
                                <td> @sec</td>
                                <td> @thrd</td>
                                <td> @frth</td>
                                <td> @fiv</td>

                                @*<td width="100px">
                                        <a href="@Url.Action("ViewCPDetail", "CP", new { id = item.Id })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>View Detail
                                        </a>
                                    </td>*@


                                @if (StaticHelper.UserRole == "Administrator")
                                {
                                    <td width="300px">

                                        <a href="@Url.Action("EditMainConsumption", "CP", new { id = item.Id, CPId = item.CPId })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>Edit
                                        </a>


                                        |
                                        <button type="button" class="btn btn-sm btn-light btn-delete">
                                            <i class="uil uil-trash-alt mr-2"></i>
                                            @Html.ActionLink("Delete", "Delete", "CP", new { id = item.Id, CPId = item.CPId, tbl = "CPpart2" }, new { onclick = "return confirm('Are sure wants to delete?');" })

                                        </button>
                                    </td>
                                }

                            </tr>
                        }


                    </tbody>
                </table>
            </div>


            <div class="table-responsive">
                <div class="inline-content" style="margin-top: 20px;">
                    <h3>Charter Party Other Consumption</h3>
                    <div>
                        @if (StaticHelper.UserRole == "Administrator")
                        {
                            <a href="@Url.Action("AddCP_Part3", "CP", new { id = Model.Id })" class="btn btn-sm btn-light btn-edit">
                                <i class="uil uil-edit-alt mr-2"></i>Add Other Consumption
                            </a>
                        }
                    </div>
                </div>
                <table class="GeneratedTable">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th style="display:none">CPId</th>
                            <th>Other Consumption</th>
                            <th>AE_VLSFO</th>
                            <th>AE_MDO</th>
                            <th>BOILER_MDO</th>
                            @if (StaticHelper.UserRole == "Administrator")
                            {
                                <th>Action</th>
                            }

                        </tr>

                    </thead>
                    <tbody>

                        @foreach (var item in Model.OtherCONSUMPTION)
                        {


                            <tr>

                                @{

                                    string sec = String.Format("{0:0.000}", item.AE_VLSFO);
                                    string thrd = String.Format("{0:0.000}", item.AE_MDO);
                                    string frth = String.Format("{0:0.000}", item.BOILER_MDO);

                                }


                                <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                                <td style="display:none"> @Html.DisplayFor(modelItem => item.CPId)</td>
                                <td> @Html.DisplayFor(modelItem => item.Consumption)</td>
                                <td> @sec</td>
                                <td> @thrd</td>
                                <td> @frth</td>
                                @*<td width="100px">
                                        <a href="@Url.Action("ViewCPDetail", "CP", new { id = item.Id })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>View Detail
                                        </a>
                                    </td>*@


                                @if (StaticHelper.UserRole == "Administrator")
                                {
                                    <td width="300px">

                                        <a href="@Url.Action("EditOtherConsumption", "CP", new { id = item.Id, CPId = item.CPId })" class="btn btn-sm btn-light btn-edit">
                                            <i class="uil uil-edit-alt mr-2"></i>Edit
                                        </a>


                                        |
                                        <button type="button" class="btn btn-sm btn-light btn-delete">
                                            <i class="uil uil-trash-alt mr-2"></i>
                                            @Html.ActionLink("Delete", "Delete", "CP", new { id = item.Id, CPId = item.CPId, tbl = "CPpart3" }, new { onclick = "return confirm('Are sure wants to delete?');" })

                                        </button>
                                    </td>
                                }

                            </tr>
                        }


                    </tbody>
                </table>
            </div>

        </div>


    </div>
</div>



