            processData: false,
            success: function (data) {

                // alert(data);
                /* if (response.Result === true) {*/

                //window.location.reload();

                $("#idCP").html('');
                $("#idCP").html(data);


                //;

                // $("#idMaindiv").html('');

                //$("#idMaindiv").html(data);
                // alert(data);
                //}
                //else {
                //    toastr["error"](response.Message);
                //}
            },
            //failure: function (response) {
            //    toastr["error"](response.Message);
            //}
        });





    });

</script>
