@model DataBuildingLayer.FreshWaterReport
@{
    ViewBag.Title = "FreshWaterReportList";
    Layout = "~/Views/Shared/_LayoutForms.cshtml";
}

<script type="text/javascript" src="~/Content/search1.js"></script>
<script type="text/javascript" src="~/Content/search2.js"></script>
<script type="text/javascript" src="~/Content/search3.js"></script>
<link rel="stylesheet" type="text/css" href="~/Content/search.css" />

<link href="~/css/flatpickr.min.css" rel="stylesheet" />
<script src="~/css/flatpickr.js"></script>

<div id="idCP">
    <div class="row">
        <div class="page-heading page-header-flex mt-1" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div>
                <h2>
                    FreshWater-Report List
                </h2>
            </div>

            @if (TempData["error"] != null)
            {
                <p class="alert alert-danger" id="errorMessage">@TempData["error"]</p>
            }
            @if (TempData["success"] != null)
            {
                <p class="alert alert-success" id="successMessage">@TempData["success"]</p>
            }

            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">
                        <button class="function-button submit-button">
                            <a class="function-button submit-button" href="@Url.Action("Index", "FreshWater")">
                                Add FreshWater Report
                            </a>
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>


    <div class="wrapper wrapper-content">
        <div class="container">
            <div class="inline-content">
                <div class="col-md">

                </div>

                <div class="inline-content">
                    <div class="search-row">

                        <!--<div class="col m-1">-->
                        @*@Html.DropDownListFor(model => model.VesselIDs, new SelectList(Model.VesselList, "Value", "Text"), new { @class = "form-control importexport", @multiple = "multiple", })*@

                        @*@Html.DropDownListFor(model => model.VesselId, new SelectList(Model.VesselList, "Value", "Text"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })*@
                    </div>

                    <div class="col m-1">

                        @*@Html.DropDownListFor(model => model.PortName, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input select2", @required = "true", })*@
                        <input id="idPortName" autocomplete="off" placeholder="Port Name" class="form-control" type="text">

                    </div>

                    <div class="col m-1">
                        <input id="idSecond" autocomplete="off" placeholder="yyyy-mm-dd" class="form-control datetimePicker" type="text">
                    </div>

                    <button id="btnSearch" class="function-button submit-button m-1">Search</button>
                </div>

            </div>


            <div style="overflow:auto; height:auto;">
                <ul>
                    <li style="list-style: none; margin-top:20px">

                        @Html.Partial("_FreshWaterReport")

                    </li>
                </ul>
            </div>
        </div>

    </div>
</div>

<script>
    function goBack() {
        window.history.back();
    }
</script>

<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').removeClass('active');
    $('#Menu6').removeClass('active');
    $('#Menu7').removeClass('active');
    $('#Menu8').addClass('active');
    $('#Menu9').removeClass('active');

</script>


<script>

    $("#btnSearch").click(function () {
        debugger

       /* var firstVal = $('#PortName option:selected').text();*/
        var firstVal = $("#idPortName").val();
        var secondVal = $("#idSecond").val();

        if (firstVal == "" && secondVal == "") {
            alert("Please enter atleast 1 value for search.");
            return;
        }
      
        else {

            $("#tblFreshWReport").html("");

            $.ajax({
                type: 'GET',
                url: '/Report/FreshWater/_FreshWaterReport?pageNo=1&firstVal=' + firstVal + '&S_val=' + secondVal,
                datatype: 'json',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                processData: false,
                success: function (data) {
                    if (data.trim() != "") {
                        // $("#tblBunkerReport").fadeIn("fast");
                        $("#FreshWReport").html("");
                        $("#FreshWReport").html(data);


                    }
                    else {
                        $("#FreshWReport").html("");
                        //  $("#tblBunkerReport").html('<div class="text-danger card-avatar text-center"><img class="imgnorecord" src="../Include/Admin/img/norecord.png"/><br/>no record found</div>');
                    }
                },
                error: function (data) {
                    $("#FreshWReport").html("");
                    $("#FreshWReport").html(data);
                }

            });
        }

    });

</script>

<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        flatpickr(".datetimePicker", {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
            time_24hr: true,
          
        });
    });

</script>