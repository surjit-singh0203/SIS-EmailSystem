<script type="text/javascript">
    function requiredValueHours(arg) {
        // debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 2) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }
        if (value > 24) {

            $("#" + id + "").val('');
        }

    }
</script>



<script type="text/javascript">
      function NonRoutineInsertion() {
          //alert("Check");
          debugger;
          var nonroutine = [];
          var table = document.getElementById("tblNonRoutineEvents");
              for (let j = 2, col; col = 8; j++) {
                  if (j == 9) {
                      break;
                  }
                  var NREvents = {};
                  NREvents.ChartererAccount = table.rows[j].cells[1].children[0].value;
                  NREvents.Hours = table.rows[j].cells[2].children[0].value;
                  nonroutine.push(NREvents);
              }
          nonroutine = JSON.stringify(nonroutine);

                $.ajax({
                    url: '@Url.Action("InsertNREvents", "Arrival")',
                    type: "POST",
                    data: { 'nonroutine': nonroutine },
                    dataType: "json",
                    beforeSend: function (x) {
                        if (x && x.overrideMimeType) {
                            x.overrideMimeType("application/j-son;charset=UTF-8");
                        }
                    },
                    success: function (result) {
                        debugger;
                        window.location.href = result;
                    }
                });
            }
</script>
<script>


    function GetNonRoutineEvents(id) {

        $.ajax({
            type: 'GET',
            url: '/Report/Arrival/GetNREvents?NoonReportId=' + id,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {

                    debugger;

                    var ChartererList = response.chrterer;
                    var HoursList = response.hrs;

                    var count = 0; var ss = ""; var ss1 = "";
                    var table = document.getElementById('tblNonRoutineEvents');

                    var j = 2;
                    $.each(ChartererList, function (index, value) {
                        ss1 = value;
                        table.rows[j].cells[1].children[0].value = ss1;
                        j++;
                    });
                    var k = 2;
                    $.each(HoursList, function (index, value) {
                        ss1 = value;
                        table.rows[k].cells[2].children[0].value = ss1;
                        k++;
                    });


                    var IdFirst = $("#IdFirst").val();
                    var IdSecond = $("#IdSecond").val();
                    var IdThird = $("#IdThird").val();
                    var IdFourth = $("#IdFourth").val();
                    var IdFifth = $("#IdFifth").val();
                    var IdSixth = $("#IdSixth").val();
                    var IdSeventh = $("#IdSeventh").val();



                    if (IdFirst != 0) {
                        $("#StopageAtSea").prop("disabled", false);
                        $("#StopageAtSea1").prop("disabled", false);
                    }
                    if (IdSecond != 0) {
                        $("#Deviation").prop("disabled", false);
                        $("#Deviation1").prop("disabled", false);
                    }
                    if (IdThird != 0) {
                        $("#SlowSteaming").prop("disabled", false);
                        $("#SlowSteaming1").prop("disabled", false);
                    }
                    if (IdFourth != 0) {
                        $("#BadWeather").prop("disabled", false);
                        $("#BadWeather1").prop("disabled", false);
                    }
                    if (IdFifth != 0) {
                        $("#COTPrep").prop("disabled", false);
                        $("#COTPrep1").prop("disabled", false);
                    }
                    if (IdSixth != 0) {
                        $("#CargoHeating").prop("disabled", false);
                        $("#CargoHeating1").prop("disabled", false);
                    }
                    if (IdSeventh != 0) {
                        $("#BWExchange").prop("disabled", false);
                        $("#BWExchange1").prop("disabled", false);
                    }
                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });
    }
</script>
<script>
    function sleep(milliseconds) {
        const date = Date.now();
        let currentDate = null;
        do {
            currentDate = Date.now();
        } while (currentDate - date < milliseconds);
    }
</script>
