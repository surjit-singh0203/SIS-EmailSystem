        //alert(portName);



        $.ajax({
            type: 'GET',
            url: '/Report/Arrival/BindLeg?Voyid=' + Voyid,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    $('#LegPortId').empty();


                    $('#cpid').val(response.CPID);
                    // alert(ddd);

                    debugger;
                    $('#LegPortId').append('<option value="">None Selected</option>');
                    for (var i = 0; i < response.Data.length; i++) {
                        debugger;
                        var txt = response.Data[i].Text;
                        var valu = response.Data[i].Value;
                        // alert(txt);
                        $('#LegPortId').append('<option value="' + valu + '">' + txt + '</option>');

                    }
                    // $('#RankId').append('<option value="">Other</option>');
                    $("#LegPortId option[value=" + legportid + "]").attr('selected', 'selected');
                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });




    };
