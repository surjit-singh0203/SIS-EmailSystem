        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 2) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }
        if (value > 26) {

            $("#" + id + "").val('0.00');
            $("#msgStmgTime").text("Stmg time can not greater than 26 hrs. ");
        }
        else {
            $("#msgStmgTime").text('');
        }

    }
</script>
<script type="text/javascript">
    function requiredValueDFT(arg) {
        // debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 1000) /
                    1000).toFixed(3);
            }
        }
        if (value > 30) {

            $("#" + id + "").val('');
        }

    }
</script>



<script>




    function GetARCargo() {

        var LegId = $("#LegPortId option:selected").val();
        var VoyageId = $("#VoyageId option:selected").val();

        $.ajax({
            type: 'GET',
            /*url: '/Report/Arrival/GetARCargo?LegId=' + LegId + '&VoyageId=' + VoyageId,*/
            url: '/Report/Arrival/GetAR_Cargo?LegId=' + LegId + '&VoyageId=' + VoyageId,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {

                    var CNameList = response.cn;

                    var rowCount = CNameList.length;

                    debugger;
                    var table = document.getElementById('tblCargo');


                    if (rowCount == 0) {

                        $("#tblCargo").find("tr:gt(" + rowCount + 2 + ")").remove();
                        //return;



                        //ss = value;
                        table.rows[2].cells[0].innerHTML = "";
                        table.rows[2].cells[1].children[0].value = '0.00';
                        table.rows[2].cells[2].children[0].value = '0.00';
                        table.rows[2].cells[3].innerHTML = "";



                    }

                    //for (var i = rowCount - 2; i > 0; i--) {
                    //    tblCargo.deleteRow(i);
                    //}


                    //alert(rowCount);
                    if (rowCount > 0) {

                        var rows = table.getElementsByTagName('tr');
                        if (rows.length > 2) {
                            rows.length = -2;
                        }

                        for (var i = rows.length - 1; i > 2; i--) {
                            table.deleteRow(i);
                        }

                        $('#tblCargo').css('display', 'table');

                        let len = rowCount;

                        //alert(len);
                        //for (let i = 2; i <= len; i++) {

                        //    var $tableBody = $('#tblCargo').find("tbody"),
                        //        $trLast = $tableBody.find("tr:last"),
                        //        $trNew = $trLast.clone();
                        //         $trLast.after($trNew);
                        //            }

                        for (let i = 1; i <= len - 1; i++) {

                            var $tableBody = $('#tblCargo').find("tbody"),
                                $trLast = $tableBody.find("tr:last"),
                                $trNew = $trLast.clone();

                            $trLast.after($trNew);

                            $trNew.find(".check-decimal").on("keypress", function (event) {
                                var charCode = (event.which) ? event.which : event.keyCode;
                                var value = $(this).val();

                                if (charCode == 46 && value.indexOf('.') != -1) {
                                    return false;
                                }

                                if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
                                    return false;
                                }

                                var finalValue = value + String.fromCharCode(charCode);
                                var validDecimal = /^\d*\.?\d{0,3}$/;

                                if (!validDecimal.test(finalValue)) {
                                    return false;
                                }

                                if (finalValue.length > 6) {
                                    return false;
                                }

                                return true;
                            });

                        }
                    } else {
                        $('#tblCargo').css('display', 'none');
                    }


                    var count = 0; var ss = ""; var ss1 = ""; var ss2 = "";


                    var j = 2;
                    $.each(CNameList, function (index, value) {

                        ss = value;
                        table.rows[j].cells[0].innerHTML = ss;
                        j++;
                    });


                    //try {
                    //    for (var i = rowCount + 3; i > 0; i++) {
                    //        tblCargo.deleteRow(i);
                    //    }
                    //} catch { }


                    /*   $("#tblCargo").find("tr:gt(" + rowCount-1 + ")").remove();*/

                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });
    }





</script>


