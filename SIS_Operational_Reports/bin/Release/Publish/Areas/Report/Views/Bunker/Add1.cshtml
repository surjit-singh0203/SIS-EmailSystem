<script>

    //  Add

    $("#Supplier").on("input", function () {
        if ($(this).val().length > 200) {
            $(this).val($(this).val().substring(0, 200));
            alert('Only 200 characters are allowed.');
            return;
        }
    });

    $("#BargeName").on("input", function () {
        if ($(this).val().length > 100) {
            $(this).val($(this).val().substring(0, 100));
            alert('Only 100 characters are allowed.');
            return;
        }
    });

    $("#Remarks").on("input", function () {
        if ($(this).val().length > 500) {
            $(this).val($(this).val().substring(0, 500));
            alert('Only 500 characters are allowed.');
            return;
        }
    });

    $(".alpha").on("input", function () {
        this.value = this.value.replace(/[^a-zA-Z\s]/g, "");
    });

    $('#BDN').on('input', function () {
        debugger
        var value = $(this).val();
        if (!/^\d*\.?\d{0,3}$/.test(value)) {
            $(this).val(value.substring(0, value.length - 1));
        }
    });

    $('#Fuel_Density').on('input', function () {
        debugger
        var value = $(this).val();
        if (!/^\d*\.?\d{0,3}$/.test(value)) {
            $(this).val(value.substring(0, value.length - 1));
        }
    });

    $('#Sulphur_content').on('input', function () {
        debugger
        var value = $(this).val();
        if (!/^\d*\.?\d{0,3}$/.test(value)) {
            $(this).val(value.substring(0, value.length - 1));
        }
    });

    //$('#BDN_Number').on('input', function () {
    //    this.value = this.value.replace(/[^a-zA-Z0-9]/g, '');
    //});

    $("#BDN_Number").on('input', function () {
        var value = $(this).val();
        var newValue = value.replace(/[^a-zA-Z0-9!@@#$%^&*(),.?":{}|<>]/g, '');
        $(this).val(newValue);
    });


    //  Edit

    $(".check-decimal").on("keypress", function (event) {
        var charCode = (event.which) ? event.which : event.keyCode;
        var value = $(this).val();

        // Check for '.' and ensure there's only one
        if (charCode == 46 && value.indexOf('.') != -1) {
            return false;
        }

        // Allow only backspace, delete, and numeric values
        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }

        // Check for valid decimal values (e.g., .333, 0.963, 2.333)
        var finalValue = value + String.fromCharCode(charCode);
        var validDecimal = /^\d*\.?\d{0,3}$/; // allow up to 3 decimal places

        if (!validDecimal.test(finalValue)) {
            return false;
        }

        return true;
    });


    $(".check-AlphaNumeric").on("input", function () {
        this.value = this.value.replace(/[^a-zA-Z0-9!@@#$%^&*(),.?":{}|<>]/g, '');
    });


</script>


