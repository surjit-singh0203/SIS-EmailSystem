<script>

    function checkFileSize(input) {
        debugger

        if (input.files.length > 0) {
            const fileSize = input.files[0].size; // in bytes
            const maxSize = 200 * 1024; // 200KB in bytes
            const fileType = input.files[0].type;

            if (fileSize > maxSize) {
                alert("File size exceeds 200KB. Please select a smaller file.");
                input.value = ""; // Clear the input
            }

            const allowedTypes = ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/csv", "image/jpeg", "image/jpg", "image/png"];

            if (!allowedTypes.includes(fileType)) {
                alert("Only PDF, Word, Excel, JPG, and PNG files are allowed. Please select a valid file.");
                input.value = "";
                return;
            }

        }
    }

