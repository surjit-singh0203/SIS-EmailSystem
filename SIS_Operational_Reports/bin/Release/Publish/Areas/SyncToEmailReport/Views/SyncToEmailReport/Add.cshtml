
@{
    ViewBag.Title = ViewBag.EditId != null ? "Edit Sync Email" : "Add Sync Email";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@model DataBuildingLayer.ExportPeram2

@if (TempData["success"] != null)
{
    <h6 class="text-success">@TempData["success"]</h6>
}

@if (TempData["error"] != null)
{
    <h6 class="text-danger">@TempData["error"]</h6>
}

<fieldset class="sync-email-fieldset">
    <legend>@(ViewBag.EditId != null ? "Edit Sync Email" : "Add Sync Email")</legend>

    @using (Html.BeginForm("Add", "SyncToEmailReport", new { area = "SyncToEmailReport" }, FormMethod.Post, new { id = "frmAdd" }))
    {
        <input type="hidden" name="Id" id="Id" value="@(ViewBag.EditId ?? 0)" />

        <div class="sync-email-content row">

            <div class="col-md-6 form-group">
                <label for="VesselId">Vessel Name</label>
                <div>
                    @Html.DropDownList("VesselId", new SelectList(Model.VesselList, "Value", "Text", ViewBag.VesselId as string), "Select vessel", new { @class = "form-control select2" })
                    <span id="messageVoyid" style="color:red"></span>
                </div>
            </div>

            <div class="col-sm-12 form-group email-title">
                <label><strong>Email</strong></label>
            </div>

            <div class="col-sm-12 form-group">
                <label for="emailTo">To</label>
                <div class="email-tag-container form-control" id="emailToContainer">
                    <span class="email-tags" id="emailToTags"></span>
                    <input type="text" id="emailTo" class="email-tag-input" placeholder="Type email and press , or Enter" autocomplete="off" />
                </div>
                <input type="hidden" id="emailToValues" name="EmailTo" value="@Html.AttributeEncode((string)(ViewBag.EmailTo ?? ""))" />
            </div>

            <div class="col-sm-12 form-group">
                <label for="emailCc">CC</label>
                <div class="email-tag-container form-control" id="emailCcContainer">
                    <span class="email-tags" id="emailCcTags"></span>
                    <input type="text" id="emailCc" class="email-tag-input" placeholder="Type email and press , or Enter" autocomplete="off" />
                </div>
                <input type="hidden" id="emailCcValues" name="EmailCC" value="@Html.AttributeEncode((string)(ViewBag.EmailCC ?? ""))" />
            </div>

            <div class="col-md-12 form-group save-btn">
                <input type="hidden" name="CreatedBy" value="Admin" />
                <input type="hidden" name="ModifiedBy" value="Admin" />
                <button type="submit" class="btn peach-btn btn-info">@(ViewBag.EditId != null ? "Update" : "Save")</button>
                <a href="@Url.Action("Index", "SyncToEmailReport", new { area = "SyncToEmailReport" })" class="btn btn-cancel">Cancel</a>
            </div>

        </div>
    }
</fieldset>


<style>
    .sync-email-fieldset {
        width: 100%;
        min-width: 400px;
        padding: 25px;
        margin: 20px 0;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
    }

    .sync-email-fieldset legend {
        width: auto;
        padding: 0 8px;
        margin-left: 5px;
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
    }

    .sync-email-content .form-group { margin-bottom: 18px; }
    .sync-email-fieldset label { font-weight: 600; font-size: 14px; color: #34495e; margin-bottom: 6px; }
    .sync-email-fieldset .form-control { border-radius: 6px; border: 1px solid #dcdfe6; padding: 8px 10px; font-size: 14px; }
    .sync-email-fieldset .form-control:focus { border-color: #3498db; box-shadow: 0 0 0 2px rgba(52,152,219,0.15); }
    .sync-email-fieldset .select2-container { width: 100% !important; }

    .email-tag-container {
        display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
        padding: 6px 10px; min-height: 40px; border-radius: 6px;
        border: 1px solid #dcdfe6; background: #ffffff;
    }
    .email-tag-input { border: none; outline: none; flex: 1; min-width: 150px; font-size: 14px; }
    .email-tag { display: inline-flex; align-items: center; background: #3498db; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 13px; gap: 6px; }
    .email-tag-remove { cursor: pointer; font-weight: bold; opacity: 0.9; }
    .email-tag-remove:hover { opacity: 1; }
    .email-title { margin-top: 10px; }
    .save-btn { margin-top: 10px; }

    .btn-cancel {
        padding: 8px 20px; margin-left: 10px; background: #95a5a6; color: #fff;
        border: none; border-radius: 6px; font-size: 14px; text-decoration: none; display: inline-block;
    }
    .btn-cancel:hover { color: #fff; background: #7f8c8d; }
</style>

<script type="text/javascript">
    function isValidEmail(email) {
        var re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        return re.test(email);
    }

    function initEmailTagInput(inputId, tagsId, valuesId) {
        var $input = $('#' + inputId);
        var $tagsContainer = $('#' + tagsId);
        var $valuesInput = $('#' + valuesId);
        var validationBlocked = false;

        if ($input.data('email-tag-initialized')) return;
        $input.data('email-tag-initialized', true);

        function addTag(email) {
            if (validationBlocked) return;
            email = email.trim().toLowerCase();
            if (!email) return;
            if (!isValidEmail(email)) { $input.val(''); validationBlocked = true; alert('Please enter a valid email address: ' + email); setTimeout(function () { validationBlocked = false; }, 300); return; }
            var existing = $tagsContainer.find('.email-tag').map(function () { return $(this).data('email'); }).get();
            if (existing.indexOf(email) !== -1) { $input.val(''); validationBlocked = true; alert('This email is already added.'); setTimeout(function () { validationBlocked = false; }, 300); return; }
            var escapedEmail = $('<div>').text(email).html();
            var $tag = $('<span class="email-tag"><span class="email-tag-text">' + escapedEmail + '</span><span class="email-tag-remove">&times;</span></span>');
            $tag.data('email', email);
            $tag.find('.email-tag-remove').click(function () { $(this).closest('.email-tag').remove(); updateValues(); });
            $tagsContainer.append($tag);
            $input.val('');
            updateValues();
        }

        function updateValues() {
            var emails = $tagsContainer.find('.email-tag').map(function () { return $(this).data('email'); }).get();
            $valuesInput.val(emails.join(','));
        }

        var skipBlur = false;
        $input.off('keydown.emailTag keyup.emailTag blur.emailTag')
            .on('keydown.emailTag', function (e) {
                if (e.which === 13 || e.which === 188) e.preventDefault();
                else if (e.which === 8 && !$(this).val() && $tagsContainer.find('.email-tag').length) {
                    e.preventDefault();
                    $tagsContainer.find('.email-tag').last().remove();
                    updateValues();
                }
            })
            .on('keyup.emailTag', function (e) {
                if (e.which === 13 || e.which === 188) {
                    skipBlur = true;
                    var val = $(this).val().replace(',', '').trim();
                    if (val) addTag(val);
                    setTimeout(function () { skipBlur = false; }, 300);
                }
            })
            .on('blur.emailTag', function () {
                if (skipBlur) return;
                var val = $(this).val().trim();
                if (val) addTag(val);
            });
    }

    function setEmailTags(containerId, valuesId, emails) {
        var arr = emails ? emails.split(',').map(function (e) { return e.trim(); }).filter(Boolean) : [];
        var $tags = $('#' + containerId);
        var $values = $('#' + valuesId);
        $tags.empty();
        function updateValues() {
            var ems = $tags.find('.email-tag').map(function () { return $(this).data('email'); }).get();
            $values.val(ems.join(','));
        }
        for (var i = 0; i < arr.length; i++) {
            var email = arr[i];
            var escapedEmail = $('<div>').text(email).html();
            var $tag = $('<span class="email-tag"><span class="email-tag-text">' + escapedEmail + '</span><span class="email-tag-remove">&times;</span></span>');
            $tag.data('email', email);
            $tag.find('.email-tag-remove').click(function () { $(this).closest('.email-tag').remove(); updateValues(); });
            $tags.append($tag);
        }
        updateValues();
    }

    $(function () {
        initEmailTagInput('emailTo', 'emailToTags', 'emailToValues');
        initEmailTagInput('emailCc', 'emailCcTags', 'emailCcValues');

        var editId = @(ViewBag.EditId != null ? ViewBag.EditId : 0);
        var emailTo = $('#emailToValues').val() || '';
        var emailCC = $('#emailCcValues').val() || '';

        if (editId > 0) {
            $('#Id').val(editId);
            setEmailTags('emailToTags', 'emailToValues', emailTo);
            setEmailTags('emailCcTags', 'emailCcValues', emailCC);
        }

        $('#frmAdd').submit(function () {
            var vesselId = $('#VesselId').val();
            var toVal = $('#emailToValues').val();

            if (!vesselId) {
                alert('Please select a vessel.');
                return false;
            }
            if (!toVal || toVal.trim() === '') {
                alert('Please add at least one email in To.');
                return false;
            }
            return true;
        });
    });
</script>
