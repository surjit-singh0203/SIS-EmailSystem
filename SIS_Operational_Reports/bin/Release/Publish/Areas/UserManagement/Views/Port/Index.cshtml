@*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>*@


<div id="iduser">




    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px; margin-top: 10px;">
        <div class="col-md">
            <h2>
                Port Management
            </h2>

        </div>
        @if (TempData["Error"] != null)
        {
            <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
        }
        @if (TempData["Success"] != null)
        {
            <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
        }
        @if (StaticHelper.UserRole == "Administrator")
        {
            <div class="col-md button-row-top">
                <button type="button" class="btn btn-info btn-lg" data-toggle="modal" data-target="#myModal">Export List</button>
                @*<a class="btn btn-info m-1" href="@Url.Action("AddPort", "Port")"> Export Port List </a>*@
                <a class="btn btn-info m-1" href="@Url.Action("AddPort", "Port")"> Add Port </a>

            </div>
        }
    </div>


    <div class="modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    @*<button type="button" class="close" data-dismiss="modal">&times;</button>*@
                    <h4 class="modal-title">Export Port</h4>
                </div>
                <div class="modal-body">
                    @using (Html.BeginForm("ExportPort", "Port", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="wrapper wrapper-content">
                            <div class="container">




                                <div class="row form-group ">
                                    @*<label class="col-sm-12 col-form-label">*@
                                    <label class="control-label">Port List<sup></sup></label>
                                    @*</label>*@
                                    <div class="col-sm-12">

                                        @Html.DropDownListFor(model => model.PortIDs, new SelectList(Model.PortList, "Value", "Text"), new { @class = "form-control multiple-reason", @multiple = "multiple", })


                                    </div>




                                    <br />
                                    <br /><br />
                                    <br />

                                    <div class="table-responsive">


                                        <button type="submit" id="btnExport" class="function-button submit-button m-1">Export</button>

                                    </div>
                                </div>
                            </div>
                        </div>


                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>

        </div>
    </div>



    <div class="wrapper wrapper-content">
        <div class="container">

            <div class="search-row">
                <div class="col m-1">

                    <input id="idFirst" autocomplete="off" placeholder="search by : port name & country name" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div style="display:none" class="col m-1">

                    <input id="idSecond" autocomplete="off" name="datefilter" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text">
                    <span id="messageLat" style="color:red"></span>
                </div>

                <button id="btnSearch" class="function-button submit-button m-1">Search</button>
            </div>

            <div class="table-responsive">



                <table class="GeneratedTable centered-table">
                    <thead>
                        <tr>
                            <th style="display:none">Id</th>
                            <th>Country Name</th>
                            <th>Port Name</th>

                            <th>Facility Name</th>


                            <th>Longitude</th>
                            <th>Latitude</th>
                            @if (StaticHelper.UserRole == "Administrator")
                            {

                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>



                        @foreach (var item in Model.GetPortList)
                        {


                        <tr>
                            <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>

                            <td> @Html.DisplayFor(modelItem => item.CountryName)</td>
                            <td> @Html.DisplayFor(modelItem => item.PortName)</td>
                            <td> @Html.DisplayFor(modelItem => item.FacilityName)</td>
                            <td> @Html.DisplayFor(modelItem => item.Longitude) </td>
                            <td> @Html.DisplayFor(modelItem => item.Latitude) </td>

                            @if (StaticHelper.UserRole == "Administrator")
                            {

                                <td>

                                    <div class="row button-row">
                                        <div class="col table-button-container">
                                            <button type="button" class="function-button table-button">
                                                <a href="@Url.Action("Edit", "Port", new { id = item.Id })" class="function-button table-button">
                                                    Edit
                                                </a>
                                            </button>
                                        </div>

                                        <div class="col table-button-container">
                                            <button type="button" class="function-button table-button">
                                                @Html.ActionLink("Delete", "Delete", "Port", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                            </button>
                                        </div>
                                    </div>


                                </td>
                            }
                        </tr>
                        }


                    </tbody>
                </table>

                @{
                    var recCnt = "";
                    if (Model.GetPortList.Count == 0)
                    {
                        recCnt = "No Record Found !";
                    }
                }
                <p style="font-weight:bold; color:red"> @recCnt </p>

                <nav aria-label="Page navigation example">
                    <ul class="pagination">


                        @{
                            int totalRecords = 0;
                            foreach (var item in Model.GetPortList)
                            {
                                totalRecords = item.TotalCount;
                                break;
                            }
                            //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                            // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                            //int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                            int pageSize = 20;

                            int tot_pages = totalRecords / pageSize;
                            int remainder = totalRecords % pageSize;

                            tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                            int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                            if (totalRecords > 0)
                            {
                                if (currPage == 0)
                                {
                                    currPage = 1;
                                }

                                if (currPage != 1)
                                {
                                    <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "index", "Port", new { pageNo = 1 }, null)</a></li>
                                }

                                if (currPage != tot_pages)
                                {
                                    for (int cnt = currPage; cnt < (currPage + 20); cnt++)
                                    {
                                        if (cnt == currPage)
                                        {
                                            <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item">@Html.ActionLink(cnt.ToString(), "index", "Port", new { pageNo = cnt }, null)</li>
                                        }

                                        if (cnt == tot_pages)
                                        {
                                            break;
                                        }
                                    }
                                }


                                if (currPage == tot_pages)
                                {
                                    <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                                }
                                else
                                {
                                    <li class="page-item">@Html.ActionLink("Last", "index", "Port", new { pageNo = tot_pages }, null)</li>
                                }
                            }
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>





