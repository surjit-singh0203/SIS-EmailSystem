@model DataBuildingLayer.UserDetail
@{
    ViewBag.Title = "EditUser";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<h2>Edit User</h2>
@using (Html.BeginForm("Edit", "User", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
<div class="page-heading page-header-flex">
    <div>
       
        @*<ol class="breadcrumb">
            <li><a href="">Home</a></li>
            <li><a href="">Form</a></li>
            <li><a>Create</a></li>
        </ol>*@
    </div>

    @if (TempData["Error"] != null)
    {
    <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
    }
    @if (TempData["Success"] != null)
    {
    <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
    }

    <div class="form-actions">
        <button name="Submit" type="submit" class="btn btn-success btn-width"><i class="uil uil-check mr-2"></i>Submit</button>
        <button name="Reset" type="reset" id="btnReset" class="btn btn-danger btn-width"><i class="uil uil-redo mr-2"></i>Reset</button>
        @*<button name="back" style="display:none" id="btnBack" onclick="goBack()" class="btn btn-danger btn-width"> << Back</button>*@
        <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width"> << Go Back</a>
    </div>
</div>
<div class="wrapper wrapper-content">
    <div class="container">

        <div class="form-body">
            <div class="row">
                <div class="col-md-8 mx-auto">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">User Type<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">

                            @Html.DropDownListFor(model => model.DepId, new SelectList(Model.DepartmentWiseUserRole, "Value", "Text", Model.EditUser.DepId), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", @onchange = "GetRanks(this)" })

                            <div class="error"></div>
                        </div>
                    </div>
                    <div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">User Name<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">

                            @Html.DropDownListFor(model => model.UserName, new SelectList(Model.RankList, "Value", "Text", Model.EditUser.UserEmail), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })

                            <div class="error"></div>
                        </div>
                    </div>
                    <div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">Full Name<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control", @required = "true", @maxlength = 100 } })
                            @*<div class="error"></div>*@
                            <span id="messageDia"></span>
                        </div>
                    </div>
                    @*<div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">Email / User name<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.UserEmail, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control", @readonly = "true",  @type = "email" } })
                            @Html.ValidationMessageFor(model => model.UserEmail, "", new { @class = "text-danger" })
                        </div>
                    </div>*@

                    @*<div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">Password<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @type = "Password", @class = "form-control", @required = "true" } })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                            <span id="messageDia"></span>
                        </div>
                    </div>
                    <div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">Confirm Password<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @type = "Password", @class = "form-control", @required = "true" } })
                            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                            <span id="messageDia"></span>
                        </div>
                    </div>*@
                    @*<div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">User Type<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">

                            @Html.DropDownListFor(model => model.UserType, new SelectList(Model.UserTypeList, "Value", "Text", Model.EditUser.UserType), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })


                        </div>
                    </div>*@
                    <div class="row form-group ">
                        <label class="col-sm-4 col-form-label">
                            <label class="control-label">Assign Vessel<sup>*</sup></label>
                        </label>
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.VesselID, new SelectList(Model.VesselList, "Value", "Text", Model.VesselID), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })

                            @*@Html.TextBoxFor(x => x.ServiceTo, "{0:yyyy-MM-dd}", new { @class = "form-control", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @type = "date", @onkeydown = "return false", @required = "true" })
                            <div class="error"></div>*@
                        </div>
                    </div>



                </div>
            </div>
        </div>

    </div>
</div>


<script>
    function GetRanks(t) {
        debugger;
        var Id = t.value;
        var portName = $("#DepId option:selected").val();
        //alert(portName);


        $.ajax({
            type: 'GET',
            url: '/UserManagement/User/GetRanks?Did=' + portName,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    $('#UserName').empty();
                    //alert(433);
                    debugger;
                    $('#UserName').append('<option value="">None Selected</option>');
                    for (var i = 0; i < response.Data.length; i++) {
                        debugger;
                        var txt = response.Data[i].Text;
                        var valu = response.Data[i].Value;
                       // alert(txt);
                        $('#UserName').append('<option value="' + valu + '">' + txt + '</option>');

                    }
                   // $('#RankId').append('<option value="">Other</option>');

                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });

