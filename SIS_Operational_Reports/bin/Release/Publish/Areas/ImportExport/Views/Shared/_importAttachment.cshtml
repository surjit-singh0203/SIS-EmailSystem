<script type="text/javascript">

  
    $('#ImportAttachment').click(function () {debugger
  
        var fp = $("#zipSelector");
        var lg = fp[0].files.length;
        var items = fp[0].files;
        var fileSize = 0;
  
        var fileName = document.querySelector('#zipSelector').value;
  
        if (!fileName.endsWith('.zip')) {
            alert('Please upload zip folder only.');
            document.getElementById("zipSelector").value = null;
            return false;
        }
        else
        {
         
            var formData = new FormData();
            var files = $('#zipSelector')[0].files;
  
            for (var i = 0; i < files.length; i++) {
               formData.append('files', files[i]);
            }

            $.ajax({
                type: "POST",
                url: "/ImportExport/ImportExport/UploadZip",
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.success == true) {
                        alert(data.message);
                    }

                    if (data.success == false) {
                        alert(data.message);
                    }

                }
            });
         
        }
  
    });
  
  
</script>

