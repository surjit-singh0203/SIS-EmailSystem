            processData: false,
            success: function (response) {

                if (response.Result === true) {
                    // $('#NextLegPortId').empty();
                    $('#LegPortId').empty();
                    //debugger;
                    //$('#NextLegPortId').append('<option value="">None Selected</option>');
                    //for (var i = 0; i < response.Data.length; i++) {
