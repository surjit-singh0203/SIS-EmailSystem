<script>
    function GetLeg(t) {

        var Id = t.value;
        var Voyid = $("#VoyageId option:selected").val();
        //alert(portName);


        $.ajax({
            type: 'GET',
            url: '/Report/Loading/BindLeg?Voyid=' + Voyid,
