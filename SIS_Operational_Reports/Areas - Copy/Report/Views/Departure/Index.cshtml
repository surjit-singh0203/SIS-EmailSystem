<div class="row" style="margin-top: 10px;">


    <div class="col-md">

        <div class="mb-3 row">
            
           
            <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @onchange = "GetLeg(this);Getfuelcons5(this)", @required = "true", })
                <span id="messageVoyid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Next Leg</label>
            <div class="col-sm-8">
                @*@Html.DropDownListFor(model => model.NextLegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", @onchange = "GetDisByLeg1(this)", })
                    <span id="msgLegPortId" style="color:red"></span>*@


