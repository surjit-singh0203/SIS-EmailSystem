            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Vessel Name</label>
            <div class="col-sm-8">
                @Html.DisplayFor(model => model.VesselName)
            </div>
        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Dep. Port</label>
