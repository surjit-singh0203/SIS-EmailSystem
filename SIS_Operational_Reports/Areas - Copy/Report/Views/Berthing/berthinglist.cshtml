@model DataBuildingLayer.BerthingReport
@{
    ViewBag.Title = "berthinglist";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div id="berthing">
    <div class="row" style="margin-top: 10px;">

        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div class="col-md">
                <h2>Berthing-Report List</h2>
            </div>

            @*@if (TempData["Error"] != null)
            {
                <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
            }
            @if (TempData["Success"] != null)
            {
                <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
            }

            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">
                        <button class="function-button submit-button">
                            <a class="function-button submit-button" href="@Url.Action("Index", "Berthing")">
                                <i class="fa fa-plus-circle mr-2"></i>Add Berthing Report
                            </a>
                        </button>
                    </div>
                    <div class="col">
                        <button name="back" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>

                    </div>
                </div>
            </div>*@

        </div>

    </div>


    <div class="container">
        <div class="row">
        

            <!-- CSS Code: Place this code in the document's head (between the 'head' tags) -->
            <div class="mb-lg-1 row">
                <div style="margin-left:550px" class="col-sm-3">

                    <input id="idFirst" placeholder="serch by : voyage no." autocomplete="off" class="form-control" type="text" />
                    <span id="messageLat" style="color:red"></span>
                </div>

                <div class="col-sm-3">

                    <input id="idSecond" name="datefilter" autocomplete="off" placeholder="yyyy-mm-dd - yyyy-mm-dd" class="form-control" type="text" />
                    <span id="messageLat" style="color:red"></span>
                </div>


                <div class="col-md button-row-top">
                    <div class="row">
                        <div class="col">
                            <button id="btnSearch" class="function-button submit-button">

                                <i class="fa fa-plus-circle mr-2"></i>Search

                            </button>
                        </div>

                    </div>
                </div>

            </div>

            <table class="GeneratedTable">
                <thead>
                    <tr>
                        <th style="display:none">Id</th>
                        <th>Voyage No.</th>
                        <th>PortName</th>
                        <th>Facilty Name</th>
                        <th>Berth Name</th>

                        <th>Status</th>
                        <th>Submit Date</th>
                        <th>Action</th>


                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.GetBerthRList)
                    {


                    <tr>
                        <td style="display:none"> @Html.DisplayFor(modelItem => item.Id)</td>
                        <td> @Html.DisplayFor(modelItem => item.voyagenumber)</td>
                        <td> @Html.DisplayFor(modelItem => item.PortName)</td>
                        <td> @Html.DisplayFor(modelItem => item.FacilityName)</td>
                        <td> @Html.DisplayFor(modelItem => item.BerthName)</td>

                        <td>

                            @{ var svd = item.SaveDraft;
                                                if (svd == true)
                                                {
                                @Html.Raw("Draft") }
                                                else
                                                {
                                @Html.Raw("Submit") } }
                        </td>
                        <td>
                            @{ DateTime? cdt = item.CreatedDate;
                                                if (cdt != null)
                                                {
                                @Html.Raw(cdt.Value.ToString("dd-MMM-yyyy")) } }
                        </td>

                        <td>

                            <div class="row button-row">
                                <div class="col table-button-container">
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("View Detail", "Edit", "Berthing", new { id = item.Id }, new { onclick = "" })
                                    </button>
                                </div>
                                @*<div class="col table-button-container">
                                    <button type="button" class="function-button table-button">
                                        @Html.ActionLink("Delete", "Delete", "Berthing", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this entry?');" })
                                    </button>
                                </div>*@
                            </div>

                        </td>


                    </tr>
                    }


                </tbody>
            </table>
            <!-- Codes by Quackit.com -->

            <nav aria-label="Page navigation example">
                <ul class="pagination">


                    @{
                        int totalRecords = 0;
                        foreach (var item in Model.GetBerthRList)
                        {
                            totalRecords = item.TotalCount;
                            break;
                        }
                        //int totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));
                        // totalRecords = Convert.ToInt32(TempData.Peek("TotalRecords"));

                        int pageSize = SIS_Operational_Reports.Common.CommonMethods.PAGESIZE;

                        int tot_pages = totalRecords / pageSize;
                        int remainder = totalRecords % pageSize;

                        tot_pages = remainder > 0 ? (tot_pages + 1) : tot_pages;

                        int currPage = Convert.ToInt32(TempData.Peek("CurrentPage"));

                        if (totalRecords > 0)
                        {
                            if (currPage == 0)
                            {
                                currPage = 1;
                            }

                            if (currPage != 1)
                            {
                                <li class="page-item"><a class="page-link"> @Html.ActionLink("First", "berthinglist", "Berthing", new { pageNo = 1 }, null)</a></li>
                            }

                            if (currPage != tot_pages)
                            {
                                for (int cnt = currPage; cnt < (currPage + 10); cnt++)
                                {
                                    if (cnt == currPage)
                                    {
                                        <li class="page-item active"><a class="page-link" href="#">@cnt</a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item">@Html.ActionLink(cnt.ToString(), "berthinglist", "Berthing", new { pageNo = cnt }, null)</li>
                                    }

                                    if (cnt == tot_pages)
                                    {
                                        break;
                                    }
                                }
                            }


                            if (currPage == tot_pages)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@tot_pages</a></li>
                            }
                            else
                            {
                                <li class="page-item">@Html.ActionLink("Last", "berthinglist", "Berthing", new { pageNo = tot_pages }, null)</li>
                            }
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>
<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').addClass('active');
    $('#Menu6').removeClass('active');
    $('#Menu7').removeClass('active');

</script>

<script type="text/javascript">
    $(function () {

        $('input[name="datefilter"]').daterangepicker({
            autoUpdateInput: false,
            locale: {
                cancelLabel: 'Clear'
            }
        });

        $('input[name="datefilter"]').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('YYYY/MM/DD') + ' - ' + picker.endDate.format('YYYY/MM/DD'));
        });

        $('input[name="datefilter"]').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });

    });
</script>

<script>
    $("#btnSearch").click(function () {
        var firstVal = $("#idFirst").val();
        var secondVal = $("#idSecond").val();
        var dateF = $('#idSecond').data('daterangepicker').startDate.format('YYYY-MM-DD');
        var dateT = $('#idSecond').data('daterangepicker').endDate.format('YYYY-MM-DD');
        if (secondVal == "") {
            dateF = "";
            dateT = "";
        }

        if (firstVal == "" && secondVal == "") {
            alert("Please enter atleast 1 value for search.");
            return;
        }
        else {


            $.ajax({
                type: 'GET',
                url: '/Report/Berthing/berthinglist?pageNo=1&firstVal=' + firstVal + '&dateF=' + dateF + '&dateT=' + dateT,
                datatype: 'json',
                cache: false,
                contentType: 'application/json; charset=utf-8',
                processData: false,
                success: function (data) {

                    $("#berthing").html('');
                    $("#berthing").html(data);

                },
            });
        }
    });

</script>