        </tbody>
        <tfoot>
            <tr>

                @*<td>
                        @Html.DropDownListFor(model => model.VesselID, new SelectList(Model.VesselList, "Value", "Text"), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })
                    </td>*@
                @*<td><input type="text" id="txtSpeed" /></td>
                    <td><input type="text" id="txtME_LADEN" /></td>
                    <td><input type="text" id="txtME_BALLAST" /></td>
                    <td><input type="text" id="txtAE_VLSFO" /></td>*@
                <td>
                </td>
                <td>
                    @Html.DropDownListFor(model => model.VesselID, new SelectList(Model.VesselList, "Value", "Text"), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })
                </td>
                <td>@Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @placeholder = "yyyy-mm-dd", @autocomplete = "off", @type = "date", @onkeydown = "return false", @required = "true" })</td>
