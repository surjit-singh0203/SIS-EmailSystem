                <tr>
                    <td>@customer3.Consumption</td>
                    <td>@customer3.AE_VLSFO</td>
                    <td>@customer3.AE_MDO</td>
                    <td>@customer3.BOILER_MDO</td>

                    <td><input id="button3" type="button" value="Remove" onclick="Remove3(this)" /></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td><input type="text" id="txtConsumption" /></td>
                <td><input type="text" id="txtOAE_VLSFO" /></td>
                <td><input type="text" id="txtAE_MDO" /></td>
                <td><input type="text" id="txtBOILER_MDO" /></td>
                <td><input type="button" id="btnAdd3" value="Add" /></td>
            </tr>
        </tfoot>
    </table>

    <br />
    <input type="button" id="btnSave" value="Save All" />
    <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
    <script type="text/javascript" src="http://ajax.cdnjs.com/ajax/libs/json2/20110223/json2.js"></script>
    <script type="text/javascript">

        $("body").on("click", "#btnAdd", function () {
            //Reference the Name and Country TextBoxes.
            debugger;
            var VesselID = $("#VesselID");
            var VesselName = $("#VesselID option:selected").text();

            var StartDate = $("#StartDate");
            var EndDate = $("#EndDate");
            var VoyageType = $("#VoyageType");
            //var txtAE_DO = $("#txtAE_DO");

            //Get the reference of the Table's TBODY element.
            var tBody = $("#tblCPVessel > TBODY")[0];

            //Add Row.
            var row = tBody.insertRow(-1);


            //Add VesselID cell.
            var cell = $(row.insertCell(-1));
            cell.html(VesselID.val());

            //Add VesselName cell.
            var cell = $(row.insertCell(-1));
            cell.html(VesselName);

            //Add StartDate cell.
            cell = $(row.insertCell(-1));
            cell.html(StartDate.val());

            //Add EndDate cell.
            cell = $(row.insertCell(-1));
            cell.html(EndDate.val());

            //Add VoyageType cell.
            cell = $(row.insertCell(-1));
            cell.html(VoyageType.val());

            //Add AE_DO cell.
            //cell = $(row.insertCell(-1));
            //cell.html(txtAE_DO.val());

            //Add Button cell.
            cell = $(row.insertCell(-1));
            var btnRemove = $("<input />");
            btnRemove.attr("id", "button1");
            btnRemove.attr("type", "button");
            btnRemove.attr("onclick", "Remove(this);");
            btnRemove.val("Remove");
            cell.append(btnRemove);

            //Clear the TextBoxes.
            VesselID.val("");
            VesselName = "";
            StartDate.val("");
            EndDate.val("");
            VoyageType.val("");
            //txtAE_DO.val("");
        });

        function Remove(button) {
            //Determine the reference of the Row using the Button.
            var row = $(button).closest("TR");
            var name = $("TD", row).eq(0).html();
            if (confirm("Do you want to delete: " + name)) {
                //Get the reference of the Table.
                var table = $("#tblCPVessel")[0];

                //Delete the Table row using it's Index.
                table.deleteRow(row[0].rowIndex);
            }
        };





    </script>

