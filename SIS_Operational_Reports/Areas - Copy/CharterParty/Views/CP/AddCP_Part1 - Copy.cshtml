                <tr>
                    @*<td>@customer.Speed</td>*@
                    @*<td>
                            @Html.DropDownListFor(model => customer.VesselID, new SelectList(customer.VesselList, "Value", "Text"), "None Selected", htmlAttributes: new { @class = "form-control select2", @required = "true", })
