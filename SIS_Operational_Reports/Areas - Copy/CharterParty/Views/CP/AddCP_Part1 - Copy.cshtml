    <script>

        // For Save All
        $("body").on("click", "#btnSave", function () {

            //Loop through the Table rows and build a JSON array.
            var CPVesselInfo = new Array();
            $("#tblCPVessel TBODY TR").each(function () {
                var row = $(this);
                var customer = {};
                //customer.ID = row.find("TD").eq(0).html();
                customer.VesselID = row.find("TD").eq(0).html();
                customer.VesselName = row.find("TD").eq(1).html();
                customer.StartDate = row.find("TD").eq(2).html();
                customer.EndDate = row.find("TD").eq(3).html();
                customer.VoyageType = row.find("TD").eq(4).html();
                //Model.CPVesselInfo.VesselID = customer.VesselID;
                //Model.CPVesselInfo.VesselName = customer.VesselName;
                //Model.CPVesselInfo.StartDate = customer.StartDate;
                //Model.CPVesselInfo.EndDate = customer.EndDate;
                //Model.CPVesselInfo.VoyageType = customer.VoyageType;
                CPVesselInfo.push(customer);
            });

            //Loop through the Table rows and build a JSON array.
            var MainCONSUMPTION = new Array();
            $("#tblMainCONSUMPTION TBODY TR").each(function () {
                var row = $(this);
                var customer2 = {};
                //customer.ID = row.find("TD").eq(0).html();
                customer2.Speed = row.find("TD").eq(0).html();
                customer2.ME_LADEN = row.find("TD").eq(1).html();
                customer2.ME_BALLAST = row.find("TD").eq(2).html();
                customer2.AE_VLSFO = row.find("TD").eq(3).html();
                customer2.AE_DO = row.find("TD").eq(4).html();

                MainCONSUMPTION.push(customer2);
            });


            //Loop through the Table rows and build a JSON array.
            var OtherCONSUMPTION = new Array();
            $("#tblMainCONSUMPTION TBODY TR").each(function () {
                var row = $(this);
                var customer3 = {};
                //customer.ID = row.find("TD").eq(0).html();
                customer3.Consumption = row.find("TD").eq(0).html();
                customer3.AE_VLSFO = row.find("TD").eq(1).html();
                customer3.AE_MDO = row.find("TD").eq(2).html();
                customer3.BOILER_MDO = row.find("TD").eq(3).html();
                OtherCONSUMPTION.push(customer3);
            });

            var CharterParty = '{"CPVesselInfo":["' + CPVesselInfo.join('","') + '"],"MainCONSUMPTION":]"' + MainCONSUMPTION.join('","') + '"],"OtherCONSUMPTION":["' + OtherCONSUMPTION.join('","') + '"]}';

            //var CharterParty = new Array();
            //CharterParty.push(CPVesselInfo);
            //CharterParty.push(MainCONSUMPTION);
            //CharterParty.push(OtherCONSUMPTION);
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/CharterParty/CP/InsertCharterParty",
                data: JSON.stringify(CharterParty),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (r) {
                    alert(r + " record(s) inserted.");
                }
            });
        });
    </script>
</body>
</html>