                <tr>
                    <td>@customer3.Consumption</td>
                    <td>@customer3.AE_VLSFO</td>
                    <td>@customer3.AE_MDO</td>
                    <td>@customer3.BOILER_MDO</td>

                    <td><input id="button3" type="button" value="Remove" onclick="Remove3(this)" /></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                @*<td><input type="text" id="txtConsumption" class="btn btn-info"/></td>*@
                <td>@Html.DropDownListFor(model => model.ConsType, new SelectList(Model.ConsumptionTypeList, "Value", "Text"), "", htmlAttributes: new { @class = "mdb-select  bottom-border-input select2", @required = "true", })</td>
                <td><input type="text" id="txtOAE_VLSFO" onkeyup="requiredValue(this)" onkeypress="return isNumberKey(event)" /></td>
                <td><input type="text" id="txtAE_MDO"  onkeyup="requiredValue(this)" onkeypress="return isNumberKey(event)" /></td>
                <td><input type="text" id="txtBOILER_MDO"  onkeyup="requiredValue(this)" onkeypress="return isNumberKey(event)" /></td>
