@using (Html.BeginForm("edit", "VesselTanks"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
    @Html.HiddenFor(e => e.TanksTypeId)
    <div class="row" style="margin-top: 10px;">

        @{
            var tankstype = "";
            var checktypeid = Model.TanksTypeId;
            if (checktypeid == 1)
            {
                tankstype = "Cargo Tanks";
            }
            if (checktypeid == 2)
            {
                tankstype = "Cargo Holds";
            }
            if (checktypeid == 3)
            {
                tankstype = "Ballast Tanks";
            }
            if (checktypeid == 4)
            {
                tankstype = "Void Spaces";
            }
            if (checktypeid == 5)
            {
                tankstype = "Bunker Tanks";
            }
            if (checktypeid == 6)
            {
                tankstype = "Lube Oil Tanks";
            }
            if (checktypeid == 7)
            {
                tankstype = "Fresh Water Tanks";
            }
            if (checktypeid == 8)
            {
                tankstype = "Other Tanks";
            }
            if (checktypeid == 9)
            {
                tankstype = "Other Spaces";
            }
        }

        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div class="col-md">
                <h2> Edit @tankstype</h2>
            </div>

            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">

                        <button name="Submit" type="submit" class="function-button submit-button"><i class="uil uil-check mr-2"></i>Submit</button>
                    </div>
                    <div class="col">

                        <button name="Reset" type="reset" id="btnReset" class="function-button go-back"><i class="uil uil-redo mr-2"></i>Reset</button>
                    </div>
                    <div class="col">

                        <button name="back" type="button" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>
                        @*<a name="back" id="btnBack" onclick="goBack()" class="function-button go-back"> << Go Back</a>*@
                    </div>
                </div>
            </div>

        </div>

    </div>
    <div class="container">
        <div class="row">
            <div class="col-md">
                <div class="mb-3 row">

                    <label for="inputPassword" class="col-sm-4 col-form-label">@tankstype Name*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, @required = "true", } })
                        <div class="error"></div>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">@tankstype Height in meters*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Height, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 8, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)" } })

                        <span id="messageImo"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">@tankstype Capacity in m3*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Capacity, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 8, @required = "true", @onKeyUp = "requiredValue2(this)", @onkeypress = "return isNumberKey(event)" } })

                        <div class="error"></div>
                    </div>


                </div>
            </div>
        </div>
    </div>

}

<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').addClass('active');
    $('#Menu5').removeClass('active');


</script>


<script type="text/javascript">
    function requiredValue1(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(3);
            }
        }
        if (value > 99.99) {

            $("#" + id + "").val('');
        }

    }
</script>

<script type="text/javascript">
    function requiredValue2(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 3) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(3);
            }
        }
        if (value > 999999.99) {

            $("#" + id + "").val('');
        }

    }
</script>

<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>