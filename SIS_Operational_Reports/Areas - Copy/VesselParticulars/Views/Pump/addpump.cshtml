@using (Html.BeginForm("addpump", "Pump"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)

<div style="display:none">
    @Html.TextBoxFor(m => m.VesselId)
</div>
    <div class="row" style="margin-top: 10px;">

        <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
            <div class="col-md">
                <h2>Add Pump Detail</h2>
            </div>

            @if (TempData["Error"] != null)
            {
                <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
            }
            @if (TempData["Success"] != null)
            {
                <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
            }

            <div class="col-md button-row-top">
                <div class="row">
                    <div class="col">

                        <button name="Submit" type="submit" class="function-button submit-button"><i class="uil uil-check mr-2"></i>Submit</button>
                    </div>
                    <div class="col">

                        <button name="Reset" type="reset" id="btnReset" class="function-button go-back"><i class="uil uil-redo mr-2"></i>Reset</button>
                    </div>
                    <div class="col">

                        <button name="back" type="button" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>
                        @*<a name="back" id="btnBack" onclick="goBack()" class="function-button go-back"> << Go Back</a>*@
                    </div>
                </div>
            </div>

        </div>

    </div>
    <div class="container">
        <div class="row">
            <div class="col-md">
                <div class="mb-3 row">
                    <label for="inputPassword" class="col-sm-4 col-form-label">Pump Category*</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.PumpUseId, new SelectList(Model.PumpUseName, "Id", "Type"), "", htmlAttributes: new { @class = "form-control bottom-border-input", @required = "true", })
                        <div class="error"></div>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Pump Type*</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.PumpTypeId, new SelectList(Model.PumpTypeList, "Id", "Type"), "", htmlAttributes: new { @class = "form-control bottom-border-input", @required = "true", })
                        <div class="error"></div>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Name*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, @min = "0", @max = "9999999", @required = "true", @onKeyUp = "requiredValue(this)" } })
                        <span id="messageImo"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Capacity(m3)*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Capacity, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 5, @min = "0", @max = "99999", @onkeypress = "return isNumberKey(event)", @required = "true", @onKeyUp = "requiredValue(this)" } })
                        <span id="messageCap"></span>
                    </div>


                </div>
            </div>
        </div>
    </div>

}


<script>
    document.getElementsByName('VesselId')[0].value = '@ViewBag.ImoNo';

</script>
<script>
    function goBack() {
        window.history.back();
    }
</script>

<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>

<script type="text/javascript">
    function requiredValue(arg) {


        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        if (value > 99999) {

            var message = "";
            if (id == "Capacity") {
                message = document.getElementById('messageCap');
            }

            var goodColor = "#0C6";
            var badColor = "#FF0000";

            message.style.color = badColor;
            message.innerHTML = "Value cannot be greater than 5 digits !"
            $("#" + id + "").val('');
        }
        else {
            var message = "";
            if (id == "Capacity") {
                message = document.getElementById('messageCap');
            }

            message.innerHTML = ""
        }




    }
</script>
<script>
    $('#Capacity').keypress(function (e) {
        if (e.which === 32)
            return false;
    });

</script>

<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>
    $('#btnReset').click(function () {
        $("#PumpTypeId").val(null).trigger("change");

    });
</script>


<script>

    $('#Menu1').removeClass('active');
    $('#Menu2').removeClass('active');
    $('#Menu3').removeClass('active');
    $('#Menu4').removeClass('active');
    $('#Menu5').addClass('active');


</script>
