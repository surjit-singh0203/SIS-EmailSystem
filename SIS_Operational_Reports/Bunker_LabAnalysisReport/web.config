<?xml version="1.0" encoding="UTF-8"?>
<!--
    Forces every static file served from this folder to be downloaded as an
    attachment instead of opened inline in the browser. Required so the
    "Attached Document" link in the Bunker Report email (which points at
    /Bunker_LabAnalysisReport/<FileName>) triggers a download in all browsers
    and webmail clients (including Gmail, which strips the HTML5 `download`
    attribute on <a> tags).
-->
<configuration>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <add name="Content-Disposition" value="attachment" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
