<script type="text/javascript">
    function requiredValue1(arg) {


        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById('Displacement').value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 1) {
                document.getElementById('Displacement').value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }


        if (value > 600000) {
        //if (value > 999999) {
            var message = "";
            if (id == "Displacement") {
                message = document.getElementById('messageDis');
            }

            var goodColor = "#0C6";
            var badColor = "#FF0000";

            message.style.color = badColor;
            message.innerHTML = "Value can not greater than 600000 digits !"
            $("#" + id + "").val('');
        }
        else {
            var message = "";
            if (id == "Displacement") {
                message = document.getElementById('messageDis');
            }

            message.innerHTML = ""
        }



    }
</script>


<script>
    $('#ImoNo').keypress(function (e) {
        if (e.which === 32)
            return false;
    });

    $('#Displacement').keypress(function (e) {

        if (e.which === 32) {
            return false;
        }

    });
</script>

<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>

<script>
    $('#btnReset').click(function () {
        $("#FleetTypeID").val(null).trigger("change");
        $("#FleetNameID").val(null).trigger("change");
        $("#VesselTradeID").val(null).trigger("change");

    });
</script>

