@using (Html.BeginForm("addvessel", "VesselPart"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(e => e.Id)
<div class="row" style="margin-top: 10px;">


    @if (TempData["Error"] != null)
    {
        <p class="alert alert-danger" id="errorMessage">@TempData["Error"]</p>
    }
    @if (TempData["Success"] != null)
    {
        <p class="alert alert-success" id="successMessage">@TempData["Success"]</p>
    }


    <div class="row" style="border-bottom: solid 1px #676969; margin-bottom: 20px;">
        <div class="col-md">
            <h2>Vessel Detail</h2>
        </div>


        <div class="col-md button-row-top">
            <div class="row">
                <div class="col">

                    <button name="Submit" type="submit" class="function-button submit-button"><i class="uil uil-check mr-2"></i>Submit</button>
                </div>
                <div class="col">

                    <button name="Reset" type="reset" id="btnReset" class="function-button go-back"><i class="uil uil-redo mr-2"></i>Reset</button>
                </div>
                <div class="col">

                    <button name="back" type="button" onclick="goBack()" id="btnBack" class="function-button go-back"><i class="uil uil-redo mr-2"></i><< Go Back</button>
                    @*<a name="back" id="btnBack" onclick="goBack()" class="function-button go-back"> << Go Back</a>*@
                </div>
            </div>
        </div>

    </div>

</div>
    <div class="container">
        <div class="row">
            <div class="col-md">
                <div class="mb-3 row">

                    <label for="inputPassword" class="col-sm-4 col-form-label">Vessel Name*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.VesselName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, @required = "true", } })
                        <div class="error"></div>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">IMO No*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.ImoNo, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @min = "0", @max = "9999999", @onkeypress = "return isNumberKey(event)", @required = "true", @onKeyUp = "requiredValue(this)" } })
                        <span id="messageImo"></span>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Fleet Type*</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.FleetTypeID, new SelectList(Model.FleetTypeList, "Tid", "FleetType"), "", htmlAttributes: new { @class = "form-control bottom-border-input", @required = "true", })
                        <div class="error"></div>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Fleet Name*</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.FleetNameID, new SelectList(Model.FleetNameList, "Fid", "FleetName"), "", htmlAttributes: new { @class = "form-control bottom-border-input", @required = "true", })
                        <div class="error"></div>
                    </div>

                    <label for="inputPassword" class="col-sm-4 col-form-label">Vessel Trade*</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.VesselTradeID, new SelectList(Model.VesselTradeList, "Id", "VesselTrade"), "", htmlAttributes: new { @class = "form-control bottom-border-input", @required = "true", })
                        <div class="error"></div>
                    </div>


                    <label for="inputPassword" class="col-sm-4 col-form-label">Displacement*</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Displacement, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue1(this)", @onkeypress = "return isNumberKey(event)", @type = "number", @step = "any" } })
                        <span id="messageDis"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>
<script>
    function goBack() {
        window.history.back();
    }
</script>
<script type="text/javascript">

    setTimeout(function () {

        $('#successMessage').fadeOut('fast');
        $('#errorMessage').fadeOut('fast');
    }, 3000);


</script>
