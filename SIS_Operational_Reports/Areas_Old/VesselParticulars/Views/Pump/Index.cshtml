<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.24/jquery-ui.min.js"></script>
<script type="text/javascript">
    $(function () {

        $("#tblpump").sortable({
            // items: 'tr',
            // items: 'tr:not(tr:first-child)',
            cursor: 'pointer',
            axis: 'y',
            dropOnEmpty: false,
            start: function (e, ui) {
                ui.item.addClass("selected");
            },
            stop: function (e, ui) {
                ui.item.removeClass("selected");
                $(this).find("tr").each(function (index) {
                    if (index > 0) {
                        debugger;
                        $(this).find("td").eq(0).html(index);
                        //$(this).find("td").val(index + 1);

                    }
                });
            }
        });
    });
</script>
<script>



        function SaveData() {


            var pumplist = []; // list object
            //$('#tbl1 > tbody  > tr').each(function () { //loop in table list

            $('#tblpump tr').each(function () {
                debugger;
                var pumps = {};
                var pumtType = $(this).find("td").eq(3).html();
                var name = $(this).find("td").eq(4).html();
                var capacity = $(this).find("td").eq(5).html();



                pumps.PumpType = pumtType;
                pumps.Name = name;
                pumps.Capacity = capacity;
                pumplist.push(pumps);
            });


            debugger;
            pumplist = JSON.stringify(pumplist);



            $.ajax({
                url: '@Url.Action("InsertInOrder", "Pump")',
                type: "POST",
                data: { 'pumplist': pumplist },
                dataType: "json",
                beforeSend: function (x) {
                    if (x && x.overrideMimeType) {
                        x.overrideMimeType("application/j-son;charset=UTF-8");
                    }
                },
                success: function (result) {
                    debugger;
                    window.location.href = result;
                }
            });



        }

</script>


