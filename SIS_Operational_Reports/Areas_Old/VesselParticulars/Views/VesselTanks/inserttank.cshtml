<div class="container">
    <table id="tbltanksAndholds" class="GeneratedTable" cellpadding="0" cellspacing="0">
        <thead>
            <tr>

                <th id="thName">Name</th>
                <th id="thHeight">Height</th>
                <th id="thCapacity">Capacity</th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (TanksAndHolds tanks in Model)
            {
                <tr>
                    <td>@tanks.Name</td>
                    <td>@tanks.Height</td>
                    <td>@tanks.Capacity</td>
                    <td><input class="btn btn-info" type="button" value="Remove" onclick="Remove(this)" /></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td><input type="text" class="form-control bottom-border-input" maxlength="50" width="250" id="txtName" /></td>
                <td><input type="text" class="form-control bottom-border-input" onKeyUp="requiredValue1(this)" onkeypress="return isNumberKey(event)" maxlength="8" width="250" id="txtHeight" /></td>
                <td><input type="text" class="form-control bottom-border-input" onKeyUp="requiredValue2(this)" onkeypress="return isNumberKey(event)" maxlength="9" width="250" id="txtCapacity" /></td>
                <td><input class="btn btn-info" type="button" id="btnAdd" value="Add" /></td>


            </tr>
        </tfoot>
    </table>
</div>
<br />
