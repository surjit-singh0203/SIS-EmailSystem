<script type="text/javascript">
    $("body").on("click", "#btnAdd", function () {
        //Reference the Name and Country TextBoxes.
        var txtName = $("#txtName");
        var txtHeight = $("#txtHeight");
        var txtCapacity = $("#txtCapacity");

        //alert(txtName.val());

        if (txtName.val() == "") {
            alert("Name can not be blank !");
            return;
        }
        if (txtHeight.val() == "") {
            alert("Height can not be blank !");
            return;
        }
        if (txtCapacity.val() == "") {
            alert("Capacity can not be blank !");
            return;
        }

        //Get the reference of the Table's TBODY element.
        var tBody = $("#tbltanksAndholds > TBODY")[0];

        //Add Row.
        var row = tBody.insertRow(-1);

        //Add Name cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtName.val());

        //Add Height cell.
        cell = $(row.insertCell(-1));
        cell.html(txtHeight.val());

        //Add Capacity cell.
        cell = $(row.insertCell(-1));
        cell.html(txtCapacity.val());

        //Add Button cell.
        cell = $(row.insertCell(-1));
        var btnRemove = $("<input />");
        btnRemove.attr("type", "button");
        btnRemove.attr("class", "btn btn-danger btn-width");
        btnRemove.attr("onclick", "Remove(this);");
        btnRemove.val("Remove");
        cell.append(btnRemove);

        //Clear the TextBoxes.
        txtName.val("");
        txtHeight.val("");
        txtCapacity.val("");
    });

