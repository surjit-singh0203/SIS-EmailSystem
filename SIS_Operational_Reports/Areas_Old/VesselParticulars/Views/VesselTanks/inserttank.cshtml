

@using DataBuildingLayer;
@model List<DataBuildingLayer.TanksAndHolds>

@{
    ViewBag.Title = "inserttank";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row" style="margin-top: 5px; border-bottom: solid 1px #676969; margin-bottom: 10px;">

    <div class="inline-content">
        <div class="col">

            @{
                var tankstype = "";
                var checktypeid = Request.QueryString["typeid"];
                if (checktypeid == "1")
                {
                    tankstype = " Cargo Tanks";
                }
                if (checktypeid == "2")
                {
                    tankstype = " Cargo Holds";
                }
                if (checktypeid == "3")
                {
                    tankstype = "Ballast Tanks";
                }
                if (checktypeid == "4")
                {
                    tankstype = "Void Spaces";
                }
                if (checktypeid == "5")
                {
                    tankstype = "Bunker Tanks";
                }
                if (checktypeid == "6")
                {
                    checktypeid = "Lube Oil Tanks";
                }
                if (checktypeid == "7")
                {
                    tankstype = " Fresh Water Tanks";
                }
                if (checktypeid == "8")
                {
                    tankstype = "Other Tanks";
                }
                if (checktypeid == "9")
                {
                    tankstype = "Other Spaces";
                }

            }
            <h2>@tankstype</h2>
        </div>
        <div>
            <input class="btn btn-success btn-width" type="button" id="btnSave" value="Save All" />
            <a name="back" id="btnBack" onclick="goBack()" class="btn btn-primary btn-width m-1"> &lt;&lt; Go Back</a>
        </div>
    </div>






</div>

</div>

