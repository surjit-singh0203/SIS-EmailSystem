<script type="text/javascript">
    function requiredValue1(arg) {
        debugger;
        var id = arg.getAttribute('id');
        var value = arg.value;

        var dec = document.getElementById(id).value;
        if (dec.includes(".")) {
            var res = dec.substring(dec.indexOf(".") + 1);
            var kl = res.split("");
            if (kl.length > 1) {
                document.getElementById(id).value = (parseInt(dec * 100) /
                    100).toFixed(2);
            }
        }
        if (value > 999.99) {

            $("#" + id + "").val('');
        }

    }
</script>

<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>

