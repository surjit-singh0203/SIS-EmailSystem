<script type="text/javascript">
    $("body").on("click", "#btnAdd", function () {
        //Reference the Name and Country TextBoxes.
        var txtName = $("#NREventsId");
        var txtHeight = $("#OwChaterer");
        var txtCapacity = $("#txtHrs");

        //Get the reference of the Table's TBODY element.
        var tBody = $("#tblnonroutineevents > TBODY")[0];

        //Add Row.
        var row = tBody.insertRow(-1);

        //Add Name cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtName.val());

        //Add Height cell.
        cell = $(row.insertCell(-1));
        cell.html(txtHeight.val());

        //Add Capacity cell.
        cell = $(row.insertCell(-1));
        cell.html(txtCapacity.val());

        //Add Button cell.
        cell = $(row.insertCell(-1));
        var btnRemove = $("<input />");
        btnRemove.attr("type", "button");
        btnRemove.attr("class", "btn btn-danger btn-width");
        btnRemove.attr("onclick", "Remove(this);");
        btnRemove.val("Remove");
        cell.append(btnRemove);

        //Clear the TextBoxes.
        txtName.val("");
        txtHeight.val("");
        txtCapacity.val("");
    });

    function Remove(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        if (confirm("Do you want to delete: " + name)) {
            //Get the reference of the Table.
            var table = $("#tblnonroutineevents")[0];

            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        }
    };

    $("body").on("click", "#btnSave", function () {
        //Loop through the Table rows and build a JSON array.

        //var url = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
        //var urlparam = url[0].split('=');
        var result = getUrlVars()["typeid"];

        var tankAndholds = new Array();
        $("#tblnonroutineevents TBODY TR").each(function () {
            var row = $(this);
            var tankH = {};
            tankH.Name = row.find("TD").eq(0).html();
            tankH.Height = row.find("TD").eq(1).html();
            tankH.Capacity = row.find("TD").eq(2).html();
            tankH.TanksTypeId = result;
            tankAndholds.push(tankH);
        });
        var origin = window.location.origin;
        // alert(origin);
        //Send the JSON array to Controller using AJAX.
        $.ajax({
            type: "POST",

            url: "/VesselParticulars/VesselTanks/inserttankandholds",
            data: JSON.stringify(tankAndholds),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (r) {
                //alert(r + " record(s) inserted.");

                window.location = origin + "/VesselParticulars/VesselTanks/viewtanks?typeid=" + r + "";
            }

            //success: function (json) {

            //    if (json.isRedirect) {
            //        window.location.href = json.redirectUrl;
            //    }
            //},
        });
    });
</script>

