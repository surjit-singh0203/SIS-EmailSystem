<script>
    function GetLeg() {
        // alert('hi');
        var Voyid = $("#VoyageId option:selected").val();


        $.ajax({
            type: 'GET',
            url: '/Report/DailyNoon/BindLeg?Voyid=' + Voyid,
            cache: false,
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Result === true) {
                    $('#LegPortId').empty();

                    debugger;
                    $('#LegPortId').append('<option value="">None Selected</option>');
                    for (var i = 0; i < response.Data.length; i++) {
                        $('#LegPortId').append('<option value="' + response.Data[i] + '">' + response.Data[i] + '</option>');

                    }






                    //$('#FacilityName').append('<option value="">Other</option>');

                }
                else {
                    toastr["error"](response.Message);
                }
            },
            failure: function (response) {
                toastr["error"](response.Message);
            }
        });
    };
</script>


