
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

<div class="row" style="margin-top: 10px;">


    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
            <div class="col-sm-8">
                <select class="form-control bottom-border-input" id="dropdown-selection">
                    <option value="volvo">Select1</option>
                    <option value="saab">Select2</option>
                    <option value="fiat">Select3</option>
                    <option value="audi">Select4</option>
                </select>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">ETD Date & Time</label>
            <div class="col-sm-8">
                <input type="datetime-local" class="form-control bottom-border-input" placeholder="Select">
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Port</label>
            <div class="col-sm-8">
                <select class="form-control bottom-border-input" id="dropdown-selection">
                    <option value="volvo">Select1</option>
                    <option value="saab">Select2</option>
                    <option value="fiat">Select3</option>
                    <option value="audi">Select4</option>
                </select>
            </div>



        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Report Date & Time</label>
            <div class="col-sm-8">
                <input type="datetime-local" class="form-control bottom-border-input" placeholder="Select">
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Fwd</label>
            <div class="col-sm-8">
                <input type="text" class="form-control bottom-border-input" placeholder="Select">
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Mid</label>
            <div class="col-sm-8">
                <input type="text" class="form-control bottom-border-input" placeholder="Select">
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Aft</label>
            <div class="col-sm-8">
                <input type="text" class="form-control bottom-border-input" placeholder="Select">
            </div>

        </div>

        <div class="col-md">

            <div class="row">
                <div class="col">
                    <button class="function-button submit-button">
                        Submit
                    </button>
                </div>
                <div class="col">
                    <button class="function-button draft-button">
                        Save Draft
                    </button>
                </div>
                <div class="col">
                    <button class="function-button reset-button">
                        Reset
                    </button>
                </div>
            </div>


        </div>

    </div>

</div>
      
