@model DataBuildingLayer.BerthingReport
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row" style="margin-top: 10px;">


    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Voy No.</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.VoyageId, new SelectList(Model.VoyageNumberList, "Id", "VoyageNumber"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @onchange = "GetLeg(this);Getfuelcons6(this)", @required = "true", })
                <span id="messageVoyid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Port</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.PortName, new SelectList(Model.PortList, "PortName", "PortName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @onchange = "GetFacName(this)", @required = "true", })
                <span id="msgFacilityName" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Berth Name</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.BerthName, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 50, @required = "true", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgBerthName" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">




            <label for="inputPassword" class="col-sm-4 col-form-label">Leg</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.LegPortId, new SelectList(Model.LegPortList, "Id", "Leg"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", @onchange = "GetBRCargo(); GetDisByLeg1(this)", })
                <span id="msgLegPortId" style="color:red"></span>
            </div>




            <label for="inputPassword" class="col-sm-4 col-form-label">Facility Name</label>
            <div class="col-sm-8">

                @Html.DropDownListFor(model => model.FacilityName, new SelectList(Model.FacilityList, "FacilityName", "FacilityName"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", @onchange = "GetDisByLeg1(this)", })
                <span id="msgFacilityName" style="color:red"></span>

            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Report Date</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.ReportDate, "{0:yyyy-MM-dd}", new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 20, @required = "true", @readonly = true, @placeholder = "yyyy-mm-dd" } })
                <span id="msgReportDate" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">In Port Status</label>
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.PortStatus, new SelectList(Model.PortStatusList, "Id", "Status"), "", htmlAttributes: new { @class = "mdb-select md-form form-control bottom-border-input", @required = "true", })
                <span id="msgPortStatus" style="color:red"></span>
            </div>

        </div>
    </div>

    <div class="col-md">

        <div class="mb-3 row">

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Fwd</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftFwd, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftFwd" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Mid</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftMid, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftMid" style="color:red"></span>
            </div>

            <label for="inputPassword" class="col-sm-4 col-form-label">Draft Aft</label>
            <div class="col-sm-8">
                @Html.EditorFor(model => model.DraftAft, new { htmlAttributes = new { @autocomplete = "off", @class = "form-control bottom-border-input", @maxlength = 6, @required = "true", @onKeyUp = "requiredValue3(this)", @onkeypress = "return isNumberKey(event)", @onBlur = "CheckValidation(this)", @step = "any" } })
                <span id="msgDraftAft" style="color:red"></span>
            </div>

        </div>

        <div class="col-md">

            <div class="row">
                <div class="col">
                    <button id="btnPrint" class="function-button submit-button" onclick="window.print()">
                        Print
                    </button>

                </div>
                @*<div id="SDraft" class="col">
                <button onclick="SaveDraftFunction()" class="function-button draft-button">
                    Save Draft
                </button>
                <div hidden="hidden">
                    @Html.CheckBoxFor(model => model.SaveDraft)
                </div>

            </div>

            <div class="col">
                <button class="function-button reset-button">
                    Reset
                </button>
            </div>*@
            </div>


        </div>

    </div>

</div>

