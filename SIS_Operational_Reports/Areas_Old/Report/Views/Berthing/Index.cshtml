<script>


    function SaveBerthingReport() {


        var _berthing = {};

        _berthing.Id = $('#Id').val();
        var voy = document.getElementById("VoyageId");
        var voyid = voy.options[voy.selectedIndex].value;



        var leg = document.getElementById("LegPortId");
        var legportid = leg.options[leg.selectedIndex].value;

        var port = document.getElementById("PortName");
        var portname = port.options[port.selectedIndex].text;

        var fac = document.getElementById("FacilityName");
        var facname = fac.options[fac.selectedIndex].text;

        debugger;

        _berthing.VoyageId = voyid;
        if (_berthing.VoyageId == "") {
            $("#messageVoyid").text("Please Choose Voyage Number.");
            return;
        }
        else {
            $("#messageVoyid").text('');
        }

        _berthing.LegPortId = legportid;
        if (_berthing.LegPortId == "") {
            $("#msgLegPortId").text("Please Choose Leg.");
            return;
        }
        else {
            $("#msgLegPortId").text('');
        }

        _berthing.PortName = portname;
        if (_berthing.PortName == "") {
            $("#msgPortName").text("Please Choose Port.");
            return;
        }
        else {
            $("#msgPortName").text('');
        }

        _berthing.FacilityName = facname;
        if (_berthing.FacilityName == "") {
            $("#msgFacilityName").text("Please Choose Facility.");
            return;
        }
        else {
            $("#msgFacilityName").text('');
        }

        _berthing.BerthName = $("#BerthName").val();
        if (_berthing.BerthName == "") {
            $("#msgBerthName").text("Please Choose Port.");
            return;
        }
        else {
            $("#msgBerthName").text('');
        }



